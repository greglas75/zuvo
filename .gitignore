node_modules/
.DS_Store
*.log
dist/
.aider*

# local agent/editor state — never committed. Without this, dev-push.sh step 2
# (`git add -A`) would sweep ~/.claude local settings into a pushed release.
.claude/
__pycache__/
*.pyc

# zuvo session state (local runtime, not committed)
.zuvo/

# zuvo review coverage — LOCAL PROOF-OF-WORK, deliberately not committed.
# The pre-push gate reads a PAIR: the memory/reviews/*.md artifact and the zuvo/proofs/* file its
# `adversarial:` header names (that is why `zuvo/` below is ignored too). They stay local because
# they are evidence that a review ran ON THIS MACHINE — committing them would make fabricating
# coverage a text edit anyone could push. The cost is that neither travels with a branch, a
# worktree, or a merge: work reviewed in one checkout reads as "never reviewed" in another.
# That is expected, not a bug — move the pair instead of re-reviewing:
#   scripts/review-artifact-sync.sh --from <checkout-that-reviewed> --to . [--slug <substr>]
#   scripts/review-artifact-sync.sh --check .
# CI does not have the proof file at all and degrades to the content-key alone (PG_PROOF_OPTIONAL=1).
memory/reviews/

# zuvo:leads output (per-user lead lists; not committed)
docs/leads/

# Auto-managed local review queue
tests/adversarial/.tmp/
# generated by codesift wiki/index — machine-specific, never commit
.codesift/
# zuvo/ = project-local run output (audits, reports, plans, and zuvo/proofs/ — the second half of
# the review-coverage pair described above). Local by the same reasoning; see memory/reviews/.
zuvo/

# zuvo:infra-audit Docker fixtures — never commit private key material or
# the runtime-staged authorized_keys (ensure-fixtures.sh regenerates them).
tests/infra-suite/fixtures/.keys/
tests/infra-suite/fixtures/sshd-*/authorized_keys
