#!/bin/sh
# Polyglot sh/python header. `#!/usr/bin/env python3` fails on Windows: python.org installs
# `python` and `py`, Git Bash ships neither, and the shebang dies with
#     env: python3: No such file or directory
# (reproduced). /bin/sh executes the next line, which re-execs this file with whatever Python 3
# the machine actually has; Python parses that same line as a string literal and ignores it.
# Keep it on ONE line and do not "tidy" the quoting — both interpreters depend on it exactly.
''''exec "$(command -v python3 || command -v python || echo python3)" "$0" "$@" # '''
USAGE = """zuvo backlog — ONE place for every backlog in the fleet (Mac + VPS + bots).

    ~/.zuvo/backlog sync              collect this host, push, pull merged fleet index
    ~/.zuvo/backlog pull              pull merged fleet index only (no local scan)
    ~/.zuvo/backlog ls                per-repo summary (open/done/oldest), all hosts
    ~/.zuvo/backlog open [--repo R]   open items, newest first
    ~/.zuvo/backlog crit              critical+high items across the whole fleet
    ~/.zuvo/backlog grep <text>       full-text search across every backlog
    ~/.zuvo/backlog strays            worktree-fork copies that should not exist

Write surface stays per-repo `memory/backlog.md` (git-tracked, reviewable, offline).
This is the READ model: a merged index at ~/.zuvo/backlog-index.jsonl, rebuilt from
the collector so the Mac sees VPS/bot debt without SSH-ing to each box.

Merge rule: per host, only the LATEST run_id counts (a re-run replaces, never
duplicates). Requires SSH to the collector host for `pull`.
"""
import os
import sys
import codecs
import gzip
import json
import zlib
import subprocess
import collections

HOME = os.path.expanduser("~")
ZUVO = os.environ.get("ZUVO_DIR", os.path.join(HOME, ".zuvo"))
INDEX = os.path.join(ZUVO, "backlog-index.jsonl")
META = os.path.join(ZUVO, "backlog-index.meta.json")
def _collector_host():
    """SSH target for the shared collector. Env, else ~/.zuvo/collector.conf, else none.
    No hardcoded default on purpose — a wrong one would push this machine's backlog to
    somebody else's host. "" means none is configured: collector_ssh, the one reader of the
    collector, refuses to run without one and exits by name — `sync` and `pull` cannot work
    without the collector, so that is an error for them, not a silent no-op."""
    v = os.environ.get("ZUVO_COLLECTOR_SSH", "").strip()
    if v:
        return v
    conf = os.path.join(os.environ.get("ZUVO_HOME") or os.path.expanduser("~/.zuvo"), "collector.conf")
    try:
        for line in open(conf, encoding="utf-8", errors="replace"):
            line = line.strip()
            if line.startswith("ZUVO_COLLECTOR_SSH"):
                return line.split("=", 1)[1].strip().strip('"\'')
    except OSError:
        pass
    return ""


VPS = _collector_host()
# /opt, not /home/gha: the collector moved hosts AND directories on 2026-09-07.
# runlog-sync.sh was updated then, this script was not — so `sync` reported
# "collector: skipped (no collector token)" and the merged index stayed at
# "0 items from 0 host(s)" for three weeks, both of which look like an idle fleet.
# ONE root: the data dir and collector.env were two literals, and a move updates one and not the other.
COLLECTOR_ROOT = "/opt/telemetry-collector"
DATA = f"{COLLECTOR_ROOT}/data/backlog"
COLLECTOR_ENV = f"{COLLECTOR_ROOT}/collector.env"
# The remote check's exit status for "this user may not read the data dir" — a status, not a stdout
# sentinel, so no record content, sshd banner or rc-file echo can be mistaken for it.
UNREADABLE_RC = 4


# A fleet-supplied body: every host that can reach the collector authored part of it, and it is
# expanded on every reader. `gzip.decompress` would materialise the whole thing and `.decode()` a
# second full-size copy beside it, so a file that grew — or one deliberate deflate bomb — turns a
# wire saving into a killed `sync` with no refusal. Streamed and capped instead; the ceiling is an
# order of magnitude above the measured 35.2 MB namespace, so it only fires on something new.
def _pull_max_bytes():
    # Guarded: an unparseable override must not kill the script at import, where the traceback
    # names neither the variable nor the file the operator typed it in.
    default = 512 * 1024 * 1024
    raw = os.environ.get("ZUVO_PULL_MAX_BYTES", "").strip()
    if not raw:                      # unset is the normal case, not something to comment on
        return default
    try:
        value = int(raw)
    except ValueError:
        print(f"backlog: ignoring ZUVO_PULL_MAX_BYTES={raw!r} — not an integer", file=sys.stderr)
        return default
    return value if value > 0 else default


PULL_MAX_BYTES = _pull_max_bytes()


def _decompress_bounded(blob):
    """Decompressed text, or raise rather than allocate without limit.

    Decodes STRICTLY: `errors="replace"` would turn a host's non-UTF-8 tool output into U+FFFD and
    feed it to the dedup fingerprint, so two boxes that once produced the same fingerprint would
    stop doing so and the duplicate items would survive forever. Corruption is a transport fault.
    """
    # Decoded incrementally: a chunk boundary can fall inside a multi-byte character, and holding
    # the whole decompressed bytes AND a second full-size str was the copy this was meant to avoid.
    decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
    parts, total = [], 0
    dec = zlib.decompressobj(zlib.MAX_WBITS | 16)   # 16 = gzip; members follow via unused_data
    view = memoryview(blob)
    while True:
        chunk = dec.decompress(view, 1 << 20)
        total += len(chunk)
        if total > PULL_MAX_BYTES:
            raise EOFError(f"decompressed payload exceeds {PULL_MAX_BYTES} bytes")
        if chunk:
            parts.append(decoder.decode(chunk))
        if dec.eof:
            rest = dec.unused_data
            if not rest:
                break
            dec = zlib.decompressobj(zlib.MAX_WBITS | 16)
            view = memoryview(rest)
            continue
        if not chunk and not dec.unconsumed_tail:
            # Input exhausted with the member still open: the stream is TRUNCATED. Returning the
            # partial text here is the whole bug this function was added to prevent — a short read
            # that looks like a complete one, and an index rebuilt from a subset of hosts.
            raise zlib.error("gzip stream ended before the final member was complete")
        view = memoryview(dec.unconsumed_tail)
    parts.append(decoder.decode(b"", final=True))   # raises on a trailing partial character
    return "".join(parts)


def collector_ssh(remote_cmd, timeout, what, soft_rc=None, binary=False):
    """stdout of `remote_cmd` run on the collector — or exit, named, when it did not run.

    Every read of the collector goes through here. Its callers act on the output: an empty answer
    from a FAILED connection read as "the fleet has no backlog" (pull rewrote the index to zero items)
    or as "no token" (sync pushed without a credential). A non-zero status (ssh's own failure is 255)
    or a timeout is a failure, never an empty answer. `soft_rc`: the one status the caller handles itself;
    it answers None instead of exiting. `binary`: return bytes, for a payload the collector gzipped."""
    if not VPS:
        sys.exit(f"backlog: no collector host configured (ZUVO_COLLECTOR_SSH or ~/.zuvo/collector.conf) "
                 f"— cannot {what}")
    try:
        r = subprocess.run(["ssh", "-o", "ConnectTimeout=10", VPS, remote_cmd],
                           capture_output=True, text=not binary, timeout=timeout)
    except subprocess.TimeoutExpired:
        sys.exit(f"backlog: the collector {VPS} did not answer within {timeout}s — cannot {what}; "
                 f"nothing was changed")
    except OSError as e:
        sys.exit(f"backlog: could not run ssh to the collector {VPS} ({e}) — cannot {what}; "
                 f"nothing was changed")
    if soft_rc is not None and r.returncode == soft_rc:
        return None
    if r.returncode != 0:
        _stderr = r.stderr.decode("utf-8", "replace") if binary else r.stderr
        err = (_stderr.strip().splitlines() or ["no stderr"])[-1]
        sys.exit(f"backlog: ssh to the collector {VPS}, or the command it ran there, failed "
                 f"(exit {r.returncode}: {err}) — cannot {what}; "
                 f"nothing was changed")
    return r.stdout


def pull(unreadable_ok=False):
    """Read every backlog record off the collector, keep the newest run per host.

    unreadable_ok: the caller is `sync` on a host whose collector user may not read the data dir (the farm
    user cannot — it is gha:gha 750). Its push has already landed and the index is relayed from a host
    that can read it, so that case answers None instead of failing the whole sync. Everything else fails."""
    # An empty data dir is an empty answer. A MISSING one is not: an installed collector has it, and the
    # one way it goes missing is a wrong path — exactly how the sync read "0 items from 0 host(s)" for
    # three weeks. A data dir it cannot list, or a file it cannot read, exits non-zero with the reason on
    # stderr, and collector_ssh refuses it. (`cat … 2>/dev/null || true` made both look like "the fleet
    # has no backlog", and pull rewrote the index from a partial or empty read.)
    #
    # Unreadable is told apart from missing BEFORE anything is believed: `[ -e ]` is also false for a dir
    # that exists behind an ancestor this user cannot search — the farm user's exact view of a 750 tree.
    # So when the dir is not visible, find the nearest ancestor that is: one this user cannot search means
    # "cannot tell, cannot read" (unreadable); a searchable one means the dir really is not there (missing).
    # A path that exists but is not a directory is an error in every mode, never the soft case.
    on_unreadable = f"echo \"backlog data dir $d is not readable by this user\" >&2; exit {UNREADABLE_RC}"
    raw = collector_ssh(
        f"d={DATA}; "
        f"[ -L \"$d\" ] && [ ! -e \"$d\" ] && "
        f"{{ echo \"backlog data dir $d is a broken symlink\" >&2; exit 3; }}; "
        f"if [ ! -e \"$d\" ]; then a=\"${{d%/*}}\"; "
        f"while [ -n \"$a\" ] && [ ! -e \"$a\" ]; do a=\"${{a%/*}}\"; done; "
        f"if [ -n \"$a\" ] && [ ! -d \"$a\" ]; then "
        f"echo \"backlog data dir $d: $a is not a directory\" >&2; exit 3; fi; "
        f"if [ -n \"$a\" ] && [ ! -x \"$a\" ]; then {on_unreadable}; fi; "
        f"echo \"backlog data dir $d does not exist on the collector (moved?)\" >&2; exit 3; fi; "
        f"[ -d \"$d\" ] || {{ echo \"backlog data dir $d exists but is not a directory\" >&2; exit 3; }}; "
        f"[ -r \"$d\" ] && [ -x \"$d\" ] || {{ {on_unreadable}; }}; "
        # gzip ON the collector. This reads the WHOLE namespace, which carries every host's full
        # item list, so the wire cost grows with the fleet while the content barely changes.
        # Measured 2026-10-02 at 35.2 MB: the plain read did not finish inside the 120 s budget on a
        # loaded collector, so every `sync` ended in "did not answer within 120s" and the fleet index
        # was never refreshed — and an abandoned pull reads exactly like a fleet with nothing to say.
        # Gzipped: 9.6 MB, identical bytes after decompression, whole sync 47 s.
        #
        # gzip reads the files ITSELF — never `cat … | gzip`. In a pipeline the status is gzip's, so
        # a cat that aborts mid-stream (one unreadable file uploaded by another host, or a file
        # rotated away by backlog-archive between glob and read) exits 0 carrying a perfectly valid
        # TRUNCATED stream: the pull then rebuilds the index from a subset of hosts and still says
        # "nothing was changed". That is the partial-answer failure this function's docstring calls
        # fatal, and the pipeline form reintroduced it while closing the timeout hole.
        f"set -- \"$d\"/*.jsonl; [ -e \"$1\" ] || [ -L \"$1\" ] || exit 0; gzip -1 -c -- \"$@\"",
        120, "pull the fleet index", soft_rc=UNREADABLE_RC if unreadable_ok else None, binary=True)
    if raw is None:
        return None
    try:
        raw = _decompress_bounded(raw) if raw else ""
    except (OSError, EOFError, zlib.error, UnicodeDecodeError) as e:
        # A truncated stream is a transport fault, not an empty fleet: refuse rather than rewrite
        # the index from a partial read, which is the failure this function's docstring warns about.
        sys.exit(f"backlog: the payload from the collector {VPS} could not be decompressed ({e}) "
                 f"— cannot pull the fleet index; nothing was changed")
    newest = {}          # host -> (received_at, run_id)
    batches = collections.defaultdict(list)   # (host, run_id) -> items
    strays = {}
    for line in raw.splitlines():
        try:
            rec = json.loads(line)
        except Exception:
            continue
        p = rec.get("payload") or {}
        host, run = p.get("host"), p.get("run_id", "")
        if not host:
            continue
        ts = rec.get("received_at", 0)
        batches[(host, run)].extend(p.get("items") or [])
        if p.get("stray_worktree_copies"):
            strays[(host, run)] = p["stray_worktree_copies"]
        if host not in newest or ts > newest[host][0]:
            newest[host] = (ts, run)
    items, stray_out = [], []
    for host, (_ts, run) in newest.items():
        items.extend(batches.get((host, run), []))
        for s in strays.get((host, run), []):
            stray_out.append({"host": host, "path": s})
    os.makedirs(ZUVO, exist_ok=True)
    with open(INDEX, "w") as f:
        for it in items:
            f.write(json.dumps(it) + "\n")
    json.dump({"hosts": {h: {"received_at": t, "run_id": r} for h, (t, r) in newest.items()},
               "strays": stray_out, "items": len(items)}, open(META, "w"), indent=2)
    return items, stray_out, newest


def load():
    if not os.path.exists(INDEX):
        sys.exit(f"no index yet — run: {sys.argv[0]} sync")
    items = [json.loads(l) for l in open(INDEX) if l.strip()]
    meta = json.load(open(META)) if os.path.exists(META) else {}
    return items, meta


def cmd_sync():
    tok = (os.environ.get("CODESIFT_COLLECTOR_TOKEN") or os.environ.get("ZUVO_COLLECTOR_TOKEN") or "").strip()
    if not tok:  # fetch it from the collector host so cron needs no local secret
        # `&&`: a collector.env that cannot be read is that failure, by name — not an empty token reported
        # as "no token in its collector.env". Either name, in the order this host honours them locally.
        tok = collector_ssh(f". {COLLECTOR_ENV} && "
                            "printf '%s\\n' \"${CODESIFT_COLLECTOR_TOKEN:-${ZUVO_COLLECTOR_TOKEN:-}}\"",
                            60, "fetch the collector token").strip()
        if not tok:
            sys.exit(f"backlog: the collector {VPS} has no CODESIFT_COLLECTOR_TOKEN "
                     f"(or ZUVO_COLLECTOR_TOKEN) in its collector.env — not pushing without one; "
                     f"nothing was changed")
    env = dict(os.environ, CODESIFT_COLLECTOR_TOKEN=tok)
    try:
        out = subprocess.run([sys.executable, os.path.join(ZUVO, "backlog-collect.py"), "--push"],
                             capture_output=True, text=True, env=env, timeout=300)
    except subprocess.TimeoutExpired:
        # Killed mid-flight: some batches may already be on the collector. Say so rather than guess.
        sys.exit("backlog: the push (backlog-collect.py --push) did not finish within 300s — it may or may "
                 "not have landed on the collector; the index was not refreshed")
    except OSError as e:
        sys.exit(f"backlog: could not run backlog-collect.py ({e}) — nothing was pushed; "
                 f"the index was not refreshed")
    if out.stdout.strip():
        print(out.stdout.strip())
    if out.stderr.strip():
        print(out.stderr.strip(), file=sys.stderr)
    if out.returncode != 0:
        # Pulling after a failed push would print a fresh-looking index over a push that never landed.
        sys.exit(f"backlog: the push (backlog-collect.py --push) failed (exit {out.returncode}) — "
                 f"the index was not refreshed")
    try:
        pulled = pull(unreadable_ok=True)
    except SystemExit as e:
        # collector_ssh ends with "nothing was changed"; after a push that landed, only the local index
        # is unchanged — say that, not something the push already contradicts.
        msg = e.code if isinstance(e.code, str) else f"backlog: the pull failed (exit {e.code})"
        msg = msg.removesuffix("; nothing was changed")
        sys.exit(f"{msg}; the local index was not changed, but the push above did land")
    if pulled is None:
        print("index: not refreshed on this host — the collector's backlog data dir is not readable by its "
              "ssh user here; the push above landed, and a host that can read the dir relays the index")
        return
    report_pull(*pulled)


def cmd_pull():
    report_pull(*pull())


def report_pull(items, strays, newest):
    print(f"index: {INDEX} — {len(items)} items from {len(newest)} host(s)")
    for h, (_ts, r) in sorted(newest.items()):
        n = sum(1 for i in items if i.get("host") == h)
        print(f"  {h}: {n} items (run {r})")
    if strays:
        print(f"  ⚠ {len(strays)} worktree-fork copies flagged (see `backlog strays`)")


def cmd_ls():
    items, meta = load()
    per = collections.defaultdict(lambda: {"open": 0, "done": 0, "oldest": "", "host": ""})
    for i in items:
        k = f"{i.get('host','?').split('.')[0]}:{i.get('repo','?')}"
        d = per[k]
        d["host"] = i.get("host", "")
        d[i.get("status", "open")] = d.get(i.get("status", "open"), 0) + 1
        a = i.get("added") or ""
        if a and (not d["oldest"] or a < d["oldest"]):
            d["oldest"] = a
    rows = sorted(per.items(), key=lambda kv: -kv[1]["open"])
    print(f"{'repo':<46} {'open':>6} {'done':>6}  oldest")
    print("-" * 74)
    for k, d in rows:
        print(f"{k[:45]:<46} {d['open']:>6} {d['done']:>6}  {d['oldest'] or '-'}")
    print("-" * 74)
    print(f"TOTAL open={sum(d['open'] for _, d in rows)} done={sum(d['done'] for _, d in rows)} "
          f"across {len(rows)} repos / {len(meta.get('hosts', {}))} hosts")


def cmd_open(args):
    items, _ = load()
    repo = None
    if "--repo" in args:
        _ri = args.index("--repo") + 1
        if _ri >= len(args):
            print("backlog open: --repo needs a value", file=sys.stderr)
            return 2
        repo = args[_ri]
    sel = [i for i in items if i.get("status") == "open" and (not repo or repo in i.get("repo", ""))]
    sel.sort(key=lambda i: i.get("added") or "", reverse=True)
    for i in sel[:60]:
        print(f"[{i.get('added') or '----------'}] {i.get('host','?').split('.')[0]}:{i.get('repo')} "
              f"{i.get('item_id')} {(i.get('severity') or '-'):>8} | {i.get('text','')[:110]}")
    print(f"\n({len(sel)} open{' in ' + repo if repo else ''}, showing {min(60, len(sel))})")


def cmd_crit():
    items, _ = load()
    sel = [i for i in items if i.get("status") == "open" and i.get("severity") in ("critical", "high")]
    sel.sort(key=lambda i: (i.get("severity") != "critical", i.get("added") or ""))
    for i in sel[:60]:
        print(f"{i.get('severity','').upper():>8} {i.get('host','?').split('.')[0]}:{i.get('repo')} "
              f"{i.get('item_id')} | {i.get('text','')[:110]}")
    print(f"\n({len(sel)} critical/high open across the fleet, showing {min(60, len(sel))})")


def cmd_grep(args):
    if not args:
        sys.exit("usage: backlog grep <text>")
    q = " ".join(args).lower()
    items, _ = load()
    sel = [i for i in items if q in (i.get("text", "") + i.get("repo", "")).lower()]
    for i in sel[:60]:
        print(f"{i.get('status','?'):>4} {i.get('host','?').split('.')[0]}:{i.get('repo')} "
              f"{i.get('item_id')} | {i.get('text','')[:110]}")
    print(f"\n({len(sel)} matches, showing {min(60, len(sel))})")


def cmd_strays():
    _, meta = load()
    st = meta.get("strays", [])
    if not st:
        print("no worktree-fork backlog copies — clean ✓")
        return
    print(f"{len(st)} worktree-fork copies (protocol says ONE backlog per repo, at the MAIN checkout):")
    for s in st:
        print(f"  {s['host'].split('.')[0]}: {s['path']}")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "ls"
    rest = sys.argv[2:]
    {"sync": lambda: cmd_sync(), "pull": lambda: cmd_pull(), "ls": lambda: cmd_ls(),
     "open": lambda: cmd_open(rest), "crit": lambda: cmd_crit(),
     "grep": lambda: cmd_grep(rest), "strays": lambda: cmd_strays(),
     }.get(cmd, lambda: sys.exit(USAGE))()   # USAGE, not __doc__: the polyglot header line is
                                          # the module docstring now (see the top of this file).
