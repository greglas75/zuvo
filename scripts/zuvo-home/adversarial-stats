#!/bin/sh
# Polyglot sh/python header — same as poll-cost: /bin/sh re-execs this file with whatever Python 3
# the machine has; Python reads the line below as a string literal. Keep it on ONE line.
''''exec "$(command -v python3 || command -v python || echo python3)" "$0" "$@" # '''
"""adversarial-stats — who ran the adversarial reviews, on which model, and who gets the bill.

WHY THIS EXISTS

A lane name is an ACCOUNT SLOT, not a model: `byteplus-3` means "the third BytePlus slot", and
which model it runs lives in an env variable (ZUVO_MODEL_BYTEPLUS_3, ...). A usage table keyed by
lane alone therefore says nothing — on 2026-09-30 three BytePlus rows were GLM, Seed and DeepSeek,
and nobody could tell which, or where to look for the bill. Every row here names the lane AND the
model (both come from the same adversarial.log row), and the table always ends with the billing
page of every vendor that appears in it.

USAGE

    adversarial-stats                  # last 7 days, all projects
    adversarial-stats --days 30
    adversarial-stats --since 2026-09-23
    adversarial-stats --project zuvo-plugin
    adversarial-stats --markdown       # for pasting into a chat or a doc

COLUMNS

    RUNS      invocations that were attempted (outcome `not-attempted` is left out)
    OK%       outcome `ok` / RUNS
    P50/P90   provider wall time of successful reviews, in seconds
    FIND      findings per successful review
    CRIT      CRITICALs per successful review — what the model REPORTED, not what was right.
              A louder model scores higher here; precision needs the findings ledger.
    FAILURES  every non-ok outcome with its count

Test rows (`mock-*` lanes) and summary rows are never counted.
"""
import argparse
import datetime as dt
import os
import sys
import math
import re
from collections import defaultdict

# Lane prefix -> (who you pay, where the usage/bill is). Add a vendor here when a lane is added;
# a lane with no entry is printed as "unknown" so the gap is visible instead of silent.
BILLING = [
    ("byteplus", "BytePlus ModelArk (Coding Plan)",
     "https://console.byteplus.com/ark/region:ap-southeast-1/subscription/coding-plan"),
    ("openrouter", "OpenRouter (per token)", "https://openrouter.ai/activity"),
    ("qwen", "Alibaba Model Studio (Token Plan Intl)", "https://modelstudio.console.alibabacloud.com/ap-southeast-1/subscription/token-plan/personal"),
    ("codex", "OpenAI (ChatGPT plan)", "https://chatgpt.com/codex/settings/usage"),
    ("claude", "Anthropic (Claude plan)", "https://claude.ai/settings/usage"),
    ("cursor", "Cursor", "https://cursor.com/dashboard?tab=usage"),
    ("codestral", "Mistral", "https://console.mistral.ai/usage"),
    ("agy", "Google Antigravity", None),
    ("gemini", "Google Gemini API", None),
    ("kimi-api", "Moonshot API (per token)", None),  # a different bill from the Kimi Code plan
    ("kimi", "Moonshot Kimi Code", None),
    ("muse", "Muse", None),
]

# adversarial.log columns — the writer's LOG_HEADER in scripts/adversarial-review.sh is the source;
# tests/hooks/test-adversarial-stats.sh fails if these indices stop naming the same fields there.
C_DATE, C_MODEL, C_FIND, C_CRIT, C_DUR, C_PROVIDER, C_OUTCOME, C_PDUR, C_PROJECT = 0, 3, 6, 7, 10, 13, 14, 15, 16
SKIP_LANES = {"", "none", "input_file"}
ROW_DATE = re.compile(r"\d{4}-\d\d-\d\dT")  # a data row; the header row and "#schema" lines are not


def billing_for(lane):
    """The LONGEST matching prefix wins, and a prefix only matches at a `-` boundary (byteplus-3,
    codex-5.4, cursor-agent): `kimi-api` is never billed as `kimi`, whatever the list order."""
    hits = [(prefix, vendor, url) for prefix, vendor, url in BILLING
            if lane == prefix or lane.startswith(prefix + "-")]
    if not hits:
        return "unknown", None
    _, vendor, url = max(hits, key=lambda h: len(h[0]))
    return vendor, url


def seconds(value):
    value = (value or "").strip()
    if value.endswith("s"):
        value = value[:-1]
    try:
        return max(0, int(float(value)))  # a clock step can log a negative duration
    except (ValueError, OverflowError):  # "inf" / "1e999" in a hand-edited or corrupt row
        return None


def count(value):
    try:
        return max(0, int(value.strip()))
    except (ValueError, AttributeError):
        return 0


def percentile(values, pct):
    if not values:
        return None
    ordered = sorted(values)  # nearest rank: monotonic, no banker's rounding between sizes
    return ordered[max(0, min(len(ordered), math.ceil(pct / 100.0 * len(ordered))) - 1)]


def days_arg(value):
    n = int(value)
    if not 1 <= n <= 3650:
        raise argparse.ArgumentTypeError("must be 1-3650, got %d" % n)
    return n


def parse_args(argv):
    p = argparse.ArgumentParser(prog="adversarial-stats", description="Adversarial review usage per lane and model.")
    p.add_argument("--days", type=days_arg, default=7, help="window in days, 1-3650 (default 7)")
    p.add_argument("--since", help="start date YYYY-MM-DD (overrides --days)")
    p.add_argument("--project", help="only rows from this project")
    p.add_argument("--markdown", action="store_true", help="print a Markdown table")
    # Same resolution as the writer (adversarial-review.sh): an explicit log file, else $ZUVO_HOME.
    default_log = os.environ.get("ZUVO_ADVERSARIAL_LOG_FILE") or os.path.join(
        os.environ.get("ZUVO_HOME") or os.path.join(os.path.expanduser("~"), ".zuvo"), "adversarial.log")
    p.add_argument("--log", default=default_log)
    return p.parse_args(argv)


def collect(args):
    if args.since:
        try:
            # YYYY-MM-DD or YYYYMMDD — parsed here, not by fromisoformat, whose accepted forms
            # widen with the Python version (3.11 added the compact one).
            # The tool's own "since …T…Z" header is accepted too: only its date part counts.
            m = re.fullmatch(r"(\d{4})-?(\d{2})-?(\d{2})(?:[T ][\d:.]+Z?)?", args.since)
            if not m:
                raise ValueError(args.since)
            day = dt.date(*map(int, m.groups()))
        except ValueError:
            sys.exit("ERROR: --since must be YYYY-MM-DD, got '%s'" % args.since)
        # Normalised: fromisoformat also takes 20260923 and 2026-W39-1, which compared raw against
        # "2026-09-23T…" timestamps would cut at the wrong place. Midnight UTC keeps the whole day.
        since = day.isoformat() + "T00:00:00Z"
    else:
        since = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=args.days)).strftime("%Y-%m-%dT%H:%M:%SZ")

    skipped = 0
    groups = defaultdict(lambda: {"runs": 0, "ok": 0, "find": 0, "crit": 0, "dur": [], "fail": defaultdict(int)})
    try:
        fh = open(args.log, encoding="utf-8", errors="replace")
    except OSError as exc:
        sys.exit("ERROR: cannot read %s: %s" % (args.log, exc))
    with fh:
        for line in fh:
            cols = line.rstrip("\r\n").split("\t")
            # Only data rows start with a timestamp; the header, "#schema" and the writer's SUMMARY
            # rows do not and are not usage. A dated row in the window that is too short to read
            # is a truncated write — counted, so a gap is visible instead of silent.
            if not ROW_DATE.match(cols[C_DATE]) or cols[C_DATE] < since:
                continue
            if len(cols) <= C_OUTCOME:
                skipped += 1
                continue
            lane, outcome = cols[C_PROVIDER].strip(), cols[C_OUTCOME].strip()
            if lane in SKIP_LANES or lane.startswith("mock-") or outcome == "not-attempted":
                continue
            if args.project and (len(cols) <= C_PROJECT or cols[C_PROJECT].strip() != args.project):
                continue
            g = groups[(lane, cols[C_MODEL].strip() or "?")]
            g["runs"] += 1
            if outcome != "ok":
                g["fail"][outcome or "?"] += 1
                continue
            g["ok"] += 1
            g["find"] += count(cols[C_FIND])
            g["crit"] += count(cols[C_CRIT])
            # Time of SUCCESSFUL reviews only, from the provider column only: a timeout row's
            # duration is the cap, and the older total-duration column measures something else.
            d = seconds(cols[C_PDUR]) if len(cols) > C_PDUR else None
            if d is not None:
                g["dur"].append(d)
    return since, groups, skipped


def rows(groups):
    out = []
    for (lane, model), g in sorted(groups.items(), key=lambda kv: (-kv[1]["runs"], kv[0])):
        vendor, _ = billing_for(lane)
        p50, p90 = percentile(g["dur"], 50), percentile(g["dur"], 90)
        ok = g["ok"]
        out.append({
            "lane": lane, "model": model, "pays": vendor.split(" (")[0],
            "runs": str(g["runs"]),
            "ok": "%d%%" % (100 * ok // g["runs"]),  # floor: 199/200 must not read as 100%
            "time": "%s/%ss" % (p50, p90) if p50 is not None else "-",
            "find": "%.1f" % (g["find"] / ok) if ok else "-",
            "crit": "%.2f" % (g["crit"] / ok) if ok else "-",
            "fail": ", ".join("%s %d" % (k, v) for k, v in sorted(g["fail"].items(), key=lambda kv: (-kv[1], kv[0]))) or "-",
        })
    return out


HEAD = [("lane", "LANE"), ("model", "MODEL"), ("pays", "PAYS"), ("runs", "RUNS"), ("ok", "OK%"),
        ("time", "P50/P90"), ("find", "FIND"), ("crit", "CRIT"), ("fail", "FAILURES")]
RIGHT = {"runs", "ok", "time", "find", "crit"}


def render_text(table):
    widths = {k: max([len(h)] + [len(r[k]) for r in table]) for k, h in HEAD}
    def fmt(r):
        return "  ".join((r[k].rjust(widths[k]) if k in RIGHT else r[k].ljust(widths[k])) for k, _ in HEAD).rstrip()
    lines = [fmt(dict(HEAD)), fmt({k: "-" * widths[k] for k, _ in HEAD})]
    lines += [fmt(r) for r in table]
    return "\n".join(lines)


def md_code(text):
    """Log data inside a code span: `|` must still be escaped (GFM splits the row first), a backtick
    would end the span; backslashes stay literal there, so they are not doubled."""
    return text.replace("|", "\\|").replace("`", "'")


def md_text(text):
    """Log data as plain cell text: neutralise everything Markdown would interpret."""
    return re.sub(r"([\\`*_\[\]#|<>$&])", r"\\\1", text)


def render_markdown(table):
    lines = ["| " + " | ".join(h for _, h in HEAD) + " |",
             "|" + "|".join("---:" if k in RIGHT else "---" for k, _ in HEAD) + "|"]
    for r in table:
        cells = [("`%s`" % md_code(r[k])) if k in ("lane", "model") else md_text(r[k]) for k, _ in HEAD]
        lines.append("| " + " | ".join(cells) + " |")
    return "\n".join(lines)


def billing_footer(table, markdown):
    lanes_by_vendor = defaultdict(list)
    for r in table:
        vendor, url = billing_for(r["lane"])
        if r["lane"] not in lanes_by_vendor[(vendor, url)]:
            lanes_by_vendor[(vendor, url)].append(r["lane"])
    lines = ["", "**Billing / usage pages**" if markdown else "Billing / usage pages:"]
    for (vendor, url), lanes in sorted(lanes_by_vendor.items(), key=lambda kv: kv[0][0]):
        if url:
            target = url
        elif vendor == "unknown":
            target = "lane not in BILLING — add its vendor to scripts/zuvo-home/adversarial-stats"
        else:
            target = "this vendor has no usage page we know of"
        lanes_s = ", ".join(md_text(l) if markdown else l for l in lanes)
        lines.append(("- %s (%s): %s" if markdown else "  %s  [%s]  %s") % (vendor, lanes_s, target))
    return "\n".join(lines)


def main(argv):
    args = parse_args(argv)
    since, groups, skipped = collect(args)
    scope = " · project %s" % args.project if args.project else ""
    print("Adversarial review usage since %s%s" % (since, scope))
    if not groups:
        print("(no provider rows since %s%s in %s)" % (since, scope, args.log))
        return 1 if args.project else 0
    table = rows(groups)
    print()
    print(render_markdown(table) if args.markdown else render_text(table))
    print(billing_footer(table, args.markdown))
    if skipped:
        print("\n%d truncated row(s) in the window skipped — not counted above." % skipped)
    print("\nCRIT = CRITICALs a model reported per review, not how many were right.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
