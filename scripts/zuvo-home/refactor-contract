#!/bin/sh
# Polyglot sh/python header — see compute-preload for why this exact line matters on Windows.
''''exec "$(command -v python3 || command -v python || echo python3)" "$0" "$@" # '''
"""
~/.zuvo/refactor-contract — read and advance a refactor CONTRACT with one command.

WHY THIS EXISTS

Measured across 25 real refactor sessions and 1,010 contracts on disk:

  * The contract is edited by hand-written python heredocs. `c["stage"]="PHASE_3_5"`,
    `c["prove"]["regression_red"]=...`, composed fresh each time. 22 of those heredocs were
    literally re-issued within a session, and 13% of ALL bash calls in a refactor session repeat a
    command already issued. Composing a heredoc is several turns; a typo corrupts the state file
    that the whole run depends on.

  * `stage` is unvalidated free text, so agents invented their own. In the wild: READY_FOR_COMMIT
    (28), EXECUTION_COMPLETE (8), EXECUTION_COMPLETE_UNCOMMITTED (7), READY_TO_COMMIT (3) — two of
    those are the same state spelled two ways, and any code matching one misses the other. 92
    contracts have no `stage` field at all.

  * Nothing ages a contract out. 268 contracts across the fleet are "active" by the resume rule
    (`stage != COMPLETE`), and 134 of them have not been touched in over two weeks. `continue` is
    specified to list candidates and let the user pick; in tgm-survey-platform that list is 34
    entries, 32 of them abandoned. A resume command nobody can use is a resume command nobody uses.

So: one command, a closed vocabulary, atomic writes, and a proof gate on the phase boundary that
fills it — you cannot enter a phase whose prerequisites are still `not_run`. That last part is the
point. A contract that records `prove.regression_red: not_run` and a stage of PHASE-4 is not a
resumable state, it is a claim with no evidence behind it.

Usage:
  ~/.zuvo/refactor-contract [--file <src>] [--contract <path>] show
  ~/.zuvo/refactor-contract list [--stale-days N] [--json]
  ~/.zuvo/refactor-contract stage <STAGE> [--force]
  ~/.zuvo/refactor-contract prove <field> <evidence>
  ~/.zuvo/refactor-contract set <dotted.key> <json-value>
  ~/.zuvo/refactor-contract append progress <text>

Exit codes:
  0  done
  1  refused — a gate is unmet (the message says which, and what would satisfy it)
  2  usage / not found
"""
import argparse
import contextlib
import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import runpy
import uuid
import tempfile
import shutil
from pathlib import Path
from workflow_evidence import snapshot

_READER = next((p for p in (Path(__file__).resolve().with_name("refactor-state.py"),
                           Path(__file__).resolve().parents[2] / "hooks/lib/refactor-state.py",
                           Path.home() / ".claude/hooks/lib/refactor-state.py") if p.is_file()), None)
if _READER is None:
    sys.exit("refactor-contract: structural reader unavailable; reinstall Zuvo")
_STATE = runpy.run_path(str(_READER))
_READ_VERSIONS = {}

# The closed vocabulary. Everything agents actually invented is mapped onto it rather than
# rejected outright: refusing a run's own history helps nobody, and the four invented spellings all
# mean something this list can express.
STAGES = ["PHASE-1", "PHASE-2", "PHASE-3", "PHASE-3.5", "PHASE-3.6", "PHASE-3.7",
          "PHASE-4", "BLOCKED", "ABORTED", "COMPLETE"]

ALIASES = {
    "READY_FOR_COMMIT": "PHASE-3.5",
    "READY_TO_COMMIT": "PHASE-3.5",
    "EXECUTION_COMPLETE": "PHASE-3.5",
    "EXECUTION_COMPLETE_UNCOMMITTED": "PHASE-3.5",
    "PHASE_1": "PHASE-1", "PHASE_2": "PHASE-2", "PHASE_3": "PHASE-3",
    "PHASE_3_5": "PHASE-3.5", "PHASE_3_6": "PHASE-3.6", "PHASE_3_7": "PHASE-3.7",
    "PHASE_4": "PHASE-4",
}

PROVE_FIELDS = ["characterization", "blind_audit", "adversarial", "regression_red",
                "findings_disposition", "test_quality", "split_coverage",
                "complexity_before", "complexity_reduced", "characterization_after"]

# What each phase REQUIRES to have been proven before it can be entered. Gate on the boundary AFTER
# the phase that fills a field, never inside it — a gate that fires while its own evidence is still
# being produced only teaches people to bypass it.
REQUIRES = {
    "PHASE-3": ["characterization", "complexity_before"],
    "PHASE-3.5": ["characterization", "regression_red"],
    "PHASE-3.6": ["characterization", "regression_red", "findings_disposition"],
    "PHASE-4": ["characterization", "regression_red", "findings_disposition", "test_quality"],
    "COMPLETE": ["characterization", "regression_red", "findings_disposition", "test_quality"],
}

UNPROVEN = ("not_run", "pending", "", "-", "todo", "tbd", "n/a-pending")


def repo_root(start=None):
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=start or os.getcwd(),
                             capture_output=True, text=True, timeout=15)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except Exception:
        pass
    return os.getcwd()


def contracts_dir(root):
    base = os.environ.get("ZUVO_OUTPUT_DIR") or os.path.join(root, "zuvo")
    return os.path.join(base, "contracts")


def target_hash(path):
    """The skill keys a contract by a hash of the target path — mirror it exactly."""
    return hashlib.sha256(path.encode("utf-8")).hexdigest()[:8]


# A contract is named for its target hash and nothing else. The sidecars the skill writes beside it
# carry a suffix, and they are the files a shape check cannot rule out when they are ALSO malformed
# — which is exactly the case in the wild: three unparseable `-adversarial` / `-findings` files were
# still being offered as resume candidates after the shape guard went in.
CONTRACT_NAME = re.compile(r"^refactor-[0-9a-f]{6,40}\.json$")


def is_contract(obj):
    """A contract, as opposed to a sidecar that happens to match the same glob.

    `zuvo/contracts/refactor-*.json` also matches `refactor-<hash>-adversarial.json` and
    `refactor-<hash>-findings.json`, which the skill writes beside the real thing. The resume scan
    uses that glob, so in tgm-survey-platform `continue` offers three files that are not contracts
    at all — on top of the 31 abandoned ones. Identify by SHAPE rather than by filename: a contract
    carries a stage, a target file, or the prove block.
    """
    return isinstance(obj, dict) and any(k in obj for k in ("stage", "prove", "file", "cq_before"))


def read_json(path):
    try:
        _READ_VERSIONS[os.path.realpath(path)] = hashlib.sha256(Path(path).read_bytes()).hexdigest()
    except OSError:
        return None
    return _STATE["read_contract"](path)


def write_atomic(path, data):
    """Never leave a half-written contract. A truncated state file loses the whole run's evidence."""
    path = os.path.realpath(path)
    lock = path + ".lock"
    try:
        lock_fd = os.open(lock, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            if os.name == "nt":
                import msvcrt
                if os.fstat(lock_fd).st_size == 0:
                    os.write(lock_fd, b"0")
                os.lseek(lock_fd, 0, os.SEEK_SET)
                msvcrt.locking(lock_fd, msvcrt.LK_NBLCK, 1)
            else:
                import fcntl
                fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (OSError, ImportError) as exc:
            os.close(lock_fd)
            raise OSError("could not acquire " + lock) from exc
    except OSError as exc:
        print("refactor-contract: lock unavailable: " + str(exc), file=sys.stderr)
        return False
    tmp = None
    try:
        current = hashlib.sha256(Path(path).read_bytes()).hexdigest()
        if current != _READ_VERSIONS.get(path):
            print("refactor-contract: concurrent update detected; reload and retry", file=sys.stderr)
            return False
        fd, tmp = tempfile.mkstemp(prefix=".refactor-", dir=os.path.dirname(os.path.abspath(path)))
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as fh:
            json.dump(data, fh, indent=1)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
        _READ_VERSIONS[os.path.realpath(path)] = hashlib.sha256(Path(path).read_bytes()).hexdigest()
        return True
    except OSError:
        return False
    finally:
        if tmp:
            with contextlib.suppress(OSError):
                os.unlink(tmp)
        os.close(lock_fd)  # OS releases the lock on close/crash; keep the inode stable.


def canonical_stage(raw):
    s = (raw or "").strip()
    if s in STAGES:
        return s, None
    up = s.upper().replace(" ", "_")
    if up in ALIASES:
        return ALIASES[up], "'%s' is not a stage — recorded as %s" % (s, ALIASES[up])
    if up in STAGES:
        return up, None
    return None, ("'%s' is not a stage. Use one of: %s" % (s, ", ".join(STAGES)))


def find_contract(a, root):
    d = contracts_dir(root)
    if a.contract:
        return a.contract if os.path.isfile(a.contract) else None
    if a.file:
        p = os.path.join(d, "refactor-%s.json" % target_hash(a.file))
        if os.path.isfile(p):
            return p
        # The path may have been given relative to the repo; try the other spelling before failing.
        alt = os.path.relpath(os.path.abspath(a.file), root)
        p2 = os.path.join(d, "refactor-%s.json" % target_hash(alt))
        if os.path.isfile(p2):
            return p2
        # Old skill templates used SHA-1 names. Resolve their structural target without renaming.
        matches = []
        target = os.path.normpath(os.path.abspath(a.file))
        for candidate in sorted(glob.glob(os.path.join(d, "refactor-*.json"))):
            c = read_json(candidate)
            source = c.get("file") if c else None
            if isinstance(source, str) and os.path.normpath(os.path.join(root, source)) == target:
                matches.append(candidate)
        return matches[0] if len(matches) == 1 else None
    active = []
    for p in sorted(glob.glob(os.path.join(d, "refactor-*.json"))):
        if not CONTRACT_NAME.match(os.path.basename(p)):
            continue
        c = read_json(p)
        if not is_contract(c) or canonical_stage(c.get("stage"))[0] in _STATE["TERMINAL"]:
            continue
        # Auto-selection considers only what a person would plausibly still be working on. An
        # abandoned contract is not a candidate just because nobody marked it COMPLETE.
        if (time.time() - os.path.getmtime(p)) / 86400.0 > 14:
            continue
        active.append(p)
    return active[0] if len(active) == 1 else None


def cmd_list(a, root):
    d = contracts_dir(root)
    rows = []
    for p in sorted(glob.glob(os.path.join(d, "refactor-*.json"))):
        if not CONTRACT_NAME.match(os.path.basename(p)):
            continue                     # a sidecar by name — never a resume candidate
        c = read_json(p)
        if c is not None and not is_contract(c):
            continue                     # a sidecar by shape
        if c is None:
            rows.append((p, "UNREADABLE", None, 0))
            continue
        raw = c.get("stage", "")
        st, _ = canonical_stage(raw)
        age = (time.time() - os.path.getmtime(p)) / 86400.0
        rows.append((p, st or (raw or "(no stage)"), c.get("file"), age))

    live = [r for r in rows if r[1] not in _STATE["TERMINAL"]]
    fresh = [r for r in live if r[3] <= a.stale_days]
    stale = [r for r in live if r[3] > a.stale_days]

    if a.json:
        print(json.dumps({"resumable": [{"contract": r[0], "stage": r[1], "file": r[2],
                                         "age_days": round(r[3], 1)} for r in fresh],
                          "stale": len(stale), "complete": len(rows) - len(live)}, indent=1))
        return 0

    print("contracts in %s" % os.path.relpath(d, root))
    print("  complete: %d   resumable: %d   stale (>%dd, not offered): %d"
          % (len(rows) - len(live), len(fresh), a.stale_days, len(stale)))
    if fresh:
        print("\n  RESUMABLE")
        for p, st, f, age in sorted(fresh, key=lambda r: r[3]):
            print("    %-12s %5.1fd  %s" % (st, age, f or os.path.basename(p)))
    if stale:
        # Say what was hidden and why. A list that silently drops entries reads as complete.
        print("\n  %d stale contract(s) not listed — untouched for over %d days. They are what makes"
              % (len(stale), a.stale_days))
        print("  `continue` unusable when it offers every one of them; `--stale-days 3650` shows them.")
    return 0


def render(c, path, root, note=None):
    print("=" * 78)
    print("CONTRACT  %s" % (c.get("file") or os.path.basename(path)))
    print("  stage: %-12s  type: %-18s mode: %s"
          % (c.get("stage", "?"), c.get("type", "?"), c.get("mode", "?")))
    if note:
        print("  note:  %s" % note)
    prove = c.get("prove") or {}
    unproven = [k for k in PROVE_FIELDS if str(prove.get(k, "not_run")).strip().lower() in UNPROVEN]
    print("  prove: %d of %d recorded" % (len(PROVE_FIELDS) - len(unproven), len(PROVE_FIELDS)))
    for k in PROVE_FIELDS:
        v = str(prove.get(k, "not_run"))
        mark = " " if v.strip().lower() not in UNPROVEN else "!"
        print("   %s %-22s %s" % (mark, k, v[:46]))
    mods = c.get("modules_created") or []
    if mods:
        print("  modules_created: %d" % len(mods))
    print("=" * 78)


def git_lines(root, *args, limit=None):
    try:
        out = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, timeout=20)
        if out.returncode != 0:
            return []
        lines = [ln for ln in out.stdout.splitlines() if ln.strip()]
        return lines[:limit] if limit else lines
    except Exception:
        return []


def render_where(root):
    """Answer "where am I and what changed" in ONE call.

    Measured across 20 refactor sessions: over half of all git calls are read-only orientation —
    388 `diff`, 364 `log`, 250 `status`, 246 `rev-parse`, against 180 commits. That is roughly 62
    look-at-state calls per session, and each one carries 1-2 deliberation turns in front of it,
    because the model decides what to ask before asking it.

    The turns are the cost, not the git. Deliberation runs 1-2 turns before EVERY tool call — of
    3,325 think-runs in those sessions, 3,250 are one or two turns long and only 75 are longer. So
    there is no long pause to shorten; there are only calls to remove, and four calls answering one
    question is the cheapest kind to remove.
    """
    branch = (git_lines(root, "rev-parse", "--abbrev-ref", "HEAD") or ["?"])[0]
    head = (git_lines(root, "rev-parse", "--short=7", "HEAD") or ["?"])[0]
    subject = (git_lines(root, "log", "-1", "--format=%s") or [""])[0]
    dirty = git_lines(root, "status", "--porcelain")
    stat = git_lines(root, "diff", "--shortstat", "HEAD")
    ahead = git_lines(root, "log", "--oneline", "@{upstream}..HEAD") if git_lines(
        root, "rev-parse", "--abbrev-ref", "@{upstream}") else []

    print("  where: %s @ %s  %s" % (branch, head, subject[:44]))
    if stat:
        print("  uncommitted: %s" % stat[0].strip())
    elif dirty:
        print("  uncommitted: %d file(s), none tracked-modified" % len(dirty))
    else:
        print("  uncommitted: clean")
    if ahead:
        print("  unpushed: %d commit(s)" % len(ahead))
    for ln in dirty[:8]:
        print("     %s" % ln)
    if len(dirty) > 8:
        print("     ... %d more" % (len(dirty) - 8))


def cmd_show(a, root, path):
    c = read_json(path)
    if c is None:
        print("refactor-contract: unreadable contract: %s" % path, file=sys.stderr)
        return 2
    render(c, path, root)
    render_where(root)
    print("=" * 78)
    return 0


def cmd_stage(a, root, path):
    c = read_json(path)
    if c is None:
        print("refactor-contract: unreadable contract: %s" % path, file=sys.stderr)
        return 2
    target, note = canonical_stage(a.value)
    if target is None:
        print("refactor-contract: %s" % note, file=sys.stderr)
        return 2

    prove = c.get("prove") or {}
    # Require only what THIS contract's schema actually tracks.
    #
    # The prove block is a v5 concept and the fleet is mostly on v3: of 761 contracts at COMPLETE,
    # 693 are version 3, and `test_quality` is absent from the prove block entirely in 717 of them —
    # not `not_run`, simply not a field. Gating on the v5 set refused 97% of real completed
    # refactors, including 94% of the last fortnight's. A gate nobody can pass is not strict, it is
    # broken: every caller reaches for --force and the gate stops meaning anything.
    #
    # So: a field is required if the contract carries it (the run was asked for it) or if the
    # contract declares schema v5 or later (it should have carried it). An older contract is held to
    # what it was actually asked to prove.
    version = _STATE["contract_version"](c)
    needs_red = (_STATE["fixes_claimed"](c) if version >= 6
                 else "fix" in str(prove.get("findings_disposition", "")))
    required = [k for k in REQUIRES.get(target, [])
                if (k in prove or version >= 5)
                and (k != "regression_red" or needs_red)
                and (k != "complexity_before" or version < 6
                     or c.get("type") in _STATE["REDUCTION_TYPES"])]
    if version >= 6 and target in ("PHASE-3.5", "PHASE-3.6", "PHASE-4", "COMPLETE"):
        required.append("characterization_after")
    missing = [k for k in required
               if str(prove.get(k, "not_run")).strip().lower() in UNPROVEN]
    quality_errors = []
    if version >= 6 and target in ("PHASE-4", "COMPLETE"):
        quality_errors = _STATE["assessment_errors"](c, root)
        missing.extend(quality_errors)
    if version >= 6 and target in ("PHASE-3.5", "PHASE-3.6", "PHASE-4", "COMPLETE"):
        previous_cwd = os.getcwd()
        try:
            os.chdir(root)
            missing.extend(_STATE["evidence_errors"](c, include_fixes=target != "PHASE-3.5"))
        finally:
            os.chdir(previous_cwd)
    if missing and (not a.force or quality_errors):
        print("REFUSED — %s requires evidence this contract does not carry:" % target,
              file=sys.stderr)
        for k in missing:
            print("    prove.%-22s is %r" % (k, str(prove.get(k, "not_run"))), file=sys.stderr)
        print("\n  Record each with:  ~/.zuvo/refactor-contract prove <field> '<evidence>'",
              file=sys.stderr)
        print("  A stage recorded without its proof is a claim, not a state — and this contract is"
              "\n  what a resumed run, the commit gate and the retro all read as fact.", file=sys.stderr)
        if quality_errors:
            print(
                "  Finish or correct the current assessment; "
                "--force cannot certify incomplete or failed quality.",
                file=sys.stderr,
            )
        else:
            print("  --force records it anyway and is a human's call to make, not the skill's.",
                  file=sys.stderr)
        return 1

    c["stage"] = target
    if not write_atomic(path, c):
        print("refactor-contract: could not write %s" % path, file=sys.stderr)
        return 2
    render(c, path, root, note=note or ("forced past %d unmet gate(s)" % len(missing) if missing else None))
    return 0


def cmd_prove(a, root, path):
    c = read_json(path)
    if c is None:
        print("refactor-contract: unreadable contract: %s" % path, file=sys.stderr)
        return 2
    if a.field not in PROVE_FIELDS:
        print("refactor-contract: '%s' is not a prove field. One of: %s"
              % (a.field, ", ".join(PROVE_FIELDS)), file=sys.stderr)
        return 2
    ev = (a.value or "").strip()
    if ev.lower() in UNPROVEN or len(ev) < 3:
        # "Recording" not_run is the same as not recording, and it is how a field ends up looking
        # answered when nothing happened.
        print("refactor-contract: %r is not evidence. Give the result: a verdict, a count, a path."
              % ev, file=sys.stderr)
        return 2
    if a.field == "test_quality" and _STATE["contract_version"](c) >= 6:
        try:
            _STATE["test_quality_report"](ev, root)
        except (OSError, ValueError) as exc:
            print("refactor-contract: " + str(exc), file=sys.stderr)
            return 2
        candidate = dict(c, prove=dict(c.get("prove", {}), test_quality=ev))
        if ev.startswith("PASS:"):
            errors = _STATE["assessment_errors"](candidate, root)
            if errors:
                print("refactor-contract: cannot record quality PASS: " + "; ".join(errors), file=sys.stderr)
                return 2
    c.setdefault("prove", {})[a.field] = ev
    if not write_atomic(path, c):
        print("refactor-contract: could not write %s" % path, file=sys.stderr)
        return 2
    render(c, path, root)
    return 0


def git_head(root):
    try:
        out = subprocess.run(["git", "rev-parse", "--short=7", "HEAD"], cwd=root,
                             capture_output=True, text=True, timeout=15)
        if out.returncode == 0:
            return out.stdout.strip() or "unknown"
    except Exception:
        pass
    return "unknown"


def parse_counts(out):
    """(passed, failed) from a runner's output, or (None, None).

    Deliberately narrow: vitest and jest both print a `Tests` / `Tests:` summary line, and that line
    is the only thing here worth trusting. Runner output is coloured even when not a TTY, so the
    escapes are stripped first — a previous version of this parse in `verify-tests` read
    "Tests 35 passed" as one test because an SGR sequence sat before the anchor.
    """
    clean = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", out)
    passed = failed = None
    for line in clean.splitlines():
        if not re.match(r"^\s*Tests[:\s]", line):
            continue
        passed = failed = None
        mp = re.search(r"(\d+)\s+passed", line)
        mf = re.search(r"(\d+)\s+failed", line)
        if mp:
            passed = int(mp.group(1))
        elif mf:
            passed = 0
        failed = int(mf.group(1)) if mf else (0 if mp else None)
    if passed is not None or failed is not None:
        return passed, failed
    # Native runner summaries only; never count individual test names or prose mentions.
    match = re.search(r"(?m)^=+ (.+(?:passed|failed).+) =+$", clean)
    if match:
        counts = match.group(1)
        p = re.search(r"(\d+) passed", counts)
        f = re.search(r"(\d+) failed", counts)
        return int(p.group(1)) if p else 0, int(f.group(1)) if f else 0
    match = re.search(r"test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed;", clean)
    if match:
        return int(match.group(1)), int(match.group(2))
    p = re.search(r"(?m)^# pass (\d+)\s*$", clean)
    f = re.search(r"(?m)^# fail (\d+)\s*$", clean)
    if p and f:
        return int(p.group(1)), int(f.group(1))
    match = re.search(r"(?m)^Ran (\d+) tests? in .+$", clean)
    if match:
        total = int(match.group(1))
        if re.search(r"(?m)^OK(?: \(.*\))?$", clean):
            return total, 0
        failure = re.search(r"(?m)^FAILED \((.+)\)$", clean)
        if failure:
            count = sum(int(x) for x in re.findall(r"(?:failures|errors)=(\d+)", failure.group(1)))
            return max(0, total - count), count
    match = re.search(r"(?m)^OK \((\d+) tests?, \d+ assertions?\)", clean)
    if match:
        return int(match.group(1)), 0
    match = re.search(r"(?m)^RESULT: PASS=(\d+) FAIL=(\d+)(?: SKIP=\d+)?$", clean)
    if match:
        return int(match.group(1)), int(match.group(2))
    return passed, failed


def run_suite(cmd, cwd, timeout=1800):
    try:
        p = subprocess.run(cmd, cwd=cwd, shell=True, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, timeout=timeout)
        return p.returncode, p.stdout.decode("utf-8", "replace")
    except subprocess.TimeoutExpired as exc:
        return 124, (exc.stdout or b"").decode("utf-8", "replace") + "\n[timeout after %ds]" % timeout
    except Exception as exc:                                       # pragma: no cover - defensive
        return 126, str(exc)


def measured_run(command, root):
    try:
        before = snapshot(root)
    except (OSError, subprocess.CalledProcessError):
        before = None
    rc, out = run_suite(command, root)
    passed, failed = parse_counts(out)
    try:
        after = snapshot(root)
        test_snapshot = snapshot(root, tests_only=True)
    except (OSError, subprocess.CalledProcessError):
        after = test_snapshot = None
    run_id = uuid.uuid4().hex
    log_dir = Path(root) / "zuvo/reports/refactor/runs"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / (run_id + ".log")
    log_path.write_bytes(out.encode("utf-8"))
    return {"run_id": run_id, "kind": "tests", "repo_root": str(Path(root).resolve()),
            "command": command, "exit_code": rc,
            "passed": passed, "failed": failed, "snapshot": before,
            "stable": before is not None and before == after,
            "test_snapshot": test_snapshot,
            "log": str(log_path.relative_to(root)),
            "log_sha256": hashlib.sha256(out.encode()).hexdigest()}, out


def cmd_baseline(a, root, path):
    """Record the characterization command AND its result, so neither is retyped or asserted.

    Measured across 25 refactor sessions: the single most-repeated shell shape is this command —
    `cd <worktree>` then a ~400-character line carrying the database URL, the spec list, a log path
    and an exit capture, recomposed for every round (baseline, char1, char2). 66 re-issues of the
    environment prefix alone.

    It also makes `prove.characterization` a MEASUREMENT rather than a sentence. Until now that
    field held whatever text the run typed into it, which is the same shape of unverifiable claim
    that had to be closed in verify-tests twice.
    """
    c = read_json(path)
    if c is None:
        return 2
    if a.mode == "compilation" and c.get("test_mode") != "VERIFY_COMPILATION":
        print("baseline: compilation mode requires the plan's VERIFY_COMPILATION classification",
              file=sys.stderr)
        return 2
    run, out = measured_run(a.command, root)
    rc, passed, failed = run["exit_code"], run["passed"], run["failed"]
    verdict = "PASS" if rc == 0 else "FAIL"
    detail = "%s rc=%d" % (verdict, rc)
    if passed is not None:
        detail += " %d passed" % passed
        if failed:
            detail += ", %d failed" % failed
    # The MODE is the agent's classification and stays the agent's to make — `existing`, `dead`,
    # `verify-move` encode which characterization strategy the refactor type calls for, and no
    # command can decide that. What follows it is measured. Keeping both in one field preserves the
    # vocabulary the commit gate and the retro already read.
    sha = git_head(root)
    prefix = "%s:%s:" % (a.mode, sha) if a.mode else ""
    run["kind"] = "compilation" if a.mode == "compilation" else "tests"
    if c.get("evidence", {}).get("characterization_before"):
        c.setdefault("characterization_history", []).append({
            k: c["evidence"].get(k) for k in
            ("characterization_before", "characterization_after")
        })
    valid = rc == 0 and (
        int(c.get("version", 0)) < 6 or run["stable"] and (
            run["kind"] == "compilation" or isinstance(passed, int) and passed > 0 and not failed
        )
    )
    c["characterization_cmd"] = a.command
    c.setdefault("evidence", {})["characterization_before"] = run
    c["evidence"].pop("characterization_after", None)
    c.setdefault("prove", {}).pop("characterization_after", None)
    c.setdefault("prove", {})["characterization"] = prefix + detail if valid else "not_run"
    if not write_atomic(path, c):
        return 2
    render(c, path, root, note="baseline recorded; re-run it with `recheck`")
    if rc != 0:
        print(tail_of(out), file=sys.stderr)

    if not valid and rc == 0:
        print("baseline: no stable executed test summary; compilation requires --mode compilation",
              file=sys.stderr)
    return 0 if valid else 1


def cmd_recheck(a, root, path):
    """Re-run the recorded command and say whether the suite still does what it did.

    This records characterization_after; it is never evidence of a red regression test.
    Re-running the SAME stored command is
    the part that makes the comparison mean anything: a fresh command with a different spec list
    would compare two different things and call it a regression check.
    """
    c = read_json(path)
    if c is None:
        return 2
    cmd = c.get("characterization_cmd")
    if not cmd:
        print("refactor-contract: no baseline recorded. Run `baseline '<command>'` first — the\n"
              "  comparison is only meaningful against the same command.", file=sys.stderr)
        return 2
    before = str((c.get("prove") or {}).get("characterization", ""))
    run, out = measured_run(cmd, root)
    rc, passed, failed = run["exit_code"], run["passed"], run["failed"]
    now = "PASS rc=0" if rc == 0 else "FAIL rc=%d" % rc
    if passed is not None:
        now += " %d passed" % passed
        if failed:
            now += ", %d failed" % failed

    baseline = (c.get("evidence") or {}).get("characterization_before")
    run["kind"] = baseline.get("kind", "tests") if baseline else "tests"
    old_counts = parse_counts("Tests " + before)[0]
    drifted = rc != 0 or (passed != old_counts if not baseline else
                         baseline["exit_code"] != 0 or passed != baseline["passed"])
    if int(c.get("version", 0)) >= 6:
        drifted = drifted or not run["stable"] or not baseline or not baseline.get("stable")
        if run["kind"] != "compilation":
            drifted = (
                drifted or not isinstance(passed, int) or passed <= 0 or bool(failed)
                or bool((baseline or {}).get("failed"))
            )
    c.setdefault("evidence", {})["characterization_after"] = run
    c.setdefault("prove", {})["characterization_after"] = (
        "not_run" if drifted else "%s -> %s" % (before or "no baseline", now)
    )
    if not write_atomic(path, c):
        return 2
    render(c, path, root, note=("DRIFT — the suite does not do what the baseline recorded"
                                if drifted else "unchanged against the baseline"))
    if drifted:
        print(tail_of(out), file=sys.stderr)
        return 1
    return 0


def cmd_check(a, root, path):
    c = read_json(path)
    if c is None:
        print("BLOCK: unreadable contract", file=sys.stderr)
        return 2
    lib = _READER.with_name("refactor-gate-lib.sh")
    if not lib.is_file():
        print("BLOCK: gate library unavailable", file=sys.stderr)
        return 2
    scope = c.get("scope_fence")
    if not isinstance(scope, list) or not scope or not all(isinstance(p, str) for p in scope):
        print("BLOCK: no explicit scope_fence", file=sys.stderr)
        return 2
    with tempfile.TemporaryDirectory() as directory:
        shutil.copyfile(path, os.path.join(directory, "refactor-check.json"))
        env = dict(os.environ, ZUVO_CONTRACTS_DIR=directory, ZUVO_AI_RUN="1", ZUVO_GATE_MODE="pre-push")
        # The hook implementation is the verifier; do not duplicate its predicates in skill prose.
        result = subprocess.run(["sh", "-c", 'LIB="$1"; . "$LIB"; r=0; '
                                 'refactor_gate_check "$2" || r=1; '
                                 'refactor_prove_v4_check "$2" || r=1; exit "$r"',
                                 "refactor-check", str(lib), "\n".join(scope)], cwd=root, env=env)
    if result.returncode == 0:
        print("GATE: PASS — current contract checks satisfied")
        if _STATE["contract_version"](c) >= 6:
            print("QUALITY: " + str(c.get("prove", {}).get("test_quality", "N/A")).split(":", 1)[0])
    return result.returncode


def cmd_regression(a, root, path):
    c = read_json(path)
    if c is None:
        return 2
    evidence = c.setdefault("evidence", {})
    if not isinstance(evidence, dict):
        print("regression: invalid evidence object", file=sys.stderr)
        return 2
    pairs = evidence.setdefault("fix_regressions", [])
    if not isinstance(pairs, list) or any(
        not isinstance(p, dict) or not isinstance(p.get("finding_id"), str)
        or not p["finding_id"] for p in pairs
    ):
        print("regression: invalid fix_regressions entries", file=sys.stderr)
        return 2
    if len({p["finding_id"] for p in pairs}) != len(pairs):
        print("regression: duplicate finding IDs; repair the contract first", file=sys.stderr)
        return 2
    pair = next((p for p in pairs if p.get("finding_id") == a.finding), None)
    if a.color == "green" and (
        not pair or not isinstance(pair.get("red"), dict)
        or pair["red"].get("command") != a.command
    ):
        print("regression: green requires a recorded red with the same command", file=sys.stderr)
        return 2
    run, out = measured_run(a.command, root)
    valid = (
        run["exit_code"] not in (0, 124, 126, 127) and (run["failed"] or 0) > 0
        if a.color == "red"
        else run["exit_code"] == 0 and (run["passed"] or 0) > 0 and not run["failed"]
    )
    if not valid or not run["stable"]:
        print("regression: no stable, demonstrated " + a.color + " result\n" + tail_of(out), file=sys.stderr)
        return 1
    if a.color == "red":
        if pair:
            pairs.remove(pair)
        pairs.append({"finding_id": a.finding, "red": run})
    else:
        pair["green"] = run
        ids = c.setdefault("fix_findings", [])
        if a.finding not in ids:
            ids.append(a.finding)
        c["findings_outcome"] = "fixed"
        c.setdefault("prove", {})["regression_red"] = "linked:" + ",".join(
            p["finding_id"] for p in pairs if "green" in p
        )
    if not write_atomic(path, c):
        return 2
    print("regression: " + a.finding + " " + a.color + " run=" + run["run_id"])
    return 0


def tail_of(text, n=20):
    lines = [ln for ln in text.splitlines() if ln.strip()]
    return "\n".join(lines[-n:])


def cmd_set(a, root, path):
    c = read_json(path)
    if c is None:
        return 2
    try:
        value = json.loads(a.value)
    except ValueError:
        value = a.value
    node = c
    parts = a.key.split(".")
    for p in parts[:-1]:
        node = node.setdefault(p, {})
        if not isinstance(node, dict):
            print("refactor-contract: %s is not an object" % p, file=sys.stderr)
            return 2
    node[parts[-1]] = value
    if not write_atomic(path, c):
        return 2
    render(c, path, root)
    return 0


def cmd_append(a, root, path):
    c = read_json(path)
    if c is None:
        return 2
    c.setdefault(a.key, []).append(a.value)
    if not write_atomic(path, c):
        return 2
    print("appended to %s (now %d entries)" % (a.key, len(c[a.key])))
    return 0


def main(argv):
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--file", help="target source file the contract is keyed on")
    ap.add_argument("--contract", help="explicit path to the contract json")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("show")
    p_list = sub.add_parser("list")
    p_list.add_argument("--stale-days", type=int, default=14)
    p_list.add_argument("--json", action="store_true")
    p_stage = sub.add_parser("stage")
    p_stage.add_argument("value")
    p_stage.add_argument("--force", action="store_true")
    p_prove = sub.add_parser("prove")
    p_prove.add_argument("field")
    p_prove.add_argument("value")
    p_set = sub.add_parser("set")
    p_set.add_argument("key")
    p_set.add_argument("value")
    p_app = sub.add_parser("append")
    p_app.add_argument("key")
    p_app.add_argument("value")
    p_base = sub.add_parser("baseline")
    p_base.add_argument("command", help="the characterization command, typed ONCE")
    p_base.add_argument("--mode", choices=["existing", "written", "dead", "verify-move", "compilation"],
                        help="which characterization strategy this is — your call, not the tool's")
    sub.add_parser("recheck")
    sub.add_parser("check")
    p_reg = sub.add_parser("regression")
    p_reg.add_argument("finding")
    p_reg.add_argument("color", choices=["red", "green"])
    p_reg.add_argument("command")

    a = ap.parse_args(argv)
    root = repo_root()

    if a.cmd == "list":
        return cmd_list(a, root)

    path = find_contract(a, root)
    if path is None:
        d = contracts_dir(root)
        n = len(glob.glob(os.path.join(d, "refactor-*.json")))
        print("refactor-contract: no single contract selected (%d in %s).\n"
              "  Pass --file <source> or --contract <path>, or run `list` to see what is resumable."
              % (n, os.path.relpath(d, root)), file=sys.stderr)
        return 2

    return {"show": cmd_show, "stage": cmd_stage, "prove": cmd_prove,
            "set": cmd_set, "append": cmd_append,
            "baseline": cmd_baseline, "recheck": cmd_recheck,
            "regression": cmd_regression, "check": cmd_check}[a.cmd](a, root, path)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
