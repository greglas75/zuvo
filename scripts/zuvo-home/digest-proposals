#!/usr/bin/env python3
"""Surface the actionable change-proposals buried in retro-mine digests.

retro-mine turns session retros into a digest with a `## Change proposals` block — concrete
`FILE: … | SECTION: … | CONTENT: … | RATIONALE: …` edits to skill/rule files, derived from real
friction. Nothing consumed them: they piled up unread in ~/.zuvo/mining/, so the whole retro ->
mine -> digest learning loop produced skill improvements that never got applied.

This is the consumer. It parses every digest, DEDUPS proposals by (file, section), counts how
many distinct retros asked for the same change (a recurring ask is a pattern; a one-off may be
incidental), and prints a ranked, reviewable list. The APPLY BAR is deliberately conservative:
a proposal qualifies only if it recurred in >= MIN_RECUR retros (default 2) OR is priority P0 —
everything else is listed as "consider" so a single noisy friction line can never silently
become a permanent skill rule. Applying is a HUMAN/agent review step, not automatic: this only
makes the backlog of proposals visible and triaged.

Usage:
  ~/.zuvo/digest-proposals                 # ranked report, qualifying (apply-bar) first
  ~/.zuvo/digest-proposals --all           # include the below-bar "consider" proposals too
  ~/.zuvo/digest-proposals --json          # machine-readable (for a review/apply step)
  ~/.zuvo/digest-proposals --min-recur N   # tune the recurrence bar (default 2)
  ~/.zuvo/digest-proposals --show-done     # include already-dispositioned proposals

Disposition ledger (mining/proposals-ledger.tsv) — so a run shows only what is still OPEN:
  ~/.zuvo/digest-proposals --mark applied  --file skills/review/SKILL.md --section "1.6 Adversarial" --ref v1.6.35
  ~/.zuvo/digest-proposals --mark rejected --file X --section Y --note "contradicts never-reindex rule"
  dispositions: applied | rejected | covered | not-ours | deferred
"""
import os, sys, re, glob, json, time

ZUVO = os.environ.get("ZUVO_DIR", os.path.expanduser("~/.zuvo"))
MINING = os.path.join(ZUVO, "mining")
# Where the SOURCE files live, for resolving bare filenames to canonical paths. Overridable so the
# helper works from any checkout; falls back to the usual dev location.
REPO_ROOT = os.environ.get("ZUVO_REPO", os.path.expanduser("~/DEV/zuvo-plugin"))
MIN_RECUR = 2
for i, a in enumerate(sys.argv):
    if a == "--min-recur" and i + 1 < len(sys.argv):
        try:
            MIN_RECUR = int(sys.argv[i + 1])
        except ValueError:
            pass

# A proposal block: "### P<n> …" then FILE:/SECTION:, a ```fenced``` CONTENT, and RATIONALE:.
BLOCK = re.compile(r'###\s*P(\d+)\b(.*?)(?=\n###\s*P\d|\Z)', re.S)
FILESEC = re.compile(r'FILE:\s*([^\|\n]+?)\s*\|\s*SECTION:\s*([^\n]+)')
# The SOURCE RETRO a proposal came from. Counting must key on this, NOT on how many digest files
# mention the proposal — mining windows OVERLAP (07-29 covered 07-22..29, 07-30 covered
# 07-23..30), so one retro lands in several digests and every ×1 in the overlap silently inflates
# to ×2 and crosses the apply bar. That is not recurrence, it is the same report counted twice:
# on 2026-07-30, 9 genuinely new retros turned into 111 "recurring" proposals this way.
#
# Identity is the block's HEADER LINE, normalized — not a parsed date. Headers come in at least
# three dialects that a date regex splits apart while they name the same run:
#   "[mac] ## 2026-07-28T17:14:36Z refactor rs_fe six dead frontend modules"
#   "[mac] ## 2026-07-24 review exclude-invoicing exclude-invoicing-performance"
#   "[mac] ## [2026-07-24] [DEGRADED-CONTEXT] execute tgm-survey-platform CBC 05b …"
# Two blocks with the same header are the same retro; two retros never share one (the timestamp
# or the title differs). So the whole line is both the most faithful key and dialect-proof.
HOSTTAG = re.compile(r'\[[^\]]{0,24}\]')          # [mac], [DEGRADED-CONTEXT], … — not the title


def src_retro(body, dg, offset):
    """Identity of the retro a proposal block came from (dialect-independent)."""
    head = body.split("\n", 1)[0]
    head = HOSTTAG.sub(" ", head).replace("#", " ")
    head = " ".join(head.split()).lower()
    # An empty/degenerate header must NOT collapse unrelated blocks together — fall back to a
    # per-block key so a parse miss can only ever over-count, never silently under-count.
    return head if len(head) >= 12 else f"{os.path.basename(dg)}#{offset}"


def norm_file(f):
    """Map a proposal's target to the SOURCE repo path. Retros run under Codex/Cursor record the
    BUILT copy (~/.codex/skills/X/SKILL.md) or a bare X/SKILL.md — editing those is pointless
    (regenerated by the build). Normalize so proposals for the same source file aggregate."""
    f = f.strip().strip("`")
    # any prefix (~, $HOME, /Users/greglas, …) up to a .codex/.cursor segment -> source path
    f = re.sub(r'^.*?/(?:\.codex|\.cursor)/skills/', 'skills/', f)     # built copy -> source
    f = re.sub(r'^.*?/(?:\.codex|\.cursor)/shared/', 'shared/', f)
    f = re.sub(r'^.*?/(?:\.codex|\.cursor)/', '', f)
    # bare "refactor/SKILL.md" / "execute/SKILL.md" -> skills/…
    if re.match(r'^[a-z][a-z0-9-]*/SKILL\.md$', f):
        f = 'skills/' + f
    # "refactor SKILL.md" (space instead of slash) — retros write it both ways
    m = re.match(r'^([a-z][a-z0-9-]*)\s+SKILL\.md$', f)
    if m:
        f = f'skills/{m.group(1)}/SKILL.md'
    # "shared/includes (CHARACTERIZE_GAP section)" — a parenthetical hint, not part of the path
    f = re.sub(r'\s*\([^)]*\)\s*$', '', f).strip()
    # A BARE filename ("review-artifact.md", "testing.md") is the same file as its canonical
    # location. Resolve it against the known source dirs so the two spellings aggregate into ONE
    # identity instead of splitting the recurrence count across two rows — which is how a ×6 item
    # can look like two ×3 items and miss the apply bar.
    if "/" not in f and f.endswith(".md"):
        for d in ("shared/includes", "rules", "docs"):
            if os.path.isfile(os.path.join(REPO_ROOT, d, f)):
                f = f"{d}/{f}"
                break
    elif "/" not in f and f.endswith(".sh"):
        if os.path.isfile(os.path.join(REPO_ROOT, "scripts", f)):
            f = f"scripts/{f}"
    return f
CONTENT = re.compile(r'CONTENT:\s*\n```[a-z]*\n(.*?)\n```', re.S)
RATIONALE = re.compile(r'RATIONALE:\s*([^\n]+)')


def parse_all():
    props = {}                                  # (file, section) -> aggregate
    for dg in sorted(glob.glob(os.path.join(MINING, "digest-*.md"))):
        try:
            text = open(dg, errors="replace").read()
        except Exception:
            continue
        for m in BLOCK.finditer(text):
            prio = int(m.group(1)); body = m.group(2)
            fs = FILESEC.search(body)
            if not fs:
                continue
            f = norm_file(fs.group(1)); s = fs.group(2).strip().strip("`")
            c = CONTENT.search(body); r = RATIONALE.search(body)
            key = (f, s)
            agg = props.setdefault(key, {"file": f, "section": s, "count": 0,
                                         "best_prio": 9, "contents": [], "rationales": [],
                                         "_srcs": set()})
            # Distinct source retros, not digest occurrences.
            src = src_retro(body, dg, m.start())
            if src in agg["_srcs"]:
                continue
            agg["_srcs"].add(src)
            agg["count"] += 1
            agg["best_prio"] = min(agg["best_prio"], prio)
            if c and c.group(1).strip() not in agg["contents"]:
                agg["contents"].append(c.group(1).strip())
            if r:
                agg["rationales"].append(r.group(1).strip())
    for agg in props.values():
        agg.pop("_srcs", None)                  # internal; must not reach --json consumers
    return list(props.values())


# ── disposition ledger ───────────────────────────────────────────────────────────────────
# Without this, EVERY run re-surfaces every proposal — including the ones already implemented,
# which is the same dead end one level up: proposals used to be written and never read; then
# they were read and never dispositioned. Identity is (normalized file, section) — the same key
# this script already dedups on, so a disposition sticks across digests. Append-only, latest row
# per identity wins (same shape as the refactor finding-disposition ledger).
LEDGER = os.path.join(MINING, "proposals-ledger.tsv")
DISPOSITIONS = ("applied", "rejected", "covered", "not-ours", "deferred")


def read_ledger():
    """(file, section) -> {disposition, ref, note, date}; latest row wins."""
    out = {}
    try:
        with open(LEDGER, errors="replace") as fh:
            for line in fh:
                if not line.strip() or line.startswith("#"):
                    continue
                c = line.rstrip("\n").split("\t")
                if len(c) < 4:
                    continue
                date, f, sec, disp = c[0], c[1], c[2], c[3]
                out[(norm_file(f), sec.strip())] = {
                    "disposition": disp, "ref": c[4] if len(c) > 4 else "",
                    "note": c[5] if len(c) > 5 else "", "date": date}
    except FileNotFoundError:
        pass
    except Exception:
        pass                                   # a corrupt ledger must never break reporting
    return out


def _similar(a, b):
    """Loose match for the did-you-mean hint: shared significant words."""
    wa = {w for w in re.findall(r"[A-Za-z][A-Za-z0-9-]{2,}", a.lower())}
    wb = {w for w in re.findall(r"[A-Za-z][A-Za-z0-9-]{2,}", b.lower())}
    return bool(wa & wb)


def mark(argv):
    """`--mark <disposition> --file F --section S [--ref R] [--note N]` — append one row.
    A single short line written with O_APPEND is atomic on POSIX, so concurrent agents
    cannot interleave a half-row; no lock needed for an append-only log."""
    def arg(name, default=""):
        return argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else default
    disp = arg("--mark")
    f, sec = arg("--file"), arg("--section")
    if disp not in DISPOSITIONS:
        print(f"digest-proposals: --mark must be one of {', '.join(DISPOSITIONS)}", file=sys.stderr)
        return 2
    if not f or not sec:
        print("digest-proposals: --mark needs --file and --section", file=sys.stderr)
        return 2
    # Validate the identity EXISTS before writing. Without this, a disposition can be recorded
    # against a (file, section) that matches no proposal — it looks like the item was handled and
    # silently marks nothing. Every orphan in this ledger came from typing the name of the SECTION
    # EDITED instead of the name of the PROPOSAL being dispositioned (e.g. "Recovery When a Query
    # Fails", the heading in codesift-setup.md, vs "Recovery / Read gate", the proposal).
    known = {(p["file"], p["section"]) for p in parse_all()}
    nf = norm_file(f)
    if (nf, sec) not in known and "--force" not in argv:
        near = sorted({p["section"] for p in parse_all()
                       if p["file"] == nf and _similar(sec, p["section"])})[:5]
        print(f"digest-proposals: no proposal matches {nf} :: {sec}", file=sys.stderr)
        if near:
            print("  did you mean one of these sections?", file=sys.stderr)
            for n in near:
                print(f"    - {n}", file=sys.stderr)
        else:
            same = sorted({p["section"] for p in parse_all() if p["file"] == nf})[:6]
            if same:
                print(f"  sections known for {nf}:", file=sys.stderr)
                for n in same:
                    print(f"    - {n}", file=sys.stderr)
            else:
                print(f"  no proposals at all target {nf} — check the path", file=sys.stderr)
        print("  (use --force to record it anyway, e.g. pre-marking a not-yet-mined item)", file=sys.stderr)
        return 2

    row = [time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), f, sec, disp,
           arg("--ref"), arg("--note")]
    row = [re.sub(r"[\t\r\n]", " ", c) for c in row]      # never break the TSV shape
    try:
        os.makedirs(MINING, exist_ok=True)
        new = not os.path.exists(LEDGER)
        with open(LEDGER, "a") as fh:
            if new:
                fh.write("# DATE\tFILE\tSECTION\tDISPOSITION\tREF\tNOTE\n")
            fh.write("\t".join(row) + "\n")
    except Exception as e:
        print(f"digest-proposals: cannot write ledger: {e}", file=sys.stderr)
        return 1
    print(f"marked {disp}: {norm_file(f)} :: {sec}")
    return 0


def qualifies(p):
    return p["count"] >= MIN_RECUR or p["best_prio"] == 0


def rank(props):
    # apply-bar first, then by recurrence, then by priority
    return sorted(props, key=lambda p: (not qualifies(p), -p["count"], p["best_prio"]))


def main():
    if "--mark" in sys.argv:
        return mark(sys.argv)

    props = rank(parse_all())
    if not props:
        print("digest-proposals: no change proposals found (no digests, or none parsed)")
        return 0
    show_all = "--all" in sys.argv
    ledger = read_ledger()
    for p in props:                                   # attach disposition to each identity
        p["status"] = ledger.get((p["file"], p["section"]), {})

    # Dispositioned proposals are DONE work — hide them by default so each run shows only what
    # is still open. `--all` (or --show-done) brings them back with their disposition.
    open_props = [p for p in props if not p["status"]]
    done = len(props) - len(open_props)
    show_done = show_all or "--show-done" in sys.argv
    visible = props if show_done else open_props

    if "--json" in sys.argv:
        out = [dict(p, qualifies=qualifies(p)) for p in visible if show_all or qualifies(p)]
        print(json.dumps(out, indent=2))
        return 0

    q = [p for p in visible if qualifies(p)]
    print(f"# Digest change-proposals — {len(props)} unique (file,section), "
          f"{done} dispositioned, {len(open_props)} open, "
          f"{len(q)} of the shown meet the apply bar (>= {MIN_RECUR} recurrences OR P0)\n")
    for p in visible:
        if not (show_all or qualifies(p)):
            continue
        bar = "APPLY" if qualifies(p) else "consider"
        if p["status"]:
            s = p["status"]
            bar = s["disposition"].upper()
            ref = f" {s['ref']}" if s.get("ref") else ""
            print(f"[{bar}{ref}] P{p['best_prio']}  ×{p['count']}  {p['file']}  ::  {p['section']}")
            if s.get("note"):
                print(f"      {s['note']}")
            print()
            continue
        print(f"[{bar}] P{p['best_prio']}  ×{p['count']}  {p['file']}  ::  {p['section']}")
        if p["contents"]:
            first = p["contents"][0].splitlines()
            for ln in first[:6]:
                print(f"      {ln}")
            if len(first) > 6:
                print(f"      … (+{len(first) - 6} more lines)")
        if p["rationales"]:
            print(f"      WHY: {p['rationales'][0][:120]}")
        print()
    # Orphaned ledger rows: a disposition whose (file, section) matches no proposal. They mark
    # NOTHING, so they must be visible rather than sitting silently in the log — every one so far
    # came from recording the edited section's heading instead of the proposal's name.
    known = {(p["file"], p["section"]) for p in props}
    orphans = [k for k in ledger if k not in known]
    if orphans:
        print(f"NOTE: {len(orphans)} ledger row(s) match no proposal and therefore mark nothing:")
        for f, s in orphans[:5]:
            print(f"  - {f} :: {s}")
        if len(orphans) > 5:
            print(f"  … and {len(orphans) - 5} more")
        print("  (--mark now rejects these; pre-existing rows are harmless no-ops, left in place"
              " because the ledger is append-only)\n")

    if not show_all:
        below = len([p for p in visible if not qualifies(p)])
        if below:
            print(f"({below} more below the apply bar — pass --all to see them)")
    if done and not show_done:
        print(f"({done} dispositioned — pass --show-done to see them)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
