#!/bin/sh
# Polyglot sh/python header — same as poll-cost: /bin/sh re-execs this file with whatever Python 3
# the machine has; Python reads the line below as a string literal. Keep it on ONE line.
''''exec "$(command -v python3 || command -v python || echo python3)" "$0" "$@" # '''
from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import errno
import json
import os
import re
import stat
import subprocess
import sys
