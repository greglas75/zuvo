#!/bin/sh
# Polyglot sh/python header: /bin/sh finds python3 (or python) and re-execs this file with it. No python
# is rc 127; one older than 3.8, the modules' minimum, is rc 2, because it would stop at a SyntaxError
# (rc 1, read as a breach). Python reads the six lines below as one string literal.
''''exec /bin/sh -c 'py="$(command -v python3 || command -v python)" ||
  { echo "comment-audit: error: no python3 or python on PATH" >&2; exit 127; }
"$py" -c "import sys; sys.exit(sys.version_info < (3, 8))" 2>/dev/null ||
  { echo "comment-audit: error: python3 >= 3.8 required" >&2; exit 2; }
exec "$py" "$0" "$@"' "$0" "$@" # '''
from __future__ import annotations

