#!/usr/bin/env bash
# ~/.zuvo/rotate-retros — quarterly archival of ~/.zuvo/retros.md AND retros.log
#
# Why this exists: both files grow monotonically (~7 entries/day in active weeks; retros.md
# ~3K bytes/entry). Left alone retros.md hits 1MB in ~3 months and becomes unreadable to
# humans + slow to grep.
#
# This is the ONLY retention mechanism for either file — both are append-only at the write
# path. `append-retro` previously ALSO truncated retros.log to the last 100 lines on every
# write; that cap was removed (2026-07-22) because at 36 retros/day it held ~2.8 days while
# `retro-mine.py` asks for 7, so entries were destroyed before anything mined them — and,
# running on every append, it silently pre-empted this script's archival. Do not reintroduce
# a count cap in the writer; extend this script instead.
#
# This script splits entries older than N days (default 90) into a per-quarter archive file
# (`retros-archive-YYYY-QN.md` / `.log`) and leaves only recent entries in the live file.
# Idempotent — safe to re-run. Takes the same lock as append-retro (beside the target) so a
# concurrent write is never lost.
#
# Usage:
#   ~/.zuvo/rotate-retros                  # dry-run (default, no changes)
#   ~/.zuvo/rotate-retros --apply          # actually move entries
#   ~/.zuvo/rotate-retros --apply --days 60   # custom threshold
#   ~/.zuvo/rotate-retros --apply --target ~/elsewhere/retros.md
#
# Exit: 0 done (a dry-run that would refuse prints "would refuse:" and still exits 0) | 1 abort |
#       3 lock busy | 4 --apply refused: retros.log is below its high-water, or the rebuild would
#       lose rows (docs/runbook/operating.md §12)
#
# Entry boundary: each entry starts with `<!-- RETRO -->` marker on its own
# line. Entries between markers (or between a marker and EOF) are treated
# atomically — we never split inside an entry.
#
# Date detection: first matches the entry's `## [YYYY-MM-DDTHH:MM:SSZ]`
# header (preferred — emitted by retrospective.md Append). Falls back to
# `## YYYY-MM-DD` or `## <skill> — YYYY-MM-DD` patterns. An entry without
# any parseable date is kept in retros.md (safe default — never archive
# something we can't classify).

set -eu

# Filesystem-level append-only guard on retros.{log,md}. This script is one of exactly three
# legitimate rewriters (with sanitize-retros and append-retro's shrink auto-recovery), so it must
# LIFT the flag around its atomic replace and RE-ARM afterwards — the flag lives on the inode and
# every `mv` into place drops it. See scripts/lib/retro-appendonly.sh for why the flag exists and
# what it measured. Sourcing is optional-by-design: an older install without the lib must still
# rotate, so the functions degrade to no-ops.
if [ -r "$(dirname "$0")/retro-appendonly.sh" ]; then
  . "$(dirname "$0")/retro-appendonly.sh"
else
  zuvo_ao_arm() { :; }; zuvo_ao_lift() { :; }; zuvo_ao_is_armed() { return 1; }
fi

# ── args
APPLY=0
DAYS=90
TARGET="${ZUVO_HOME:-$HOME/.zuvo}/retros.md"
while [ $# -gt 0 ]; do
  case "$1" in
    --apply)  APPLY=1; shift ;;
    --days)   DAYS="$2"; shift 2 ;;
    --target) TARGET="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,30p' "$0" | sed 's/^# //;s/^#//'
      exit 0 ;;
    *) echo "rotate-retros: unknown arg '$1' (try --help)" >&2; exit 1 ;;
  esac
done

[ -f "$TARGET" ] || { echo "rotate-retros: target file not found: $TARGET" >&2; exit 1; }

ARCHIVE_DIR=$(dirname "$TARGET")
CUTOFF_EPOCH=$(( $(date +%s) - DAYS * 86400 ))
CUTOFF_DATE=$(date -u -r "$CUTOFF_EPOCH" +%Y-%m-%d 2>/dev/null || date -u -d "@$CUTOFF_EPOCH" +%Y-%m-%d)

echo "rotate-retros: target=$TARGET days=$DAYS cutoff=$CUTOFF_DATE apply=$APPLY"

# ── TSV branch: retros.log ───────────────────────────────────────────────────
# retros.log is one entry per LINE (`RETRO: <ISO>\t...`), so it needs none of the
# marker-boundary machinery below — but it does need the same guarantee: entries move to an
# archive, they are never destroyed. `append-retro` used to `tail -n 100` this file on every
# write, which at 36 retros/day left ~2.8 days while `retro-mine.py --days 7` wanted a week.
# Undated / malformed lines are KEPT (same safe default as the markdown path).
# Serialize against append-retro / retro-stub for EVERY target. Without this, a retro written by
# another session between our read and our `mv` is silently destroyed by the rebuild — the exact
# data loss this whole change exists to stop. Same dir-lock protocol as append-retro.
#
# It used to live inside the `*.log)` arm only, while the DEFAULT target is retros.md — so the
# markdown rebuild read the file, built a replacement, and swapped it in with no exclusion at all,
# and a concurrent `append-retro --md=` landing in that window was carried onto the renamed
# .pre-rotate backup and vanished from the live file. The header of this script claimed the lock
# was taken; for the path that runs by default, it was not.
# The lock, high-water and snapshots belong to the directory being rotated: append-retro keeps them
# beside the retros.log it writes, so a --target elsewhere must not use ZUVO_HOME's.
RLOCK="$ARCHIVE_DIR/.retro.lock.d"
HWF="$ARCHIVE_DIR/.retros-highwater"
SNAP_DIR="$ARCHIVE_DIR/retros-snapshots"
_rr_hw_rows() {
  _hv=$(sed -n 's/^rows=//p' "$HWF" 2>/dev/null | head -1)
  case "$_hv" in ''|*[!0-9]*) _hv=0 ;; esac
  printf '%s' "$_hv"
}
_rr_count() {
  _rc=$(grep -c '^RETRO:' "$1" 2>/dev/null) || _rc=0
  _rc=$(printf '%s' "$_rc" | tr -cd '0-9')
  printf '%s' "${_rc:-0}"
}
_rr_refuse() {
  echo "rotate-retros: REFUSED — $1; $TARGET NOT modified. Recover first: docs/runbook/operating.md §12" >&2
  exit 4
}
# gzip to a temp name, then rename: a failed gzip leaves no snapshot. An existing name is refused, so
# another writer's snapshot is never overwritten (every snapshot writer holds the retro lock we hold).
_rr_gz() {
  _gt="$2.tmp.$$"
  if gzip -c "$1" > "$_gt" 2>/dev/null && [ ! -e "$2" ] && mv "$_gt" "$2"; then return 0; fi
  rm -f "$_gt" 2>/dev/null; return 1
}
_rr_unsnap() {
  [ -n "$SNAP_OUT_LOG" ] && rm -f "$SNAP_OUT_LOG" 2>/dev/null
  [ -n "$SNAP_OUT_MD" ] && rm -f "$SNAP_OUT_MD" 2>/dev/null
  SNAP_OUT_LOG=""; SNAP_OUT_MD=""
}
# One stamp for the pair, named like append-retro's own snapshots, so its newest-first pick sees the
# post-rotation files and never unions archived entries back in. An empty source is skipped. All or
# nothing: on failure only the files this call created are removed, and it returns non-zero.
SNAP_OUT_LOG=""; SNAP_OUT_MD=""
_rr_snapshot() {
  SNAP_OUT_LOG=""; SNAP_OUT_MD=""
  mkdir -p "$SNAP_DIR" 2>/dev/null || return 1
  _st=$(date -u +%Y%m%dT%H%M%SZ)
  if [ -e "$SNAP_DIR/retros.log.$_st.gz" ] || [ -e "$SNAP_DIR/retros.md.$_st.gz" ]; then _st="$_st-$$"; fi
  if [ -n "$1" ]; then
    _rr_gz "$1" "$SNAP_DIR/retros.log.$_st.gz" || return 1
    SNAP_OUT_LOG="$SNAP_DIR/retros.log.$_st.gz"
  fi
  if [ -n "$2" ]; then
    _rr_gz "$2" "$SNAP_DIR/retros.md.$_st.gz" || { _rr_unsnap; return 1; }
    SNAP_OUT_MD="$SNAP_DIR/retros.md.$_st.gz"
  fi
  return 0
}
# Build the archive's next content in a temp file beside it (the old archive, or the header file for a
# new one, plus the rows file), leaving it at "$1.new.$$" for the caller to rename into place. The
# archive itself is never opened for writing, so a failure cannot leave a half-written record in it.
_rr_arch_stage() {
  _an="$1.new.$$"
  if [ -f "$1" ]; then
    cat "$1" > "$_an" 2>/dev/null || { rm -f "$_an" 2>/dev/null; return 1; }
  else
    cat "$2" > "$_an" 2>/dev/null || { rm -f "$_an" 2>/dev/null; return 1; }
  fi
  cat "$3" >> "$_an" 2>/dev/null || { rm -f "$_an" 2>/dev/null; return 1; }
  return 0
}
_rr_release() {
  [ "$(cat "$RLOCK/pid" 2>/dev/null || echo)" = "$$" ] || return 0
  rm -f "$RLOCK/pid" 2>/dev/null || true; rmdir "$RLOCK" 2>/dev/null || true
}
RWAIT="${ZUVO_LOCK_WAIT:-5}"; racq=0; rwaited=0
while :; do
  if mkdir "$RLOCK" 2>/dev/null; then
    if echo "$$" > "$RLOCK/pid" 2>/dev/null; then racq=1; break; fi
    rmdir "$RLOCK" 2>/dev/null || true
  fi
  if [ -d "$RLOCK" ]; then
    rlpid=$(cat "$RLOCK/pid" 2>/dev/null || echo "")
    rlmt=$(stat -c %Y "$RLOCK" 2>/dev/null || stat -f %m "$RLOCK" 2>/dev/null || echo "")
    rlmt=$(printf '%s' "$rlmt" | tr -cd '0-9')
    if [ -n "$rlpid" ]; then
      kill -0 "$rlpid" 2>/dev/null || { rm -f "$RLOCK/pid" 2>/dev/null || true; rmdir "$RLOCK" 2>/dev/null || true; }
    elif [ -n "$rlmt" ] && [ "$(( $(date +%s) - rlmt ))" -gt 30 ]; then
      rmdir "$RLOCK" 2>/dev/null || true
    fi
  fi
  rwaited=$((rwaited + 1)); [ "$rwaited" -ge "$((RWAIT * 5))" ] && break; sleep 0.2
done
[ "$racq" -eq 1 ] || { echo "rotate-retros: lock busy (ZUVO_LOCK_WAIT=${RWAIT}s) — nothing rotated; retry" >&2; exit 3; }
trap '_rr_release' INT TERM EXIT

case "$TARGET" in
  *.log)
    # Only a real comment line is a header. Treating line 1 as a header unconditionally
    # duplicated the first entry when the file had none: it was copied into the archive AND
    # kept by the rebuild's `NR==1 {print}` (measured: 3 entries became 4). Also stops a
    # telemetry row from being written as an archive "header".
    HDR=$(head -1 "$TARGET")
    case "$HDR" in \#*) HAS_HDR=1 ;; *) HAS_HDR=0; HDR='# v2 DATE\tSKILL\tPROJECT' ;; esac
    TOTAL=$(grep -c '^RETRO:' "$TARGET" 2>/dev/null | head -1); TOTAL=${TOTAL:-0}
    # `d != ""` is load-bearing. A RETRO line whose date field is empty/missing yields d="",
    # and in awk's string comparison "" < "2026-04-23" is TRUE — so the archive pass claimed it
    # while the keep pass (which tests d=="" explicitly) also kept it: the entry landed in BOTH
    # files. Measured: 3 entries became 5. Undated lines are KEPT, never archived.
    OLD=$(awk -F'\t' -v c="$CUTOFF_DATE" '/^RETRO:/ { split($1,a," "); d=substr(a[2],1,10); if (d != "" && d < c) n++ } END{print n+0}' "$TARGET")
    echo "rotate-retros: retros.log — $TOTAL entries, $OLD older than $DAYS days"
    [ "$OLD" -eq 0 ] && { echo "rotate-retros: nothing to archive — done"; exit 0; }
    # group the old ones per quarter so archives match the markdown naming scheme
    QS=$(awk -F'\t' -v c="$CUTOFF_DATE" '/^RETRO:/ { split($1,a," "); d=substr(a[2],1,10);
           if (d != "" && d < c) { y=substr(d,1,4); m=substr(d,6,2)+0; printf "%s-Q%d\n", y, int((m-1)/3)+1 } }' "$TARGET" | sort -u)
    for q in $QS; do
      n=$(awk -F'\t' -v c="$CUTOFF_DATE" -v q="$q" '/^RETRO:/ { split($1,a," "); d=substr(a[2],1,10);
            if (d != "" && d < c) { y=substr(d,1,4); m=substr(d,6,2)+0; k=sprintf("%s-Q%d",y,int((m-1)/3)+1); if (k==q) n++ } } END{print n+0}' "$TARGET")
      echo "  $ARCHIVE_DIR/retros-archive-${q}.log  ← $n entries"
    done
    # The high-water counts retros.log only; another .log beside it is not what it describes.
    HW_GUARD=0; [ "$(basename "$TARGET")" = retros.log ] && HW_GUARD=1
    HW=$(_rr_hw_rows)
    if [ "$HW_GUARD" -eq 1 ] && [ "$TOTAL" -lt "$HW" ]; then
      WHY="retros.log holds $TOTAL RETRO rows, below the high-water of $HW in $HWF"
      [ "$APPLY" -eq 1 ] || { echo "rotate-retros: would refuse: $WHY — --apply exits 4; see docs/runbook/operating.md §12"; exit 0; }
      _rr_refuse "$WHY"
    fi
    if [ "$APPLY" -eq 0 ]; then
      echo "rotate-retros: dry-run — re-run with --apply to commit changes"; exit 0
    fi
    T="$TARGET.tmp.$$.$(date +%s)"
    # keep: the header, every non-RETRO line, and every RETRO line NOT older than the cutoff
    awk -F'\t' -v c="$CUTOFF_DATE" -v hh="$HAS_HDR" 'NR==1 && hh==1 { print; next }
      !/^RETRO:/ { print; next }
      { split($1,a," "); d=substr(a[2],1,10); if (d=="" || d >= c) print }' "$TARGET" > "$T"
    KEPT=$(grep -c '^RETRO:' "$T" 2>/dev/null | head -1); KEPT=${KEPT:-0}
    # refuse to shrink to nothing on a parse failure — data loss is the thing this prevents.
    # NOTE: KEPT is piped through `head -1`, never `grep -c ... || echo 0`: grep -c PRINTS 0 and
    # ALSO exits 1 on zero matches, so the `||` appended a second zero and KEPT became the
    # two-line string "0\n0". `[ "0\n0" -eq 0 ]` errors out and the guard silently never fired —
    # exactly at the only moment it is load-bearing. Found by cross-model adversarial review.
    if [ "$KEPT" -eq 0 ] && [ "$TOTAL" -gt "$OLD" ]; then
      rm -f "$T"; echo "rotate-retros: ABORT — rebuild kept 0 of $TOTAL entries (parse failure); $TARGET untouched" >&2; exit 1
    fi
    if [ "$HW_GUARD" -eq 1 ] && [ "$((KEPT + OLD))" -lt "$HW" ]; then
      rm -f "$T"; _rr_refuse "the rebuild lost rows: it keeps $KEPT and archives $OLD of $TOTAL RETRO rows, below the high-water of $HW in $HWF"
    fi
    # Guarded order: snapshot, high-water, archives, swap. An abort restores the high-water, removes
    # the snapshot this run created and leaves the live log as it was. Each archive is replaced whole
    # by a rename, so a failed update leaves the old archive intact; an archive already replaced keeps
    # its rows while the live log still holds them, and the rerun skips rows an archive already has.
    HW_PREV="$HWF.prev.$$"; HW_HAD=0; HW_SET=0
    _rr_undo() {
      if [ "$HW_HAD" -eq 1 ]; then mv -f "$HW_PREV" "$HWF" 2>/dev/null
      elif [ "$HW_SET" -eq 1 ]; then rm -f "$HWF" 2>/dev/null; fi
      _rr_unsnap; rm -f "$T" "$HWF.tmp.$$" 2>/dev/null
      echo "rotate-retros: ABORT — $1; $TARGET untouched" >&2; exit 1
    }
    if [ "$HW_GUARD" -eq 1 ]; then
      _rr_snapshot "$T" "" || _rr_undo "could not snapshot the rotated log into $SNAP_DIR"
      if [ -f "$HWF" ]; then cp -p "$HWF" "$HW_PREV" 2>/dev/null || _rr_undo "could not back up $HWF"; HW_HAD=1; fi
      { printf 'rows=%s\nbytes=%s\nat=%s\n' "$KEPT" "$(wc -c < "$T" | tr -d ' ')" \
          "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$HWF.tmp.$$" && mv "$HWF.tmp.$$" "$HWF"; } 2>/dev/null \
        || _rr_undo "could not lower the high-water in $HWF"
      HW_SET=1
    fi
    # Archive update is DEDUPED against what the archive already holds. The archive is written
    # before the source is replaced, so a crash between the two steps leaves entries in both
    # files; the next run would then add them to the archive a second time. Skipping lines
    # already present makes that recovery path idempotent instead of duplicating.
    for q in $QS; do
      AF="$ARCHIVE_DIR/retros-archive-${q}.log"
      QT="$AF.qt.$$"; QN="$AF.add.$$"; QH="$AF.hdr.$$"
      _rr_qclean() { rm -f "$QT" "$QN" "$QH" "$AF.new.$$" 2>/dev/null; }
      awk -F'\t' -v c="$CUTOFF_DATE" -v q="$q" '/^RETRO:/ { split($1,a," "); d=substr(a[2],1,10);
        if (d != "" && d < c) { y=substr(d,1,4); m=substr(d,6,2)+0; k=sprintf("%s-Q%d",y,int((m-1)/3)+1); if (k==q) print } }' "$TARGET" > "$QT" \
        || { _rr_qclean; _rr_undo "could not stage the $q archive rows"; }
      printf '%b\n' "$HDR" > "$QH" || { _rr_qclean; _rr_undo "could not stage the $q archive header"; }
      # A swallowed write error here would cut rows from the live log that never reached the
      # archive. grep exit 1 = nothing new.
      grc=0
      if [ -f "$AF" ]; then grep -F -x -v -f "$AF" "$QT" > "$QN" 2>/dev/null || grc=$?
      else cp "$QT" "$QN" || grc=2; fi
      if [ "$grc" -gt 1 ] || ! _rr_arch_stage "$AF" "$QH" "$QN" || ! mv "$AF.new.$$" "$AF"; then
        _rr_qclean; _rr_undo "could not append the $q rows to $AF"
      fi
      _rr_qclean
    done
    zuvo_ao_lift "$TARGET"
    if ! mv "$T" "$TARGET"; then
      zuvo_ao_arm "$TARGET"; _rr_undo "could not replace $TARGET"
    fi
    zuvo_ao_arm "$TARGET"
    rm -f "$HW_PREV" 2>/dev/null
    echo "rotate-retros: archived $OLD, kept $KEPT in $TARGET"
    exit 0 ;;
esac

# ── extract entries with metadata: [start_line, end_line, parsed_date, quarter_key]
# Two-pass awk: pass 1 finds entry boundaries; pass 2 dates them.
# Output one line per entry: START\tEND\tDATE_OR_BLANK\tQUARTER_OR_BLANK
ENTRIES_TSV=$(awk '
  BEGIN { in_entry=0; start=0 }
  /^<!-- RETRO -->/ {
    if (in_entry) { print start "\t" (NR-1) "\tPENDING\tPENDING" }
    in_entry=1; start=NR; next
  }
  END {
    if (in_entry) { print start "\t" NR "\tPENDING\tPENDING" }
  }
' "$TARGET")

if [ -z "$ENTRIES_TSV" ]; then
  echo "rotate-retros: no <!-- RETRO --> markers found in $TARGET — nothing to rotate"
  exit 0
fi

# Resolve each entry's date by scanning its lines for the first ISO date
RESOLVED=$(while IFS=$'\t' read -r start end _ _; do
  date_iso=$(sed -n "${start},${end}p" "$TARGET" \
    | grep -oE '20[0-9]{2}-[0-9]{2}-[0-9]{2}' \
    | head -1)
  if [ -n "$date_iso" ]; then
    month=$(echo "$date_iso" | cut -d- -f2)
    year=$(echo "$date_iso" | cut -d- -f1)
    quarter=$(( (10#$month - 1) / 3 + 1 ))
    qkey="${year}-Q${quarter}"
  else
    date_iso=""
    qkey=""
  fi
  echo "$start	$end	$date_iso	$qkey"
done <<< "$ENTRIES_TSV")

# Classify: archive if date < cutoff AND date != ""
TO_ARCHIVE=$(echo "$RESOLVED" | awk -F'\t' -v cutoff="$CUTOFF_DATE" '$3!="" && $3 < cutoff')
TO_KEEP=$(echo "$RESOLVED" | awk -F'\t' -v cutoff="$CUTOFF_DATE" '$3=="" || $3 >= cutoff')

ARCHIVE_COUNT=$(echo "$TO_ARCHIVE" | grep -c '^' 2>/dev/null | head -1); ARCHIVE_COUNT=${ARCHIVE_COUNT:-0}
KEEP_COUNT=$(echo "$TO_KEEP" | grep -c '^' 2>/dev/null | head -1); KEEP_COUNT=${KEEP_COUNT:-0}
[ -z "$TO_ARCHIVE" ] && ARCHIVE_COUNT=0
[ -z "$TO_KEEP" ] && KEEP_COUNT=0

echo "rotate-retros: classified entries — archive=$ARCHIVE_COUNT keep=$KEEP_COUNT (undated entries default to keep)"

if [ "$ARCHIVE_COUNT" -eq 0 ]; then
  echo "rotate-retros: no entries older than $DAYS days — done"
  exit 0
fi

# Per-quarter archive plan
QUARTERS=$(echo "$TO_ARCHIVE" | awk -F'\t' '{print $4}' | sort -u)
echo "rotate-retros: target archive files:"
for q in $QUARTERS; do
  c=$(echo "$TO_ARCHIVE" | awk -F'\t' -v q="$q" '$4==q' | wc -l | tr -d ' ')
  echo "  $ARCHIVE_DIR/retros-archive-${q}.md  ← $c entries"
done

if [ "$APPLY" -eq 0 ]; then
  echo "rotate-retros: dry-run — re-run with --apply to commit changes"
  exit 0
fi

# Rebuild retros.md keeping only TO_KEEP entries (in original order), preserving
# the file's preamble (everything BEFORE the first <!-- RETRO --> marker).
TMP="$TARGET.rotate.tmp.$$"

# Preamble = lines 1..(first marker -1)
FIRST_MARKER=$(grep -n '^<!-- RETRO -->' "$TARGET" | head -1 | cut -d: -f1)
if [ "$FIRST_MARKER" -gt 1 ]; then
  sed -n "1,$((FIRST_MARKER - 1))p" "$TARGET" > "$TMP"
else
  : > "$TMP"
fi

# Append kept entries in original order
echo "$TO_KEEP" | sort -n -k1 -t$'\t' | while IFS=$'\t' read -r start end _ _; do
  sed -n "${start},${end}p" "$TARGET" >> "$TMP"
  echo "" >> "$TMP"
done

# Any failure from here on removes this run's snapshots and temp files and leaves retros.md as it was.
PRE="$TARGET.pre-rotate.$$"
_rr_md_undo() {
  for _q in $QUARTERS; do rm -f "$ARCHIVE_DIR/retros-archive-${_q}.md".{new,add,hdr}."$$" 2>/dev/null; done
  _rr_unsnap; rm -f "$TMP" 2>/dev/null
  echo "rotate-retros: ABORT — $1; $TARGET untouched" >&2; exit 1
}

# Re-snapshot the rotated markdown so append-retro's markdown recovery cannot restore archived
# entries. The log rides along only at or above its high-water: a short log is never the newest copy.
# Taken before any archive write.
if [ "$(basename "$TARGET")" = retros.md ]; then
  SIB_LOG="$ARCHIVE_DIR/retros.log"; SNAP_LOG=""
  if [ -f "$SIB_LOG" ] && [ "$(_rr_count "$SIB_LOG")" -ge "$(_rr_hw_rows)" ]; then SNAP_LOG="$SIB_LOG"; fi
  _rr_snapshot "$SNAP_LOG" "$TMP" || _rr_md_undo "could not snapshot the rotated retros.md into $SNAP_DIR"
fi

# ── apply: per quarter, stage the archive's next content (header if new), then rename every staged
# archive into place. Staging all of them first means a failed write touches no archive.
TS_RUN=$(date -u +%Y-%m-%dT%H:%M:%SZ)
_rr_md_rows() {
  while IFS=$'\t' read -r start end _ _; do
    sed -n "${start},${end}p" "$TARGET" || return 1
    echo ""
  done <<< "$(echo "$TO_ARCHIVE" | awk -F'\t' -v q="$1" '$4==q')"
}
for q in $QUARTERS; do
  AF="$ARCHIVE_DIR/retros-archive-${q}.md"
  {
    echo "# Retros archive — $q"
    echo ""
    echo "Entries rotated out of \`~/.zuvo/retros.md\` by \`rotate-retros\` on $TS_RUN."
    echo "Threshold at rotation: --days $DAYS (cutoff=$CUTOFF_DATE)."
    echo ""
  } > "$AF.hdr.$$" || _rr_md_undo "could not stage the $q archive header"
  {
    # Re-runs append more entries behind a separator.
    if [ -f "$AF" ]; then
      echo ""
      echo "<!-- rotated $TS_RUN (--days $DAYS) -->"
      echo ""
    fi
    _rr_md_rows "$q"
  } > "$AF.add.$$" || _rr_md_undo "could not stage the $q archive rows"
  _rr_arch_stage "$AF" "$AF.hdr.$$" "$AF.add.$$" || _rr_md_undo "could not stage the $q archive $AF"
done
for q in $QUARTERS; do
  AF="$ARCHIVE_DIR/retros-archive-${q}.md"
  mv "$AF.new.$$" "$AF" || _rr_md_undo "could not write the $q archive $AF"
done
for q in $QUARTERS; do rm -f "$ARCHIVE_DIR/retros-archive-${q}.md".{add,hdr}."$$" 2>/dev/null; done

# Atomic swap. The flag blocks renaming the protected file itself, not just writing to it, so it
# comes off before BOTH moves and goes back on the file that ends up in place.
zuvo_ao_lift "$TARGET"
if ! mv "$TARGET" "$PRE"; then zuvo_ao_arm "$TARGET"; _rr_md_undo "could not move $TARGET aside"; fi
if ! mv "$TMP" "$TARGET"; then
  mv "$PRE" "$TARGET" 2>/dev/null; zuvo_ao_arm "$TARGET"; _rr_md_undo "could not replace $TARGET"
