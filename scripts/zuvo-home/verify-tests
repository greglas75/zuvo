#!/bin/sh
# Polyglot sh/python header — see compute-preload for why this exact line matters on Windows.
''''exec "$(command -v python3 || command -v python || echo python3)" "$0" "$@" # '''
"""
~/.zuvo/verify-tests — run EVERY write-tests verification in one process, print ONE verdict.

Usage:
  ~/.zuvo/verify-tests --manifest zuvo/contracts/<basename>.coverage.json
  ~/.zuvo/verify-tests --manifest <m> --skip mutation
  ~/.zuvo/verify-tests --manifest <m> --budget 3 --json

Why it exists. Measured 2026-08-21 across 28 runs writing tests for ONE file: the number of
conversational turns tracks one variable almost perfectly — how many times the run re-issued a
verification command it had already issued. Runs with zero repeats finished in 30-111 turns.
Runs with 9-14 repeats took 193-321. Runs with 28-30 repeats took 395-485. The commands being
repeated were always the same four: the coverage gate (up to 9x), the scoped test run (up to
8x), the production-file restore (up to 5x), the sha256 check (up to 3x).

That is not the agent being careless. write-tests asks for four SEPARATE verification passes —
Step 2.5 gate, Step 3 quality, Step 3.2 coverage, Step 3.3 mutation — and each one says "fix
and rerun". Four independent fix-and-rerun loops over the same suite is four chances to re-issue
the same command, and every re-issue re-bills the whole accumulated context.

Prose cannot close that. v7 added an explicit "run it ONCE, do not iterate" to Step 2.5 and a run
still called the gate five times. A skill that tells an agent HOW MANY TIMES to verify still
leaves the agent deciding when it is done, and deciding costs turns. The precedent is
`load-includes`: two rewordings of the loading block made runs longer, and replacing the block
with a command made them shorter.

So this is a command. One invocation runs the suite, the coverage gate, scoped coverage and the
native mutation runner, restores production, verifies the hash, clears the runner's debris, and
prints a single block listing every gap that is still open. The agent reads it, makes ONE fix
round, and calls this again. Subprocesses are free; turns are not.

It also carries its own budget. Each invocation increments a counter beside the manifest, and
the block prints `pass N of B`. On the last pass with gaps still open, exit is 4 and the block
says to record what remains rather than keep going — a stop condition the program owns, so
"am I done yet" stops being a judgement call made under a growing context.

Exit codes:
  0  every applicable check green
  1  gaps remain and budget is left — fix them and call again
  2  infrastructure error (manifest unreadable, no runner, production hash drift)
  4  budget exhausted with gaps open — record them, do not iterate further
"""
import argparse
import contextlib
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor

SCHEMA = "zuvo-verify/v1"
DEFAULT_BUDGET = 3
DEFAULT_TIME_BUDGET_MIN = 15

COVERAGE_THRESHOLDS = {"statements": 85.0, "branches": 75.0, "functions": 90.0, "lines": 85.0}

# Runner debris that a native mutation run leaves behind. Cleared after every invocation:
# a leftover .stryker-tmp is both a multi-GB disk leak and a git-status false positive that
# the next check would report as an unexpected working-tree change.
DEBRIS = (".stryker-tmp", "mutants.out", ".mutmut-cache", "reports/mutation", ".pytest_cache")


# --------------------------------------------------------------------------- helpers


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def run(cmd, cwd=None, timeout=900, env=None):
    """Run a command, never raise. Returns (rc, combined_output)."""
    e = dict(os.environ)
    if env:
        e.update(env)
    try:
        p = subprocess.run(
            cmd,
            cwd=cwd,
            env=e,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
        return p.returncode, strip_ansi(p.stdout.decode("utf-8", "replace"))
    except subprocess.TimeoutExpired as exc:
        out = strip_ansi((exc.stdout or b"").decode("utf-8", "replace"))
        return 124, out + "\n[verify-tests] TIMEOUT after %ds\n" % timeout
    except FileNotFoundError as exc:
        return 127, "[verify-tests] not found: %s\n" % exc
    except Exception as exc:  # pragma: no cover - defensive
        return 126, "[verify-tests] %s\n" % exc


# Runner output is coloured even when not a TTY (vitest, stryker). Left in, the escapes break
# every anchored regex below — "^\\s*Tests" never matches a line that really starts with an SGR
# sequence, and the looser fallback then reads "Test Files 1 passed" as a one-test suite.
ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def strip_ansi(text):
    return ANSI.sub("", text)


def tail(text, n=25):
    lines = [l for l in text.splitlines() if l.strip()]
    return "\n".join(lines[-n:])


def git_root(start):
    rc, out = run(["git", "rev-parse", "--show-toplevel"], cwd=start)
    if rc == 0 and out.strip():
        return out.strip().splitlines()[-1]
    return os.path.abspath(start)


def zuvo_base():
    env = os.environ.get("ZUVO_BASE")
    if env and os.path.isfile(os.path.join(env, "scripts", "test-coverage-gate.py")):
        return env
    here = os.path.dirname(os.path.realpath(__file__))
    for cand in (
        os.path.join(here, ".."),  # repo: scripts/zuvo-home -> scripts/.. is repo root
        os.path.join(here, "..", ".."),
        os.path.expanduser("~/.zuvo-plugin"),
        os.path.expanduser("~/.claude"),
    ):
        if os.path.isfile(os.path.join(cand, "scripts", "test-coverage-gate.py")):
            return os.path.abspath(cand)
    return None


# --------------------------------------------------------------------------- runner detection


def read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return None


def nearest_package(start_file, root):
    """Walk up from a file to the nearest package.json, stopping at the repo root.

    Monorepos are the normal case, not the exception: the vitest/jest install that can run a
    spec usually lives in the workspace package (apps/api), not at the root. Running from the
    root instead produces a config-not-found failure that looks like a broken suite.
    """
    d = os.path.dirname(os.path.abspath(start_file))
    root = os.path.abspath(root)
    while True:
        pj = os.path.join(d, "package.json")
        if os.path.isfile(pj):
            data = read_json(pj) or {}
            deps = {}
            deps.update(data.get("dependencies") or {})
            deps.update(data.get("devDependencies") or {})
            scripts = data.get("scripts") or {}
            if "vitest" in deps or "jest" in deps or "test" in scripts:
                return d, data
        if d == root or os.path.dirname(d) == d:
            return None, None
        d = os.path.dirname(d)


def detect_runner(stack, test_files, root):
    """Return a dict describing how to run this suite, or an error string."""
    if stack in ("ts", "js", "tsx", "jsx", None, ""):
        pkgdir, pkg = nearest_package(test_files[0], root)
        if pkgdir is None:
            # Root package.json without a test script still beats nothing.
            pkg = read_json(os.path.join(root, "package.json"))
            if pkg is None:
                return {"error": "no package.json above %s" % test_files[0]}
            pkgdir = root
        deps = {}
        deps.update(pkg.get("dependencies") or {})
        deps.update(pkg.get("devDependencies") or {})
        if "vitest" in deps:
            return {"kind": "vitest", "cwd": pkgdir}
        if "jest" in deps:
            return {"kind": "jest", "cwd": pkgdir}
        # A workspace package can rely on a hoisted runner; look for the binary.
        for cand in ("vitest", "jest"):
            if os.path.exists(os.path.join(root, "node_modules", ".bin", cand)):
                return {"kind": cand, "cwd": pkgdir}
        return {"error": "no vitest/jest in %s" % os.path.relpath(pkgdir, root)}
    if stack == "python":
        return {"kind": "pytest", "cwd": root}
    if stack == "php":
        return {"kind": "phpunit", "cwd": root}
    return {"error": "unsupported stack %r" % stack}


def rel_to(path, base):
    return os.path.relpath(os.path.abspath(path), os.path.abspath(base))


# --------------------------------------------------------------------------- checks


class Result(object):
    def __init__(self, name):
        self.name = name
        self.status = "SKIP"
        self.detail = ""
        self.gaps = []
        self.evidence = ""
        self.seconds = 0.0

    def to_dict(self):
        return {
            "check": self.name,
            "status": self.status,
            "detail": self.detail,
            "gaps": self.gaps,
            "seconds": round(self.seconds, 1),
        }


def check_suite(runner, test_files, root):
    """The suite must be green on UNMUTATED source. Everything downstream assumes it."""
    r = Result("suite")
    t0 = time.time()
    cwd = runner["cwd"]
    specs = [rel_to(f, cwd) for f in test_files]
    if runner["kind"] == "vitest":
        cmd = ["npx", "vitest", "run"] + specs
    elif runner["kind"] == "jest":
        cmd = ["npx", "jest", "--runTestsByPath"] + specs
    elif runner["kind"] == "pytest":
        cmd = [sys.executable, "-m", "pytest", "-q"] + specs
    else:
        cmd = ["./vendor/bin/phpunit"] + specs
    rc, out = run(cmd, cwd=cwd)
    r.seconds = time.time() - t0
    r.evidence = tail(out, 30)
    if rc == 0:
        # Every runner prints several "N passed" lines and the FIRST one is the file count, so
        # a loose match reports a 50-test suite as 1 test. Anchor on the Tests line, and read
        # jest's "Tests: 35 skipped, 15 passed, 50 total" shape where `passed` is not the first
        # field. Skips are surfaced too: a suite that is 70% skipped is not the suite the rest
        # of this block is measuring, and silently calling it green hides that.
        m = (re.search(r"^\s*Tests\s+(\d+)\s+passed", out, re.M)
             or re.search(r"^Tests:.*?(\d+)\s+passed", out, re.M)
             or re.search(r"(\d+)\s+passed", out))
        skipped = re.search(r"^Tests:.*?(\d+)\s+(?:skipped|todo)", out, re.M) \
            or re.search(r"^\s*Tests\s+.*?(\d+)\s+skipped", out, re.M)
        r.status = "PASS"
        r.detail = "%s tests passed" % (m.group(1) if m else "all")
        if skipped and int(skipped.group(1)) > 0:
            r.detail += " (%s SKIPPED — those behaviours are unverified)" % skipped.group(1)
            r.gaps.append(
                "%s of the declared tests are skipped; coverage and mutation below describe "
                "only the ones that ran" % skipped.group(1)
            )
    else:
        r.status = "FAIL"
        r.detail = "runner exit %d" % rc
        # A failing assertion names the test; hand the agent the names, not the whole log.
        for line in out.splitlines():
            s = line.strip()
            if (re.match(r"^(FAIL|×|✕|●|E\s)", s) or "AssertionError" in s) and s not in r.gaps:
                r.gaps.append(s[:200])
        if not r.gaps:
            r.gaps.append("suite exited %d — see evidence block" % rc)
        # Named at the point of failure, because a red suite is where a run is most likely to
        # stop. It scores ZERO on any mutation measurement — worse than never having written the
        # test — so finding a real production bug and leaving the suite red is a net loss. There
        # are exactly two legal exits.
        r.gaps.append(
            "a red suite scores 0 and is a terminal state: either FIX the production defect "
            "in-run (Step 4.5) or assert the ACTUAL behaviour and backlog the defect with "
            "file:line. Finishing the file red is neither."
        )
    return r


def check_gate(manifest_path, root, base):
    r = Result("coverage-gate")
    t0 = time.time()
    if base is None:
        r.status = "ERROR"
        r.detail = ("cannot locate scripts/test-coverage-gate.py (ZUVO_BASE=%r) — "
                    "set ZUVO_BASE to the zuvo install root"
                    % os.environ.get("ZUVO_BASE", ""))
        return r
    cmd = [
        sys.executable,
        os.path.join(base, "scripts", "test-coverage-gate.py"),
        "validate",
        "--manifest",
        manifest_path,
        "--phase",
        "final",
        "--repo-root",
        root,
    ]
    rc, out = run(cmd, cwd=root, timeout=300)
    r.seconds = time.time() - t0
    r.evidence = out.strip()
    if rc == 0:
        r.status = "PASS"
        m = re.search(r"Public entry points:\s*(\S+)", out)
        r.detail = m.group(1) if m else "validated"
    elif rc == 3:
        r.status = "DEGRADED"
        r.detail = "textual extraction — evidence quality BLOCKED_DEGRADED"
    else:
        r.status = "FAIL"
        r.detail = "validator exit %d" % rc
        # The validator already names each violation on its own FAIL:/ERROR: line. Scraping
        # anything looser (a tail, a prefix guess) folds its summary counters into the gap
        # list, and a gap list with "Uncovered owned rows: 0" in it reads as a contradiction.
        for line in out.splitlines():
            t = line.strip()
            if re.match(r"^(FAIL|ERROR|VIOLATION)\b", t):
                r.gaps.append(t[:200])
        if not r.gaps:
            for line in out.splitlines():
                t = line.strip()
                if t.lower().startswith("missing symbols:"):
                    r.gaps.append(t[:200])
        if not r.gaps:
            r.gaps.append("validator exit %d — see EVIDENCE block" % rc)
    return r


def check_coverage(runner, prod_file, test_files, root):
    r = Result("coverage")
    t0 = time.time()
    cwd = runner["cwd"]
    if runner["kind"] not in ("vitest", "jest"):
        r.status = "SKIP"
        r.detail = "%s coverage not wired in this helper — run it by hand if needed" % runner["kind"]
        return r
    outdir = tempfile.mkdtemp(prefix="zuvo-cov-")
    specs = [rel_to(f, cwd) for f in test_files]
    prod_rel = rel_to(prod_file, cwd)
    try:
        if runner["kind"] == "vitest":
            cmd = (
                ["npx", "vitest", "run"]
                + specs
                + [
                    "--coverage",
                    "--coverage.provider=v8",
                    "--coverage.reporter=json-summary",
                    "--coverage.reportsDirectory=" + outdir,
                    "--coverage.include=" + prod_rel,
                    "--coverage.all=false",
                ]
            )
        else:
            # jest resolves collectCoverageFrom against rootDir (commonly `src` in Nest
            # projects), not against cwd — a cwd-relative path silently matches nothing and
            # every metric comes back as the literal string "Unknown". A `**/`-prefixed glob
            # is rootDir-independent; the exact file is then picked out of the summary by
            # absolute path below, so the wider glob cannot smuggle another file's numbers in.
            cmd = [
                "npx",
                "jest",
                "--runTestsByPath",
            ] + specs + [
                "--coverage",
                "--coverageReporters=json-summary",
                "--coverageDirectory=" + outdir,
                "--collectCoverageFrom=**/" + os.path.basename(prod_rel),
            ]
        rc, out = run(cmd, cwd=cwd)
        summary = read_json(os.path.join(outdir, "coverage-summary.json"))
        if summary is None:
            r.status = "SKIP"
            r.detail = "runner produced no coverage-summary.json (exit %d)" % rc
            r.evidence = tail(out, 12)
            return r
        # The per-file entry is keyed by absolute path; total is the safe aggregate when the
        # include filter has already narrowed to one file.
        entry = None
        for k, v in summary.items():
            if k == "total":
                continue
            if os.path.abspath(k) == os.path.abspath(prod_file):
                entry = v
                break
        if entry is None:
            files = [k for k in summary if k != "total"]
            if len(files) == 1:
                entry = summary[files[0]]
            elif files:
                # `total` aggregates every file the reporter saw. Reporting it as this file's
                # coverage would be a number about the wrong thing, so say so instead.
                r.status = "SKIP"
                r.detail = ("no entry for %s; summary covers %d files — coverage not attributable"
                            % (prod_rel, len(files)))
                return r
            else:
                entry = summary.get("total")
        if not entry:
            r.status = "SKIP"
            r.detail = "no coverage entry for %s" % prod_rel
            return r
        nums, failed, unknown = [], [], []
        for key, floor in COVERAGE_THRESHOLDS.items():
            raw = (entry.get(key) or {}).get("pct")
            try:
                pct = float(raw)
            except (TypeError, ValueError):
                # jest writes the literal string "Unknown" when it collected no data for a
                # metric. Scoring that as 0% would report a false shortfall and send the agent
                # chasing coverage that was never measured; the honest result is "not measured".
                unknown.append("%s=%r" % (key, raw))
                nums.append("%s ?" % key)
                continue
            nums.append("%s %.1f%%" % (key, pct))
            if pct < floor:
                failed.append("%s %.1f%% < %.0f%%" % (key, pct, floor))
        if unknown and not failed:
            r.status = "SKIP"
            r.detail = "not measured (%s) — %s" % (", ".join(unknown), "  ".join(nums))
            return r
        r.detail = "  ".join(nums)
        if failed:
            r.status = "FAIL"
            r.gaps = failed
            unc = (entry.get("lines") or {}).get("uncoveredLines")
            if unc:
                r.gaps.append("uncovered lines: %s" % unc)
        else:
            r.status = "PASS"
        return r
    finally:
        shutil.rmtree(outdir, ignore_errors=True)
        r.seconds = time.time() - t0


def nearest_tsconfig(start_file, root):
    """The tsconfig that OWNS this file — the workspace project, not the monorepo root.

    A root-level typecheck on a monorepo compiles every package to say something about one
    file, and on this rig that measured 74-250 seconds per invocation. The project tsconfig
    beside the file is the smallest unit that still carries the paths, decorators and lib
    settings the file actually compiles under.
    """
    d = os.path.dirname(os.path.abspath(start_file))
    root = os.path.abspath(root)
    while True:
        for name in ("tsconfig.json", "tsconfig.app.json", "tsconfig.build.json"):
            p = os.path.join(d, name)
            if os.path.isfile(p):
                return p
        if d == root or os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)


TS_DIAG = re.compile(r"^(?P<file>[^(]+)\((?P<line>\d+),\d+\):\s+error\s+(?P<code>TS\d+):\s*(?P<msg>.*)$")


def check_typecheck(runner, prod_file, test_files, root, manifest_path):
    """Type errors IN THE FILES UNDER TEST. Everything else is somebody else's debt.

    Two measurements drove this. First, `typecheck` was the largest wall-clock bucket in every
    arm on the rig including the no-skill control — 122s median there, 247s in the heaviest arm,
    722s at the worst — because agents reach for a project-wide `tsc --noEmit` on their own.
    Second, the project under test carries 6050 pre-existing type errors, so that spend buys a
    wall of diagnostics the run did not cause and cannot act on.

    So: one incremental run per invocation against the OWNING project, with the build-info file
    kept beside the manifest so the second pass is warm (measured 57s cold, 16s warm), and only
    diagnostics whose file is the production file or one of its specs become gaps. The
    pre-existing count is reported as context so nobody mistakes silence for a clean project.
    """
    r = Result("typecheck")
    t0 = time.time()
    if runner["kind"] not in ("vitest", "jest"):
        r.status = "SKIP"
        r.detail = "not wired for %s" % runner["kind"]
        return r
    tscfg = nearest_tsconfig(prod_file, root)
    if tscfg is None:
        r.status = "SKIP"
        r.detail = "no tsconfig owning %s" % rel_to(prod_file, root)
        return r
    cwd = os.path.dirname(tscfg)
    if not os.path.exists(os.path.join(cwd, "node_modules", ".bin", "tsc")) and not os.path.exists(
        os.path.join(root, "node_modules", ".bin", "tsc")
    ):
        r.status = "SKIP"
        r.detail = "no typescript installed"
        return r
    buildinfo = manifest_path + ".tsbuildinfo"
    rc, out = run(
        ["npx", "tsc", "--noEmit", "-p", os.path.basename(tscfg),
         "--incremental", "--tsBuildInfoFile", buildinfo],
        cwd=cwd,
        timeout=1200,
    )
    r.seconds = time.time() - t0
    if rc == 124:
        r.status = "ERROR"
        r.detail = "error: tsc timed out"
        return r
    specs = {os.path.abspath(f) for f in test_files}
    prod_abs = os.path.abspath(prod_file)
    mine, in_prod, total = [], [], 0
    for line in out.splitlines():
        m = TS_DIAG.match(line.strip())
        if not m:
            continue
        total += 1
        path = os.path.abspath(os.path.join(cwd, m.group("file")))
        entry = "%s:%s %s: %s" % (rel_to(path, root), m.group("line"), m.group("code"),
                                  m.group("msg")[:120])
        if path in specs:
            mine.append(entry)
        elif path == prod_abs:
            in_prod.append(entry)
    # Only the SPEC files are this run's output. An error in the production file is debt the run
    # inherited, and blocking on it would make write-tests refuse to finish for a defect outside
    # its fence — while dropping it silently would hide a file the new tests may not compile
    # against. So it is reported, and backlogged, but it is not a gap.
    pre = total - len(mine) - len(in_prod)
    ctx = []
    if in_prod:
        ctx.append("%d pre-existing in the production file" % len(in_prod))
    if pre:
        ctx.append("%d elsewhere" % pre)
    suffix = " (%s — not this run's)" % ", ".join(ctx) if ctx else ""
    if mine:
        r.status = "FAIL"
        r.detail = "%d error(s) in the written spec%s" % (len(mine), suffix)
        r.gaps.extend(mine[:10])
        if len(mine) > 10:
            r.gaps.append("... %d more type errors in the written spec" % (len(mine) - 10))
    else:
        r.status = "PASS"
        r.detail = "0 errors in the written spec" + suffix
    if in_prod:
        r.evidence = ("Pre-existing type errors in the production file — backlog these, they do "
                      "not block this run:\n" + "\n".join(in_prod[:8]))
    return r


def node_root_with(pkg, runner, root):
    """Directory whose node_modules holds `pkg`, preferring the workspace package."""
    for d in (runner["cwd"], root):
        if os.path.isdir(os.path.join(d, "node_modules", *pkg.split("/"))):
            return d
    return None


def ensure_stryker(runner, root, allow_install):
    """Return (node_root, note) or (None, reason).

    Stryker is TWO packages: the core and the test-runner plugin for THIS runner. A project with
    only the core (a leftover from a one-off run, a hoisted transitive) cannot execute anything,
    so both are required before this reports a runner as available.
    """
    plugin = "@stryker-mutator/%s-runner" % runner["kind"]
    core = node_root_with("@stryker-mutator/core", runner, root)
    plug = node_root_with(plugin, runner, root)
    if core and plug:
        return core, "project"
    if not allow_install:
        return None, "none — StrykerJS not installed"
    # --no-save writes no file the project keeps: package.json and the lockfile stay untouched,
    # so nothing is committed and nothing is imposed on the repo. Measured install cost ~19s.
    target = core or root
    pkgs = ["@stryker-mutator/core@10", plugin + "@10"]
    base = ["npm", "install", "--no-save", "--no-audit", "--no-fund"]
    rc, out = run(base + pkgs, cwd=target, timeout=900)
    if rc != 0 and "ERESOLVE" in out.upper():
        # jest projects routinely have a peer graph npm refuses to resolve strictly. This is a
        # throwaway install into a workspace nothing commits, so a loose resolution is the right
        # trade — but only as a SECOND attempt, so a genuine failure is not papered over.
        rc, out = run(base + ["--legacy-peer-deps"] + pkgs, cwd=target, timeout=900)
    if rc != 0:
        return None, "error: --no-save install failed (exit %d)" % rc
    if node_root_with(plugin, runner, root):
        return target, "workspace-local"
    return None, "error: install succeeded but %s is not resolvable" % plugin


# vitest config shapes the generated config can inherit from. Same reasoning as the jest side:
# a generated config that REPLACES the project's own loses setupFiles, environment and aliases,
# and on a React component that means the jest-dom matchers are never registered.
VITEST_CONFIG_NAMES = ("vitest.config.ts", "vitest.config.mts", "vitest.config.js",
                       "vitest.config.mjs", "vite.config.ts", "vite.config.js")


def vitest_base_config(start_file, root):
    """Path (relative to the config we generate) of the project's own vitest config, or None."""
    d = os.path.dirname(os.path.abspath(start_file))
    root = os.path.abspath(root)
    while True:
        for name in VITEST_CONFIG_NAMES:
            p = os.path.join(d, name)
            if os.path.isfile(p):
                return p
        if d == root or os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)


# jest config shapes this helper can inherit from. A .ts/.mjs config cannot be `require`d from
# the generated CommonJS wrapper, and guessing at its contents would silently change what the
# mutation run measures — so those are reported, not worked around.
JEST_CONFIG_NAMES = ("jest.config.js", "jest.config.cjs", "jest.config.json", ".jestrc.json")
JEST_CONFIG_UNSUPPORTED = ("jest.config.ts", "jest.config.mjs")


def jest_base_config(cwd):
    """Return (js_expression_for_the_base_config, description) or (None, reason)."""
    for name in JEST_CONFIG_NAMES:
        if os.path.isfile(os.path.join(cwd, name)):
            return "require('./%s')" % name, name
    for name in JEST_CONFIG_UNSUPPORTED:
        if os.path.isfile(os.path.join(cwd, name)):
            return None, ("none — %s cannot be inherited by a generated CommonJS config; "
                          "scoped mutation needs a .js/.cjs/.json jest config" % name)
    pkg = read_json(os.path.join(cwd, "package.json")) or {}
    if isinstance(pkg.get("jest"), dict):
        return "(require('./package.json').jest || {})", "package.json#jest"
    return "{}", "defaults"


def boundary_map(prod_file, base):
    """line -> the boundary obligation on it, so a survivor can be named rather than numbered.

    A surviving mutant id tells you a test is missing. The obligation tells you WHICH case to
    write — the input where both sides are equal, the operand that alone decides a boolean, the
    path that reaches this throw. Measured across 39 suites, that is the difference between the
    88% suites and the 91% ones, so it is worth one extra subprocess on the pass that reports
    survivors.
    """
    if base is None:
        return {}
    rc, out = run(
        [sys.executable, os.path.join(base, "scripts", "test-coverage-gate.py"),
         "boundaries", "--production", prod_file, "--json"],
        cwd=os.path.dirname(prod_file), timeout=120)
    if rc not in (0, 3):
        return {}
    try:
        data = json.loads(out)
    except Exception:
        return {}
    m = {}
    for ob in data.get("obligations") or []:
        # Highest-risk kind wins when several sit on one line — that is the one to fix first.
        rank = {"throw": 0, "comparison": 1, "optional": 2, "index": 3,
                "logic": 4, "arithmetic": 5, "equality": 6}
        prev = m.get(ob.get("line"))
        if prev is None or rank.get(ob.get("kind"), 9) < rank.get(prev.get("kind"), 9):
            m[ob.get("line")] = ob
    return m


def write_survivor_report(manifest_path, survivors, bmap, root):
    """Persist EVERY survivor beside the manifest, and return the path.

    The printed block caps survivors at five so a verdict stays readable. Measured on the rig,
    that cap cost more than it saved: an agent that needs the full list to triage equivalents
    builds its OWN Stryker config and runs the whole mutation pass again -- 998 seconds across
    14 turns in one run, 24% of its wall, recomputing a report this helper already had in hand
    and threw away. Writing it costs milliseconds.
    """
    p = manifest_path + ".survivors.json"
    rows = []
    for m in survivors:
        loc = (m.get("location") or {}).get("start") or {}
        line = loc.get("line")
        ob = bmap.get(line) or {}
        rows.append({
            "status": m.get("status"),
            "line": line,
            "mutator": m.get("mutatorName"),
            "replacement": (m.get("replacement") or m.get("description") or "")[:160],
            "obligation": {"kind": ob.get("kind"), "expr": ob.get("expr")} if ob else None,
        })
    try:
        with open(p, "w", encoding="utf-8") as fh:
            json.dump({"schema": "zuvo-survivors/v1", "count": len(rows), "survivors": rows},
                      fh, indent=1)
    except Exception:
        return None
    return p


# Stryker's instrumentation wraps every mutated expression in these helpers. Finding them in a file
# that is supposed to be production source means an earlier inPlace run never got to restore it --
# and instrumenting an already-instrumented file recurses until the stack dies, which surfaces as an
# unexplained "Maximum call stack size exceeded" in the dry run rather than as corruption.
STRYKER_MARKERS = ("stryMutAct_", "stryCov_", "stryNS_")


def instrumentation_markers(path):
    """Count Stryker instrumentation helpers in a file (0 for clean production source)."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            body = fh.read()
    except OSError:
        return 0
    return sum(body.count(m) for m in STRYKER_MARKERS)


def project_test_config(runner_kind, start_file, root):
    """(config_dir, config_filename) for the project's own test config, walking up from the spec.

    The directory matters as much as the file: vitest resolves `include` against the working
    directory and jest resolves `rootDir` against its config's location, so running from anywhere
    else silently collects nothing.
    """
    names = {
        "vitest": ("vitest.config.ts", "vitest.config.mts", "vitest.config.js", "vitest.config.mjs",
                   "vite.config.ts", "vite.config.js"),
        "jest": ("jest.config.js", "jest.config.cjs", "jest.config.ts", "jest.config.mjs",
                 "jest.config.json"),
    }.get(runner_kind, ())
    d = os.path.dirname(os.path.abspath(start_file))
    root = os.path.abspath(root)
    while True:
        for name in names:
            if os.path.isfile(os.path.join(d, name)):
                return d, name
        # jest also lives inside package.json
        if runner_kind == "jest":
            pkg = read_json(os.path.join(d, "package.json")) or {}
            if isinstance(pkg.get("jest"), dict):
                return d, None
        if d == root or os.path.dirname(d) == d:
            return (root, None)
        d = os.path.dirname(d)


def check_mutation(runner, prod_file, test_files, root, cap, allow_install, base=None,
                   manifest_path=None):
    """Native mutation score for one production file, using the project's own test setup.

    Nothing about the project's configuration is regenerated, merged or guessed. See the module
    note on why: every generated-config variant failed differently, and the failures were silent
    -- Stryker reports "No tests were found", which reads like a broken setup rather than a path
    that means something different from where it was run.
    """
    r = Result("mutation")
    t0 = time.time()
    if runner["kind"] not in ("vitest", "jest"):
        r.status = "SKIP"
        r.detail = "none — no per-file mutation runner wired for %s" % runner["kind"]
        return r
    nroot, note = ensure_stryker(runner, root, allow_install)
    if nroot is None:
        r.status = "ERROR" if note.startswith("error") else "SKIP"
        r.detail = note
        return r

    cfg_dir, cfg_name = project_test_config(runner["kind"], test_files[0], root)
    prod_rel = rel_to(prod_file, cfg_dir)
    specs = [rel_to(f, cfg_dir) for f in test_files]
    note = "%s, from %s" % (note, rel_to(cfg_dir, root) or ".")

    stamp = str(os.getpid())
    scfg = os.path.join(cfg_dir, "stryker.zuvo-verify-%s.json" % stamp)
    rep = os.path.join(cfg_dir, ".zuvo-verify-mutation-%s" % stamp)

    # inPlace edits the real file, so the original has to survive an exit this process does not
    # control. An in-memory copy does not: SIGKILL -- a harness timeout, an OOM kill, an operator
    # ^C -- skips every `finally` and leaves the file instrumented. The next run then snapshots THAT
    # as its original, restores it faithfully afterwards, and reports a clean production-hash. The
    # corruption is now permanent AND invisible, and every score measured after it is garbage.
    #
    # So the copy goes to disk before anything runs, and a run that finds instrumentation already
    # present either heals from that copy or refuses. Refusing is the point: a mutation score
    # measured against an instrumented file is not a low score, it is not a score at all.
    sidecar = prod_file + ".zuvo-mutation-pristine"
    if instrumentation_markers(prod_file):
        if os.path.isfile(sidecar) and not instrumentation_markers(sidecar):
            shutil.copyfile(sidecar, prod_file)
            note += ", production restored from an interrupted run"
        else:
            r.status = "ERROR"
            r.detail = (
                "error: %s carries Stryker instrumentation left by an interrupted run, and no "
                "clean copy is available. Restore it (`git checkout -- %s`) before measuring."
                % (rel_to(prod_file, root), rel_to(prod_file, root))
            )
            return r
    with open(prod_file, "rb") as fh:
        pristine = fh.read()
    with contextlib.suppress(OSError), open(sidecar, "wb") as fh:
        fh.write(pristine)

    runner_block = {"testRunner": runner["kind"]}
    if runner["kind"] == "jest":
        # Scoping the DRY RUN is what decides whether this takes a minute or an hour. `testFiles`
        # limits which tests are used to kill mutants, but jest still crawls everything its own
        # config collects first -- measured here: 390 spec files, 36+ minutes, against 83 seconds
        # once the crawl is bounded.
        #
        # `roots` is the one narrowing knob that needs no knowledge of the project's config:
        # overriding testMatch on a config that sets testRegex (or the reverse) is a hard jest
        # validation error, and a .js config cannot be read from here to find out which it uses.
        #
        # Absolute paths, deliberately. Relative ones would have to be re-expressed against the
        # project's own `rootDir` (Nest sets 'src', others '.'), which is exactly the guesswork
        # that kept failing. `inPlace` means there is no sandbox to be absolute-path-hostile.
        spec_dirs = sorted({os.path.dirname(os.path.abspath(f)) or cfg_dir for f in test_files})
        runner_block["jest"] = {"config": {"roots": spec_dirs}}
        if cfg_name:
            runner_block["jest"]["projectType"] = "custom"
            runner_block["jest"]["configFile"] = cfg_name
    elif runner["kind"] == "vitest":
        runner_block["vitest"] = {
            # `related` asks vitest which tests import the mutated file; in a workspace that
            # resolution fails and the run dies reporting no tests. testFiles already scopes it.
            "related": False,
        }
        if cfg_name:
            runner_block["vitest"]["configFile"] = cfg_name

    cfg = {
        "packageManager": "npm",
        "reporters": ["json"],
        "jsonReporter": {"fileName": os.path.join(rep, "mutation.json")},
        "coverageAnalysis": "perTest",
        "mutate": [prod_rel],
        "testFiles": specs,
        # No sandbox. Stryker's sandbox never copies node_modules, and a workspace config that
        # resolves React through `../../node_modules/react` therefore cannot load inside it --
        # which is how a React case produced zero mutants for weeks without erroring visibly.
        "inPlace": True,
        # Stryker's instrumentation assigns to its own helper functions, which a type-checking
        # transform (ts-jest) rejects with TS2630 -- the dry run then fails with a type error about
        # code the project does not contain. Stryker guards against this by inserting @ts-nocheck,
        # but only for files matching `disableTypeChecks`, whose default glob ({test,src,lib}/**)
        # misses every monorepo layout (apps/*/src/**). Naming the mutated file matches any layout,
        # and skips preprocessing the rest of the tree -- which on this repo hit a parse error in an
        # unrelated 7000-line vendor file.
        "disableTypeChecks": prod_rel,
        # Stryker rewrites a project tsconfig when it finds one, through TypeScript APIs that
        # not every installed version still exports. Pointing at a file that does not exist
        # skips that preprocessor; nothing in a scoped run needs it.
        "tsconfigFile": "tsconfig.zuvo-verify-absent.json",
        # 2 was a good-neighbour guess made before anything was measured. Mutation is the longest
        # step in the whole verification and it is embarrassingly parallel, so the cap should track
        # the machine: a third of the cores leaves room for the suite, the editor and whatever else
        # shares the box, and still cuts the wall-clock several-fold on anything modern.
        "concurrency": max(2, min(8, (os.cpu_count() or 4) // 3)),
        "timeoutMS": 30000,
        "incremental": True,
        "incrementalFile": (manifest_path + ".stryker-incremental.json") if manifest_path
        else ".stryker-incremental.json",
    }
    cfg.update(runner_block)

    try:
        with open(scfg, "w", encoding="utf-8") as fh:
            json.dump(cfg, fh, indent=1)
        rc, out = run(["npx", "stryker", "run", os.path.basename(scfg)], cwd=cfg_dir, timeout=2400)
        data = read_json(os.path.join(rep, "mutation.json"))
        if data is None:
            r.status = "ERROR"
            r.detail = "error: stryker exit %d, no report" % rc
            r.evidence = tail(out, 20)
            return r
        killed = survived = timeout_n = noc = 0
        survivors = []
        for _f, fdata in (data.get("files") or {}).items():
            for m in fdata.get("mutants") or []:
                st = m.get("status")
                if st == "Killed":
                    killed += 1
                elif st == "Survived":
                    survived += 1
                    survivors.append(m)
                elif st == "Timeout":
                    timeout_n += 1
                elif st == "NoCoverage":
                    noc += 1
                    survivors.append(m)
        tested = killed + survived + timeout_n + noc
        score = (100.0 * (killed + timeout_n) / tested) if tested else 0.0
        r.detail = "%.1f%% (stryker %s, %d mutants: %d killed, %d survived, %d no-coverage)" % (
            score, note, tested, killed + timeout_n, survived, noc,
        )
        r.status = "PASS" if not survivors else "FAIL"
        bmap = boundary_map(prod_file, base) if survivors else {}
        # A NoCoverage mutant is strictly worse evidence than a survivor that at least ran under
        # a test, so those lead the fix list.
        survivors.sort(
            key=lambda m: (m.get("status") != "NoCoverage",
                           (m.get("location") or {}).get("start", {}).get("line", 0))
        )
        for m in survivors[:cap]:
            loc = (m.get("location") or {}).get("start") or {}
            line = loc.get("line")
            entry = "%s L%s %s -> `%s`" % (
                m.get("status"), line, m.get("mutatorName"),
                " ".join((m.get("replacement") or m.get("description") or "").split())[:60])
            ob = bmap.get(line)
            if ob:
                entry += "  [%s obligation on this line: %s]" % (ob.get("kind"), ob.get("expr"))
            r.gaps.append(entry)
        if len(survivors) > cap:
            report = write_survivor_report(manifest_path, survivors, bmap, root) if manifest_path else None
            msg = ("... %d more survivors — record their IDs and triage equivalents; do NOT chase all"
                   % (len(survivors) - cap))
            if report:
                msg += ". FULL list (all %d, with the boundary obligation on each line): %s" % (
                    len(survivors), rel_to(report, root))
            r.gaps.append(msg)
        elif manifest_path and survivors:
            write_survivor_report(manifest_path, survivors, bmap, root)
        return r
    finally:
        # Unconditional: a timeout or a crash mid-run leaves the real file mutated otherwise.
        with contextlib.suppress(OSError), open(prod_file, "wb") as fh:
            fh.write(pristine)
        # Only now is the on-disk copy redundant. Removing it any earlier would reopen the window
        # it exists to cover.
        with contextlib.suppress(OSError):
            os.unlink(sidecar)
        with contextlib.suppress(OSError):
            os.unlink(scfg)
        shutil.rmtree(rep, ignore_errors=True)
        r.seconds = time.time() - t0



def clear_debris(root, extra_dirs):
    removed = []
    for d in set([root] + list(extra_dirs)):
        for name in DEBRIS:
            p = os.path.join(d, name)
            if os.path.exists(p):
                shutil.rmtree(p, ignore_errors=True)
                removed.append(rel_to(p, root))
    return removed


# --------------------------------------------------------------------------- budget state


def state_path(manifest_path):
    return manifest_path + ".verify-state.json"


def bump_state(manifest_path, budget, time_budget_min):
    p = state_path(manifest_path)
    st = read_json(p) or {"schema": SCHEMA, "passes": 0, "history": []}
    st["passes"] = int(st.get("passes", 0)) + 1
    st["budget"] = budget
    st["time_budget_min"] = time_budget_min
    # The clock starts on the FIRST pass, not on this one, so a run cannot reset it by taking
    # a long detour between passes.
    st.setdefault("started_epoch", int(time.time()))
    st["elapsed_min"] = round((time.time() - st["started_epoch"]) / 60.0, 1)
    return st


def save_state(manifest_path, st, results):
    st.setdefault("history", []).append(
        {"pass": st["passes"], "results": [r.to_dict() for r in results]}
    )
    st["history"] = st["history"][-10:]
    try:
        with open(state_path(manifest_path), "w", encoding="utf-8") as fh:
            json.dump(st, fh, indent=2)
    except Exception:
        pass


# --------------------------------------------------------------------------- main


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--manifest", required=True)
    ap.add_argument("--repo-root", default=None)
    ap.add_argument("--skip", default="",
                    help="comma list of checks to skip: coverage,typecheck,mutation")
    ap.add_argument("--force-mutation", action="store_true",
                    help="run mutation even while cheaper checks still report gaps")
    ap.add_argument("--budget", type=int, default=DEFAULT_BUDGET,
                    help="max verification passes over one file")
    ap.add_argument("--time-budget", type=int, default=DEFAULT_TIME_BUDGET_MIN,
                    help="minutes from the FIRST pass before gaps are recorded rather than "
                         "chased; 0 disables the clock")
    ap.add_argument("--survivor-cap", type=int, default=5)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-install", action="store_true",
                    help="never npm install --no-save a missing mutation runner")
    ap.add_argument("--reset-budget", action="store_true")
    a = ap.parse_args()

    manifest_path = os.path.abspath(a.manifest)
    man = read_json(manifest_path)
    if man is None:
        print("[verify-tests] cannot read manifest: %s" % manifest_path, file=sys.stderr)
        return 2
    if a.reset_budget:
        # An escape an agent can type is not a budget. Measured across the benchmark corpus:
        # `--reset-budget` was used 212 times, systematically, to unwind the stop condition the
        # moment it fired -- one run made seven full verification passes against a budget of
        # three, at ~180s each on a jest project. The flag stays for tests and for a human who
        # genuinely wants to restart, but it now requires an environment variable, which is
        # attributable to whoever set it rather than to the agent that guessed it.
        if os.environ.get("ZUVO_VERIFY_RESET") == "1":
            with contextlib.suppress(OSError):
                os.unlink(state_path(manifest_path))
        else:
            print("[verify-tests] --reset-budget requires ZUVO_VERIFY_RESET=1. The budget is the "
                  "stop condition; restarting it is a human decision, not a pass.",
                  file=sys.stderr)

    root = os.path.abspath(a.repo_root or git_root(os.path.dirname(manifest_path)))
    prod_rel = man.get("production_file")
    if not prod_rel:
        print("[verify-tests] manifest has no production_file", file=sys.stderr)
        return 2
    prod = prod_rel if os.path.isabs(prod_rel) else os.path.join(root, prod_rel)
    tests = [t if os.path.isabs(t) else os.path.join(root, t) for t in (man.get("test_files") or [])]
    if not tests:
        print("[verify-tests] manifest has no test_files", file=sys.stderr)
        return 2
    missing = [t for t in tests + [prod] if not os.path.isfile(t)]
    if missing:
        print("[verify-tests] missing file(s): %s" % ", ".join(rel_to(m, root) for m in missing),
              file=sys.stderr)
        return 2

    skip = {s.strip() for s in a.skip.split(",") if s.strip()}
    base = zuvo_base()
    runner = detect_runner(man.get("stack"), tests, root)
    if "error" in runner:
        print("[verify-tests] runner detection failed: %s" % runner["error"], file=sys.stderr)
        return 2

    before = sha256(prod)
    frozen = man.get("production_sha256")
    st = bump_state(manifest_path, a.budget, a.time_budget)

    # Past the budget, an extra call must be CHEAP as well as refused. Reporting exit 4 while
    # still running the suite, the gate, coverage, a typecheck and a mutation pass means every
    # ignored refusal costs the same ~180s as a real pass -- which is how one run spent 38% of
    # its wall inside this helper. Answer from the record instead.
    if (a.budget and st["passes"] > a.budget) or (
            a.time_budget and st["elapsed_min"] >= a.time_budget and st["passes"] > 1):
        # The last entry that actually MEASURED something. Each refusal appends an empty entry,
        # so taking history[-1] blindly makes the second refusal report nothing at all — which
        # is worse than the first refusal, for a run that is being told to finish from it.
        prev = next((h for h in reversed(st.get("history") or []) if h.get("results")), {})
        print("=" * 78)
        print("VERIFY  %s   pass %d of %d   %.1f of %d min"
              % (rel_to(prod, root), st["passes"], a.budget, st["elapsed_min"], a.time_budget))
        print("=" * 78)
        print("REFUSED — the budget was already exhausted on pass %d. Nothing was re-run."
              % a.budget)
        for r in prev.get("results", []):
            print("  %-15s %-9s %s" % (r.get("check"), r.get("status"), r.get("detail", "")[:90]))
        gaps = [g for r in prev.get("results", []) for g in (r.get("gaps") or [])]
        if gaps:
            print("-" * 78)
            print("STILL OPEN (%d) — record these in the manifest and finish the file:" % len(gaps))
            for g in gaps:
                print("  - %s" % g)
        print("=" * 78)
        save_state(manifest_path, st, [])
        return 4

    results = []
    suite = check_suite(runner, tests, root)
    results.append(suite)
    # The gate and coverage measure a suite that is assumed green. Running them against a red
    # suite produces numbers that describe nothing and cost a full runner invocation each.
    if suite.status == "PASS":
        # The gate and the coverage run are independent processes reading the same green suite --
        # nothing either does changes what the other sees -- so they overlap. Every second saved
        # here matters for one specific reason: a call that runs past the Bash tool's 120-second
        # default gets backgrounded by the harness, and the agent then turns one tool call into a
        # polling loop (`sleep 90; kill -0 <pid>`, `sleep 60; echo tick`), which is the exact
        # shape this helper exists to remove. The two expensive checks are deferred below rather
        # than parallelised, which is what actually keeps an early pass inside the window.
        jobs = [("gate", lambda: check_gate(manifest_path, root, base))]
        if "coverage" not in skip:
            jobs.append(("coverage", lambda: check_coverage(runner, prod, tests, root)))
        done = {}
        with ThreadPoolExecutor(max_workers=len(jobs)) as pool:
            futures = {pool.submit(fn): name for name, fn in jobs}
            for fut in futures:
                name = futures[fut]
                try:
                    done[name] = fut.result()
                except Exception as exc:  # a check must not take the whole run down
                    r = Result(name)
                    r.status = "ERROR"
                    r.detail = "error: %s" % exc
                    done[name] = r
        gate = done["gate"]
        cov = done.get("coverage")
        results.append(gate)
        if cov is not None:
            results.append(cov)

        # The typecheck and the mutation run are the two expensive measurements (57s cold and
        # 270s median on the rig, against single-digit seconds for the gate). Both describe the
        # FINISHED suite, and a pass that still reports uncovered rows is looking at a suite
        # about to be rewritten — so both wait for the cheap checks to come back clean. This is
        # what keeps an early pass inside the harness's 120-second Bash window; a pass that
        # crosses it gets backgrounded, and the run spends four to six turns polling for output
        # one turn would have returned.
        # Gate the expensive checks on the TESTS, not on the manifest bookkeeping.
        #
        # The first version waited for the coverage GATE to pass. On the shield case that gate
        # never went green, so typecheck and mutation stayed deferred for the whole run and the
        # suite finished having never been mutated at all — scoring exactly the no-skill control
        # while a slower arm on the same file reached 90.7%. The gate checks whether inventory
        # rows carry evidence; it says nothing about whether the tests detect anything. A run
        # with imperfect bookkeeping and a good suite still deserves to learn which mutants
        # survive, and that is the most valuable signal in the pipeline.
        #
        # The suite being green and coverage being adequate is what makes a mutation number
        # meaningful. Those are the conditions.
        # The FIRST pass always measures mutation, whatever coverage says.
        #
        # Deferring it means the run writes a whole suite blind and only learns what it missed at
        # the end, when changing course is expensive. Measured on shield: a run that sees its
        # survivors once leaves 24 of them and scores 85.3%; runs that iterate on the list close
        # six more and reach 90%. Handing over the list on pass one makes it the specification
        # rather than the verdict — the same information, several rounds earlier, at the price of
        # one mutation run that was going to happen anyway.
        #
        # Later passes still wait for coverage: by then the list exists and re-measuring an
        # under-covered suite tells nobody anything new.
        first_pass = st["passes"] == 1
        cheap_clean = first_pass or cov is None or cov.status in ("PASS", "SKIP", "DEFER")
        deferred = ("deferred until coverage is adequate — nothing to do about it now "
                    "(--force-mutation runs both anyway)")
        if "typecheck" in skip:
            pass
        elif a.force_mutation or cheap_clean:
            results.append(check_typecheck(runner, prod, tests, root, manifest_path))
        else:
            r = Result("typecheck")
            # DEFER, not SKIP. SKIP means "this check cannot run here" and write-tests Step 3.3
            # keys on it to fall back to hand-written mutation probes. A deferral that says SKIP
            # therefore sends the agent off to run the expensive thing by hand -- measured at
            # 677s over 24 turns in one run, 29% of its wall, doing what the helper was about to
            # do for free on the next pass.
            r.status = "DEFER"
            r.detail = deferred
            results.append(r)
        # Mutation is by far the most expensive measurement here: median 270s on the rig and
        # 1089s at the worst, against 16-57s for the typecheck and single-digit seconds for the
        # gate. Running it while the cheap checks already say the suite is incomplete measures a
        # suite that is about to be rewritten, and on a first pass with 43 open rows that is the
        # single largest wasted block in the run. It waits until the suite is worth measuring.
        if "mutation" in skip:
            pass
        elif a.force_mutation or cheap_clean:
            results.append(check_mutation(runner, prod, tests, root, a.survivor_cap,
                                          not a.no_install, base, manifest_path))
        else:
            r = Result("mutation")
            r.status = "DEFER"
            r.detail = deferred
            results.append(r)
    else:
        for name in ("coverage-gate", "coverage", "typecheck", "mutation"):
            r = Result(name)
            r.status = "DEFER"
            r.detail = "not run — suite is red on unmutated source"
            results.append(r)

    after = sha256(prod)
    debris = clear_debris(root, [runner["cwd"]])

    hash_ok = after == before and (frozen is None or after == frozen)
    if not hash_ok:
        r = Result("production-hash")
        r.status = "FAIL"
        r.detail = "production file changed during verification"
        r.gaps.append("expected %s, found %s — restore the file before continuing"
                      % (frozen or before, after))
        results.append(r)
    else:
        r = Result("production-hash")
        r.status = "PASS"
        r.detail = after[:16] + " unchanged"
        results.append(r)

    save_state(manifest_path, st, results)

    open_gaps = [g for r in results for g in r.gaps]
    passes, budget = st["passes"], a.budget
    elapsed = st["elapsed_min"]
    # Two stop conditions, both owned by this program rather than by the agent's judgement.
    # The pass count bounds how many times the same suite gets re-measured; the clock bounds
    # the whole loop, because a run can burn an hour between two passes and the pass counter
    # will not notice. Measured across 33 scored runs on one file: within a single arm, working
    # 3-5x longer moves mutation kill by about half a point — and three of the four suites that
    # came out RED were among the most expensive runs. Effort past the plateau buys risk.
    out_of_time = bool(a.time_budget) and elapsed >= a.time_budget
    if not open_gaps:
        rc = 0
    elif passes >= budget or out_of_time:
        rc = 4
    else:
        rc = 1
    if any(r.status == "ERROR" for r in results):
        rc = max(rc, 2) if rc in (0,) else rc

    if a.json:
        print(json.dumps(
            {
                "schema": SCHEMA,
                "pass": passes,
                "budget": budget,
                "elapsed_min": elapsed,
                "time_budget_min": a.time_budget,
                "exit": rc,
                "production_file": rel_to(prod, root),
                "runner": runner["kind"],
                "results": [r.to_dict() for r in results],
            },
            indent=2,
        ))
        return rc

    w = 78
    print("=" * w)
    clock = ("   %.1f of %d min" % (elapsed, a.time_budget)) if a.time_budget else ""
    print("VERIFY  %s   pass %d of %d%s   runner: %s"
          % (rel_to(prod, root), passes, budget, clock, runner["kind"]))
    print("=" * w)
    for r in results:
        print("  %-15s %-9s %s" % (r.name, r.status, r.detail))
    if debris:
        print("  %-15s %-9s %s" % ("debris", "CLEARED", ", ".join(debris[:4])))
    if open_gaps:
        print("-" * w)
        print("OPEN (%d):" % len(open_gaps))
        for g in open_gaps:
            print("  - %s" % g)
    for r in results:
        if r.status in ("FAIL", "ERROR") and r.evidence:
            print("-" * w)
            print("EVIDENCE [%s]" % r.name)
            print(r.evidence)
    print("=" * w)
    if rc == 0:
        print("VERDICT: GREEN — every applicable check passed. Do NOT re-run this command.")
    elif rc == 4:
        why = ("%.1f minutes elapsed of a %d-minute budget" % (elapsed, a.time_budget)
               if out_of_time else "%d passes" % passes)
        print("VERDICT: BUDGET EXHAUSTED — %s. Record the OPEN items in the manifest" % why)
        print("         (survivors with IDs, uncovered rows with notes) and finish the file as")
        print("         BLOCKED_INCOMPLETE. Do NOT run another pass. Measured across 33 scored")
        print("         runs: within one arm, 3-5x the effort moves mutation kill by ~0.5 points,")
        print("         and the most expensive runs are where RED suites come from.")
    elif rc == 2:
        print("VERDICT: INFRASTRUCTURE ERROR — fix the tooling, not the tests.")
    else:
        print("VERDICT: %d gap(s) open. Make ONE fix round addressing ALL of them, then run"
              % len(open_gaps))
        print("         this command again. You have %d pass(es) left." % (budget - passes))
    print("=" * w)
    return rc


if __name__ == "__main__":
    sys.exit(main())
