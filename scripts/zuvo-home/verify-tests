#!/bin/sh
# Polyglot sh/python header — see compute-preload for why this exact line matters on Windows.
''''exec "$(command -v python3 || command -v python || echo python3)" "$0" "$@" # '''
"""
~/.zuvo/verify-tests — run EVERY write-tests verification in one process, print ONE verdict.

Usage:
  ~/.zuvo/verify-tests --manifest zuvo/contracts/<basename>.coverage.json
  ~/.zuvo/verify-tests --manifest <m> --skip mutation
  ~/.zuvo/verify-tests --manifest <m> --budget 3 --json

Why it exists. Measured 2026-08-21 across 28 runs writing tests for ONE file: the number of
conversational turns tracks one variable almost perfectly — how many times the run re-issued a
verification command it had already issued. Runs with zero repeats finished in 30-111 turns.
Runs with 9-14 repeats took 193-321. Runs with 28-30 repeats took 395-485. The commands being
repeated were always the same four: the coverage gate (up to 9x), the scoped test run (up to
8x), the production-file restore (up to 5x), the sha256 check (up to 3x).

That is not the agent being careless. write-tests asks for four SEPARATE verification passes —
Step 2.5 gate, Step 3 quality, Step 3.2 coverage, Step 3.3 mutation — and each one says "fix
and rerun". Four independent fix-and-rerun loops over the same suite is four chances to re-issue
the same command, and every re-issue re-bills the whole accumulated context.

Prose cannot close that. v7 added an explicit "run it ONCE, do not iterate" to Step 2.5 and a run
still called the gate five times. A skill that tells an agent HOW MANY TIMES to verify still
leaves the agent deciding when it is done, and deciding costs turns. The precedent is
`load-includes`: two rewordings of the loading block made runs longer, and replacing the block
with a command made them shorter.

So this is a command. One invocation runs the suite, the coverage gate, scoped coverage and the
native mutation runner, restores production, verifies the hash, clears the runner's debris, and
prints a single block listing every gap that is still open. The agent reads it, makes ONE fix
round, and calls this again. Subprocesses are free; turns are not.

It also carries its own budget. Each invocation increments a counter beside the manifest, and
the block prints `pass N of B`. On the last pass with gaps still open, exit is 4 and the block
says to record what remains rather than keep going — a stop condition the program owns, so
"am I done yet" stops being a judgement call made under a growing context.

Exit codes:
  0  every applicable check green
  1  gaps remain and budget is left — fix them and call again
  2  infrastructure error (manifest unreadable, no runner, production hash drift)
  4  budget exhausted with gaps open — record them, do not iterate further
"""
import argparse
import contextlib
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

SCHEMA = "zuvo-verify/v1"
DEFAULT_BUDGET = 3

COVERAGE_THRESHOLDS = {"statements": 85.0, "branches": 75.0, "functions": 90.0, "lines": 85.0}

# Runner debris that a native mutation run leaves behind. Cleared after every invocation:
# a leftover .stryker-tmp is both a multi-GB disk leak and a git-status false positive that
# the next check would report as an unexpected working-tree change.
DEBRIS = (".stryker-tmp", "mutants.out", ".mutmut-cache", "reports/mutation", ".pytest_cache")


# --------------------------------------------------------------------------- helpers


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def run(cmd, cwd=None, timeout=900, env=None):
    """Run a command, never raise. Returns (rc, combined_output)."""
    e = dict(os.environ)
    if env:
        e.update(env)
    try:
        p = subprocess.run(
            cmd,
            cwd=cwd,
            env=e,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
        return p.returncode, strip_ansi(p.stdout.decode("utf-8", "replace"))
    except subprocess.TimeoutExpired as exc:
        out = strip_ansi((exc.stdout or b"").decode("utf-8", "replace"))
        return 124, out + "\n[verify-tests] TIMEOUT after %ds\n" % timeout
    except FileNotFoundError as exc:
        return 127, "[verify-tests] not found: %s\n" % exc
    except Exception as exc:  # pragma: no cover - defensive
        return 126, "[verify-tests] %s\n" % exc


# Runner output is coloured even when not a TTY (vitest, stryker). Left in, the escapes break
# every anchored regex below — "^\\s*Tests" never matches a line that really starts with an SGR
# sequence, and the looser fallback then reads "Test Files 1 passed" as a one-test suite.
ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def strip_ansi(text):
    return ANSI.sub("", text)


def tail(text, n=25):
    lines = [l for l in text.splitlines() if l.strip()]
    return "\n".join(lines[-n:])


def git_root(start):
    rc, out = run(["git", "rev-parse", "--show-toplevel"], cwd=start)
    if rc == 0 and out.strip():
        return out.strip().splitlines()[-1]
    return os.path.abspath(start)


def zuvo_base():
    env = os.environ.get("ZUVO_BASE")
    if env and os.path.isfile(os.path.join(env, "scripts", "test-coverage-gate.py")):
        return env
    here = os.path.dirname(os.path.realpath(__file__))
    for cand in (
        os.path.join(here, ".."),  # repo: scripts/zuvo-home -> scripts/.. is repo root
        os.path.join(here, "..", ".."),
        os.path.expanduser("~/.zuvo-plugin"),
        os.path.expanduser("~/.claude"),
    ):
        if os.path.isfile(os.path.join(cand, "scripts", "test-coverage-gate.py")):
            return os.path.abspath(cand)
    return None


# --------------------------------------------------------------------------- runner detection


def read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return None


def nearest_package(start_file, root):
    """Walk up from a file to the nearest package.json, stopping at the repo root.

    Monorepos are the normal case, not the exception: the vitest/jest install that can run a
    spec usually lives in the workspace package (apps/api), not at the root. Running from the
    root instead produces a config-not-found failure that looks like a broken suite.
    """
    d = os.path.dirname(os.path.abspath(start_file))
    root = os.path.abspath(root)
    while True:
        pj = os.path.join(d, "package.json")
        if os.path.isfile(pj):
            data = read_json(pj) or {}
            deps = {}
            deps.update(data.get("dependencies") or {})
            deps.update(data.get("devDependencies") or {})
            scripts = data.get("scripts") or {}
            if "vitest" in deps or "jest" in deps or "test" in scripts:
                return d, data
        if d == root or os.path.dirname(d) == d:
            return None, None
        d = os.path.dirname(d)


def detect_runner(stack, test_files, root):
    """Return a dict describing how to run this suite, or an error string."""
    if stack in ("ts", "js", "tsx", "jsx", None, ""):
        pkgdir, pkg = nearest_package(test_files[0], root)
        if pkgdir is None:
            # Root package.json without a test script still beats nothing.
            pkg = read_json(os.path.join(root, "package.json"))
            if pkg is None:
                return {"error": "no package.json above %s" % test_files[0]}
            pkgdir = root
        deps = {}
        deps.update(pkg.get("dependencies") or {})
        deps.update(pkg.get("devDependencies") or {})
        if "vitest" in deps:
            return {"kind": "vitest", "cwd": pkgdir}
        if "jest" in deps:
            return {"kind": "jest", "cwd": pkgdir}
        # A workspace package can rely on a hoisted runner; look for the binary.
        for cand in ("vitest", "jest"):
            if os.path.exists(os.path.join(root, "node_modules", ".bin", cand)):
                return {"kind": cand, "cwd": pkgdir}
        return {"error": "no vitest/jest in %s" % os.path.relpath(pkgdir, root)}
    if stack == "python":
        return {"kind": "pytest", "cwd": root}
    if stack == "php":
        return {"kind": "phpunit", "cwd": root}
    return {"error": "unsupported stack %r" % stack}


def rel_to(path, base):
    return os.path.relpath(os.path.abspath(path), os.path.abspath(base))


# --------------------------------------------------------------------------- checks


class Result(object):
    def __init__(self, name):
        self.name = name
        self.status = "SKIP"
        self.detail = ""
        self.gaps = []
        self.evidence = ""
        self.seconds = 0.0

    def to_dict(self):
        return {
            "check": self.name,
            "status": self.status,
            "detail": self.detail,
            "gaps": self.gaps,
            "seconds": round(self.seconds, 1),
        }


def check_suite(runner, test_files, root):
    """The suite must be green on UNMUTATED source. Everything downstream assumes it."""
    r = Result("suite")
    t0 = time.time()
    cwd = runner["cwd"]
    specs = [rel_to(f, cwd) for f in test_files]
    if runner["kind"] == "vitest":
        cmd = ["npx", "vitest", "run"] + specs
    elif runner["kind"] == "jest":
        cmd = ["npx", "jest", "--runTestsByPath"] + specs
    elif runner["kind"] == "pytest":
        cmd = [sys.executable, "-m", "pytest", "-q"] + specs
    else:
        cmd = ["./vendor/bin/phpunit"] + specs
    rc, out = run(cmd, cwd=cwd)
    r.seconds = time.time() - t0
    r.evidence = tail(out, 30)
    if rc == 0:
        # Every runner prints several "N passed" lines and the FIRST one is the file count, so
        # a loose match reports a 50-test suite as 1 test. Anchor on the Tests line, and read
        # jest's "Tests: 35 skipped, 15 passed, 50 total" shape where `passed` is not the first
        # field. Skips are surfaced too: a suite that is 70% skipped is not the suite the rest
        # of this block is measuring, and silently calling it green hides that.
        m = (re.search(r"^\s*Tests\s+(\d+)\s+passed", out, re.M)
             or re.search(r"^Tests:.*?(\d+)\s+passed", out, re.M)
             or re.search(r"(\d+)\s+passed", out))
        skipped = re.search(r"^Tests:.*?(\d+)\s+(?:skipped|todo)", out, re.M) \
            or re.search(r"^\s*Tests\s+.*?(\d+)\s+skipped", out, re.M)
        r.status = "PASS"
        r.detail = "%s tests passed" % (m.group(1) if m else "all")
        if skipped and int(skipped.group(1)) > 0:
            r.detail += " (%s SKIPPED — those behaviours are unverified)" % skipped.group(1)
            r.gaps.append(
                "%s of the declared tests are skipped; coverage and mutation below describe "
                "only the ones that ran" % skipped.group(1)
            )
    else:
        r.status = "FAIL"
        r.detail = "runner exit %d" % rc
        # A failing assertion names the test; hand the agent the names, not the whole log.
        for line in out.splitlines():
            s = line.strip()
            if (re.match(r"^(FAIL|×|✕|●|E\s)", s) or "AssertionError" in s) and s not in r.gaps:
                r.gaps.append(s[:200])
        if not r.gaps:
            r.gaps.append("suite exited %d — see evidence block" % rc)
    return r


def check_gate(manifest_path, root, base):
    r = Result("coverage-gate")
    t0 = time.time()
    if base is None:
        r.status = "ERROR"
        r.detail = ("cannot locate scripts/test-coverage-gate.py (ZUVO_BASE=%r) — "
                    "set ZUVO_BASE to the zuvo install root"
                    % os.environ.get("ZUVO_BASE", ""))
        return r
    cmd = [
        sys.executable,
        os.path.join(base, "scripts", "test-coverage-gate.py"),
        "validate",
        "--manifest",
        manifest_path,
        "--phase",
        "final",
        "--repo-root",
        root,
    ]
    rc, out = run(cmd, cwd=root, timeout=300)
    r.seconds = time.time() - t0
    r.evidence = out.strip()
    if rc == 0:
        r.status = "PASS"
        m = re.search(r"Public entry points:\s*(\S+)", out)
        r.detail = m.group(1) if m else "validated"
    elif rc == 3:
        r.status = "DEGRADED"
        r.detail = "textual extraction — evidence quality BLOCKED_DEGRADED"
    else:
        r.status = "FAIL"
        r.detail = "validator exit %d" % rc
        # The validator already names each violation on its own FAIL:/ERROR: line. Scraping
        # anything looser (a tail, a prefix guess) folds its summary counters into the gap
        # list, and a gap list with "Uncovered owned rows: 0" in it reads as a contradiction.
        for line in out.splitlines():
            t = line.strip()
            if re.match(r"^(FAIL|ERROR|VIOLATION)\b", t):
                r.gaps.append(t[:200])
        if not r.gaps:
            for line in out.splitlines():
                t = line.strip()
                if t.lower().startswith("missing symbols:"):
                    r.gaps.append(t[:200])
        if not r.gaps:
            r.gaps.append("validator exit %d — see EVIDENCE block" % rc)
    return r


def check_coverage(runner, prod_file, test_files, root):
    r = Result("coverage")
    t0 = time.time()
    cwd = runner["cwd"]
    if runner["kind"] not in ("vitest", "jest"):
        r.status = "SKIP"
        r.detail = "%s coverage not wired in this helper — run it by hand if needed" % runner["kind"]
        return r
    outdir = tempfile.mkdtemp(prefix="zuvo-cov-")
    specs = [rel_to(f, cwd) for f in test_files]
    prod_rel = rel_to(prod_file, cwd)
    try:
        if runner["kind"] == "vitest":
            cmd = (
                ["npx", "vitest", "run"]
                + specs
                + [
                    "--coverage",
                    "--coverage.provider=v8",
                    "--coverage.reporter=json-summary",
                    "--coverage.reportsDirectory=" + outdir,
                    "--coverage.include=" + prod_rel,
                    "--coverage.all=false",
                ]
            )
        else:
            # jest resolves collectCoverageFrom against rootDir (commonly `src` in Nest
            # projects), not against cwd — a cwd-relative path silently matches nothing and
            # every metric comes back as the literal string "Unknown". A `**/`-prefixed glob
            # is rootDir-independent; the exact file is then picked out of the summary by
            # absolute path below, so the wider glob cannot smuggle another file's numbers in.
            cmd = [
                "npx",
                "jest",
                "--runTestsByPath",
            ] + specs + [
                "--coverage",
                "--coverageReporters=json-summary",
                "--coverageDirectory=" + outdir,
                "--collectCoverageFrom=**/" + os.path.basename(prod_rel),
            ]
        rc, out = run(cmd, cwd=cwd)
        summary = read_json(os.path.join(outdir, "coverage-summary.json"))
        if summary is None:
            r.status = "SKIP"
            r.detail = "runner produced no coverage-summary.json (exit %d)" % rc
            r.evidence = tail(out, 12)
            return r
        # The per-file entry is keyed by absolute path; total is the safe aggregate when the
        # include filter has already narrowed to one file.
        entry = None
        for k, v in summary.items():
            if k == "total":
                continue
            if os.path.abspath(k) == os.path.abspath(prod_file):
                entry = v
                break
        if entry is None:
            files = [k for k in summary if k != "total"]
            if len(files) == 1:
                entry = summary[files[0]]
            elif files:
                # `total` aggregates every file the reporter saw. Reporting it as this file's
                # coverage would be a number about the wrong thing, so say so instead.
                r.status = "SKIP"
                r.detail = ("no entry for %s; summary covers %d files — coverage not attributable"
                            % (prod_rel, len(files)))
                return r
            else:
                entry = summary.get("total")
        if not entry:
            r.status = "SKIP"
            r.detail = "no coverage entry for %s" % prod_rel
            return r
        nums, failed, unknown = [], [], []
        for key, floor in COVERAGE_THRESHOLDS.items():
            raw = (entry.get(key) or {}).get("pct")
            try:
                pct = float(raw)
            except (TypeError, ValueError):
                # jest writes the literal string "Unknown" when it collected no data for a
                # metric. Scoring that as 0% would report a false shortfall and send the agent
                # chasing coverage that was never measured; the honest result is "not measured".
                unknown.append("%s=%r" % (key, raw))
                nums.append("%s ?" % key)
                continue
            nums.append("%s %.1f%%" % (key, pct))
            if pct < floor:
                failed.append("%s %.1f%% < %.0f%%" % (key, pct, floor))
        if unknown and not failed:
            r.status = "SKIP"
            r.detail = "not measured (%s) — %s" % (", ".join(unknown), "  ".join(nums))
            return r
        r.detail = "  ".join(nums)
        if failed:
            r.status = "FAIL"
            r.gaps = failed
            unc = (entry.get("lines") or {}).get("uncoveredLines")
            if unc:
                r.gaps.append("uncovered lines: %s" % unc)
        else:
            r.status = "PASS"
        return r
    finally:
        shutil.rmtree(outdir, ignore_errors=True)
        r.seconds = time.time() - t0


def nearest_tsconfig(start_file, root):
    """The tsconfig that OWNS this file — the workspace project, not the monorepo root.

    A root-level typecheck on a monorepo compiles every package to say something about one
    file, and on this rig that measured 74-250 seconds per invocation. The project tsconfig
    beside the file is the smallest unit that still carries the paths, decorators and lib
    settings the file actually compiles under.
    """
    d = os.path.dirname(os.path.abspath(start_file))
    root = os.path.abspath(root)
    while True:
        for name in ("tsconfig.json", "tsconfig.app.json", "tsconfig.build.json"):
            p = os.path.join(d, name)
            if os.path.isfile(p):
                return p
        if d == root or os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)


TS_DIAG = re.compile(r"^(?P<file>[^(]+)\((?P<line>\d+),\d+\):\s+error\s+(?P<code>TS\d+):\s*(?P<msg>.*)$")


def check_typecheck(runner, prod_file, test_files, root, manifest_path):
    """Type errors IN THE FILES UNDER TEST. Everything else is somebody else's debt.

    Two measurements drove this. First, `typecheck` was the largest wall-clock bucket in every
    arm on the rig including the no-skill control — 122s median there, 247s in the heaviest arm,
    722s at the worst — because agents reach for a project-wide `tsc --noEmit` on their own.
    Second, the project under test carries 6050 pre-existing type errors, so that spend buys a
    wall of diagnostics the run did not cause and cannot act on.

    So: one incremental run per invocation against the OWNING project, with the build-info file
    kept beside the manifest so the second pass is warm (measured 57s cold, 16s warm), and only
    diagnostics whose file is the production file or one of its specs become gaps. The
    pre-existing count is reported as context so nobody mistakes silence for a clean project.
    """
    r = Result("typecheck")
    t0 = time.time()
    if runner["kind"] not in ("vitest", "jest"):
        r.status = "SKIP"
        r.detail = "not wired for %s" % runner["kind"]
        return r
    tscfg = nearest_tsconfig(prod_file, root)
    if tscfg is None:
        r.status = "SKIP"
        r.detail = "no tsconfig owning %s" % rel_to(prod_file, root)
        return r
    cwd = os.path.dirname(tscfg)
    if not os.path.exists(os.path.join(cwd, "node_modules", ".bin", "tsc")) and not os.path.exists(
        os.path.join(root, "node_modules", ".bin", "tsc")
    ):
        r.status = "SKIP"
        r.detail = "no typescript installed"
        return r
    buildinfo = manifest_path + ".tsbuildinfo"
    rc, out = run(
        ["npx", "tsc", "--noEmit", "-p", os.path.basename(tscfg),
         "--incremental", "--tsBuildInfoFile", buildinfo],
        cwd=cwd,
        timeout=1200,
    )
    r.seconds = time.time() - t0
    if rc == 124:
        r.status = "ERROR"
        r.detail = "error: tsc timed out"
        return r
    specs = {os.path.abspath(f) for f in test_files}
    prod_abs = os.path.abspath(prod_file)
    mine, in_prod, total = [], [], 0
    for line in out.splitlines():
        m = TS_DIAG.match(line.strip())
        if not m:
            continue
        total += 1
        path = os.path.abspath(os.path.join(cwd, m.group("file")))
        entry = "%s:%s %s: %s" % (rel_to(path, root), m.group("line"), m.group("code"),
                                  m.group("msg")[:120])
        if path in specs:
            mine.append(entry)
        elif path == prod_abs:
            in_prod.append(entry)
    # Only the SPEC files are this run's output. An error in the production file is debt the run
    # inherited, and blocking on it would make write-tests refuse to finish for a defect outside
    # its fence — while dropping it silently would hide a file the new tests may not compile
    # against. So it is reported, and backlogged, but it is not a gap.
    pre = total - len(mine) - len(in_prod)
    ctx = []
    if in_prod:
        ctx.append("%d pre-existing in the production file" % len(in_prod))
    if pre:
        ctx.append("%d elsewhere" % pre)
    suffix = " (%s — not this run's)" % ", ".join(ctx) if ctx else ""
    if mine:
        r.status = "FAIL"
        r.detail = "%d error(s) in the written spec%s" % (len(mine), suffix)
        r.gaps.extend(mine[:10])
        if len(mine) > 10:
            r.gaps.append("... %d more type errors in the written spec" % (len(mine) - 10))
    else:
        r.status = "PASS"
        r.detail = "0 errors in the written spec" + suffix
    if in_prod:
        r.evidence = ("Pre-existing type errors in the production file — backlog these, they do "
                      "not block this run:\n" + "\n".join(in_prod[:8]))
    return r


def node_root_with(pkg, runner, root):
    """Directory whose node_modules holds `pkg`, preferring the workspace package."""
    for d in (runner["cwd"], root):
        if os.path.isdir(os.path.join(d, "node_modules", *pkg.split("/"))):
            return d
    return None


def ensure_stryker(runner, root, allow_install):
    """Return (node_root, note) or (None, reason).

    Stryker is TWO packages: the core and the test-runner plugin for THIS runner. A project with
    only the core (a leftover from a one-off run, a hoisted transitive) cannot execute anything,
    so both are required before this reports a runner as available.
    """
    plugin = "@stryker-mutator/%s-runner" % runner["kind"]
    core = node_root_with("@stryker-mutator/core", runner, root)
    plug = node_root_with(plugin, runner, root)
    if core and plug:
        return core, "project"
    if not allow_install:
        return None, "none — StrykerJS not installed"
    # --no-save writes no file the project keeps: package.json and the lockfile stay untouched,
    # so nothing is committed and nothing is imposed on the repo. Measured install cost ~19s.
    target = core or root
    pkgs = ["@stryker-mutator/core@10", plugin + "@10"]
    base = ["npm", "install", "--no-save", "--no-audit", "--no-fund"]
    rc, out = run(base + pkgs, cwd=target, timeout=900)
    if rc != 0 and "ERESOLVE" in out.upper():
        # jest projects routinely have a peer graph npm refuses to resolve strictly. This is a
        # throwaway install into a workspace nothing commits, so a loose resolution is the right
        # trade — but only as a SECOND attempt, so a genuine failure is not papered over.
        rc, out = run(base + ["--legacy-peer-deps"] + pkgs, cwd=target, timeout=900)
    if rc != 0:
        return None, "error: --no-save install failed (exit %d)" % rc
    if node_root_with(plugin, runner, root):
        return target, "workspace-local"
    return None, "error: install succeeded but %s is not resolvable" % plugin


# jest config shapes this helper can inherit from. A .ts/.mjs config cannot be `require`d from
# the generated CommonJS wrapper, and guessing at its contents would silently change what the
# mutation run measures — so those are reported, not worked around.
JEST_CONFIG_NAMES = ("jest.config.js", "jest.config.cjs", "jest.config.json", ".jestrc.json")
JEST_CONFIG_UNSUPPORTED = ("jest.config.ts", "jest.config.mjs")


def jest_base_config(cwd):
    """Return (js_expression_for_the_base_config, description) or (None, reason)."""
    for name in JEST_CONFIG_NAMES:
        if os.path.isfile(os.path.join(cwd, name)):
            return "require('./%s')" % name, name
    for name in JEST_CONFIG_UNSUPPORTED:
        if os.path.isfile(os.path.join(cwd, name)):
            return None, ("none — %s cannot be inherited by a generated CommonJS config; "
                          "scoped mutation needs a .js/.cjs/.json jest config" % name)
    pkg = read_json(os.path.join(cwd, "package.json")) or {}
    if isinstance(pkg.get("jest"), dict):
        return "(require('./package.json').jest || {})", "package.json#jest"
    return "{}", "defaults"


def check_mutation(runner, prod_file, test_files, root, cap, allow_install):
    """Native mutation score, scoped to this file AND this suite.

    Scoping the TEST RUN matters as much as scoping --mutate. Stryker's dry run executes
    whatever the project's vitest config includes; on any repo with pre-existing red tests that
    kills the run before a single mutant is tested, and the failure reads like a broken mutation
    setup rather than an unrelated failing suite. A generated config that includes only the spec
    under test removes both problems.
    """
    r = Result("mutation")
    t0 = time.time()
    if runner["kind"] not in ("vitest", "jest"):
        r.status = "SKIP"
        r.detail = "none — no per-file mutation runner wired for %s" % runner["kind"]
        return r
    nroot, note = ensure_stryker(runner, root, allow_install)
    if nroot is None:
        r.status = "ERROR" if note.startswith("error") else "SKIP"
        r.detail = note
        return r

    prod_rel = rel_to(prod_file, nroot)
    specs = [rel_to(f, nroot) for f in test_files]
    stamp = str(os.getpid())
    ext = "config.ts" if runner["kind"] == "vitest" else "config.js"
    vcfg = os.path.join(nroot, "%s.zuvo-verify-%s.%s" % (runner["kind"], stamp, ext))
    scfg = os.path.join(nroot, "stryker.zuvo-verify-%s.json" % stamp)
    rep = os.path.join(nroot, ".zuvo-verify-mutation-%s" % stamp)
    try:
        if runner["kind"] == "vitest":
            with open(vcfg, "w", encoding="utf-8") as fh:
                fh.write(
                    "import { defineConfig } from 'vitest/config';\n"
                    "export default defineConfig({\n"
                    "  test: { include: %s, environment: 'node', pool: 'forks',\n"
                    "          poolOptions: { forks: { singleFork: true } } },\n"
                    "});\n" % json.dumps(specs)
                )
            runner_block = {"testRunner": "vitest", "vitest": {"configFile": os.path.basename(vcfg)}}
        else:
            expr, desc = jest_base_config(nroot)
            if expr is None:
                r.status = "SKIP"
                r.detail = desc
                return r
            note = "%s, config %s" % (note, desc)
            with open(vcfg, "w", encoding="utf-8") as fh:
                fh.write(
                    "const path = require('path');\n"
                    "const base = %s;\n"
                    "// testRegex and testMatch are mutually exclusive in jest: a generated config\n"
                    "// that sets testMatch while inheriting testRegex is a hard validation error,\n"
                    "// not a narrower run. Both are dropped before testMatch is set.\n"
                    "const { testRegex, testMatch, ...rest } = base;\n"
                    "const baseRoot = base.rootDir || '.';\n"
                    "// Stryker executes in a SANDBOX COPY of the project, so an absolute path\n"
                    "// computed here points outside the tree jest is given and matches nothing\n"
                    "// (\"No tests were found\", which reads as a broken mutation setup). Anchor\n"
                    "// on <rootDir> instead, and derive the offset from the inherited rootDir so\n"
                    "// a Nest-style rootDir of 'src' and a bare '.' both resolve correctly.\n"
                    "const specs = %s;\n"
                    "module.exports = {\n"
                    "  ...rest,\n"
                    "  rootDir: path.resolve(__dirname, baseRoot),\n"
                    "  testMatch: specs.map(function (sp) {\n"
                    "    return '<rootDir>/' + path.relative(baseRoot, sp).split(path.sep).join('/');\n"
                    "  }),\n"
                    "};\n" % (expr, json.dumps(specs))
                )
            runner_block = {
                "testRunner": "jest",
                "jest": {"projectType": "custom", "configFile": os.path.basename(vcfg)},
            }
        cfg = {
            "packageManager": "npm",
            "reporters": ["json"],
            "jsonReporter": {"fileName": os.path.join(rep, "mutation.json")},
            "coverageAnalysis": "perTest",
            "mutate": [prod_rel],
            # Stryker rewrites the project tsconfig when it finds one, and that preprocessor
            # calls TypeScript APIs that not every installed TS version still exports
            # (`ts.parseConfigFileTextToJson is not a function` kills the run before a single
            # mutant is tested). Pointing at a file that does not exist skips the preprocessor;
            # nothing in a scoped run needs it.
            "tsconfigFile": "tsconfig.zuvo-verify-absent.json",
            "ignorePatterns": [
                ".git", ".cursor", ".claude", ".vscode", ".idea",
                "docs/**", "audits/**", "audit-results/**", "artifacts/**",
                "zuvo/**", "memory/**", "e2e/**", "playwright-report/**",
                "coverage/**", "**/.next/**", "**/dist/**", "**/build/**",
                "**/*.png", "**/*.jpg", "**/*.mp4", "**/*.zip",
            ],
            "concurrency": 2,
            "timeoutMS": 30000,
            "tempDirName": ".stryker-tmp",
            "cleanTempDir": True,
        }
        cfg.update(runner_block)
        with open(scfg, "w", encoding="utf-8") as fh:
            json.dump(cfg, fh)
        rc, out = run(
            ["npx", "stryker", "run", os.path.basename(scfg)], cwd=nroot, timeout=2400
        )
        data = read_json(os.path.join(rep, "mutation.json"))
        if data is None:
            r.status = "ERROR"
            r.detail = "error: stryker exit %d, no report" % rc
            r.evidence = tail(out, 20)
            return r
        killed = survived = timeout_n = noc = 0
        survivors = []
        for _f, fdata in (data.get("files") or {}).items():
            for m in fdata.get("mutants") or []:
                st = m.get("status")
                if st == "Killed":
                    killed += 1
                elif st == "Survived":
                    survived += 1
                    survivors.append(m)
                elif st == "Timeout":
                    timeout_n += 1
                elif st == "NoCoverage":
                    noc += 1
                    survivors.append(m)
        tested = killed + survived + timeout_n + noc
        score = (100.0 * (killed + timeout_n) / tested) if tested else 0.0
        r.detail = "%.1f%% (stryker %s, %d mutants: %d killed, %d survived, %d no-coverage)" % (
            score, note, tested, killed + timeout_n, survived, noc,
        )
        r.status = "PASS" if not survivors else "FAIL"
        # A NoCoverage mutant is strictly worse evidence than a survivor that at least ran
        # under a test, so those lead the fix list.
        survivors.sort(
            key=lambda m: (
                m.get("status") != "NoCoverage",
                (m.get("location") or {}).get("start", {}).get("line", 0),
            )
        )
        for m in survivors[:cap]:
            loc = (m.get("location") or {}).get("start") or {}
            r.gaps.append(
                "%s L%s %s -> `%s`"
                % (
                    m.get("status"),
                    loc.get("line"),
                    m.get("mutatorName"),
                    " ".join((m.get("replacement") or m.get("description") or "").split())[:60],
                )
            )
        if len(survivors) > cap:
            r.gaps.append(
                "... %d more survivors — record their IDs and triage equivalents; do NOT chase all"
                % (len(survivors) - cap)
            )
        return r
    finally:
        for f in (vcfg, scfg):
            with contextlib.suppress(OSError):
                os.unlink(f)
        shutil.rmtree(rep, ignore_errors=True)
        r.seconds = time.time() - t0


def clear_debris(root, extra_dirs):
    removed = []
    for d in set([root] + list(extra_dirs)):
        for name in DEBRIS:
            p = os.path.join(d, name)
            if os.path.exists(p):
                shutil.rmtree(p, ignore_errors=True)
                removed.append(rel_to(p, root))
    return removed


# --------------------------------------------------------------------------- budget state


def state_path(manifest_path):
    return manifest_path + ".verify-state.json"


def bump_state(manifest_path, budget):
    p = state_path(manifest_path)
    st = read_json(p) or {"schema": SCHEMA, "passes": 0, "history": []}
    st["passes"] = int(st.get("passes", 0)) + 1
    st["budget"] = budget
    return st


def save_state(manifest_path, st, results):
    st.setdefault("history", []).append(
        {"pass": st["passes"], "results": [r.to_dict() for r in results]}
    )
    st["history"] = st["history"][-10:]
    try:
        with open(state_path(manifest_path), "w", encoding="utf-8") as fh:
            json.dump(st, fh, indent=2)
    except Exception:
        pass


# --------------------------------------------------------------------------- main


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--manifest", required=True)
    ap.add_argument("--repo-root", default=None)
    ap.add_argument("--skip", default="",
                    help="comma list of checks to skip: coverage,typecheck,mutation")
    ap.add_argument("--force-mutation", action="store_true",
                    help="run mutation even while cheaper checks still report gaps")
    ap.add_argument("--budget", type=int, default=DEFAULT_BUDGET)
    ap.add_argument("--survivor-cap", type=int, default=5)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-install", action="store_true",
                    help="never npm install --no-save a missing mutation runner")
    ap.add_argument("--reset-budget", action="store_true")
    a = ap.parse_args()

    manifest_path = os.path.abspath(a.manifest)
    man = read_json(manifest_path)
    if man is None:
        print("[verify-tests] cannot read manifest: %s" % manifest_path, file=sys.stderr)
        return 2
    if a.reset_budget:
        with contextlib.suppress(OSError):
            os.unlink(state_path(manifest_path))

    root = os.path.abspath(a.repo_root or git_root(os.path.dirname(manifest_path)))
    prod_rel = man.get("production_file")
    if not prod_rel:
        print("[verify-tests] manifest has no production_file", file=sys.stderr)
        return 2
    prod = prod_rel if os.path.isabs(prod_rel) else os.path.join(root, prod_rel)
    tests = [t if os.path.isabs(t) else os.path.join(root, t) for t in (man.get("test_files") or [])]
    if not tests:
        print("[verify-tests] manifest has no test_files", file=sys.stderr)
        return 2
    missing = [t for t in tests + [prod] if not os.path.isfile(t)]
    if missing:
        print("[verify-tests] missing file(s): %s" % ", ".join(rel_to(m, root) for m in missing),
              file=sys.stderr)
        return 2

    skip = {s.strip() for s in a.skip.split(",") if s.strip()}
    base = zuvo_base()
    runner = detect_runner(man.get("stack"), tests, root)
    if "error" in runner:
        print("[verify-tests] runner detection failed: %s" % runner["error"], file=sys.stderr)
        return 2

    before = sha256(prod)
    frozen = man.get("production_sha256")
    st = bump_state(manifest_path, a.budget)

    results = []
    suite = check_suite(runner, tests, root)
    results.append(suite)
    # The gate and coverage measure a suite that is assumed green. Running them against a red
    # suite produces numbers that describe nothing and cost a full runner invocation each.
    if suite.status == "PASS":
        gate = check_gate(manifest_path, root, base)
        results.append(gate)
        cov = None
        if "coverage" not in skip:
            cov = check_coverage(runner, prod, tests, root)
            results.append(cov)
        if "typecheck" not in skip:
            results.append(check_typecheck(runner, prod, tests, root, manifest_path))
        # Mutation is by far the most expensive measurement here: median 270s on the rig and
        # 1089s at the worst, against 16-57s for the typecheck and single-digit seconds for the
        # gate. Running it while the cheap checks already say the suite is incomplete measures a
        # suite that is about to be rewritten, and on a first pass with 43 open rows that is the
        # single largest wasted block in the run. It waits until the suite is worth measuring.
        if "mutation" in skip:
            pass
        elif a.force_mutation or (
            gate.status in ("PASS", "DEGRADED") and (cov is None or cov.status in ("PASS", "SKIP"))
        ):
            results.append(check_mutation(runner, prod, tests, root, a.survivor_cap, not a.no_install))
        else:
            r = Result("mutation")
            r.detail = ("deferred — close the gaps above first; mutation measures a finished "
                        "suite (--force-mutation to override)")
            results.append(r)
    else:
        for name in ("coverage-gate", "coverage", "typecheck", "mutation"):
            r = Result(name)
            r.detail = "not run — suite is red on unmutated source"
            results.append(r)

    after = sha256(prod)
    debris = clear_debris(root, [runner["cwd"]])

    hash_ok = after == before and (frozen is None or after == frozen)
    if not hash_ok:
        r = Result("production-hash")
        r.status = "FAIL"
        r.detail = "production file changed during verification"
        r.gaps.append("expected %s, found %s — restore the file before continuing"
                      % (frozen or before, after))
        results.append(r)
    else:
        r = Result("production-hash")
        r.status = "PASS"
        r.detail = after[:16] + " unchanged"
        results.append(r)

    save_state(manifest_path, st, results)

    open_gaps = [g for r in results for g in r.gaps]
    passes, budget = st["passes"], a.budget
    if not open_gaps:
        rc = 0
    elif passes >= budget:
        rc = 4
    else:
        rc = 1
    if any(r.status == "ERROR" for r in results):
        rc = max(rc, 2) if rc in (0,) else rc

    if a.json:
        print(json.dumps(
            {
                "schema": SCHEMA,
                "pass": passes,
                "budget": budget,
                "exit": rc,
                "production_file": rel_to(prod, root),
                "runner": runner["kind"],
                "results": [r.to_dict() for r in results],
            },
            indent=2,
        ))
        return rc

    w = 78
    print("=" * w)
    print("VERIFY  %s   pass %d of %d   runner: %s" % (rel_to(prod, root), passes, budget, runner["kind"]))
    print("=" * w)
    for r in results:
        print("  %-15s %-9s %s" % (r.name, r.status, r.detail))
    if debris:
        print("  %-15s %-9s %s" % ("debris", "CLEARED", ", ".join(debris[:4])))
    if open_gaps:
        print("-" * w)
        print("OPEN (%d):" % len(open_gaps))
        for g in open_gaps:
            print("  - %s" % g)
    for r in results:
        if r.status in ("FAIL", "ERROR") and r.evidence:
            print("-" * w)
            print("EVIDENCE [%s]" % r.name)
            print(r.evidence)
    print("=" * w)
    if rc == 0:
        print("VERDICT: GREEN — every applicable check passed. Do NOT re-run this command.")
    elif rc == 4:
        print("VERDICT: BUDGET EXHAUSTED after %d passes. Record the OPEN items in the manifest" % passes)
        print("         (survivors with IDs, uncovered rows with notes) and finish the file as")
        print("         BLOCKED_INCOMPLETE. Do NOT run another pass — %d passes did not close them." % passes)
    elif rc == 2:
        print("VERDICT: INFRASTRUCTURE ERROR — fix the tooling, not the tests.")
    else:
        print("VERDICT: %d gap(s) open. Make ONE fix round addressing ALL of them, then run"
              % len(open_gaps))
        print("         this command again. You have %d pass(es) left." % (budget - passes))
    print("=" * w)
    return rc


if __name__ == "__main__":
    sys.exit(main())
