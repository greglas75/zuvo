def stamp_receipt(manifest_path, results, test_files, repo_root):
    """Record IN THE MANIFEST that this suite was actually measured, and against which bytes.

    Measured across the benchmark corpus: roughly one run in three skips the verification command
    outright — not by failing it, by deciding it. One transcript says so in as many words: "isn't
    practical to run in full here, I'll follow its core spine pragmatically". The suite then ships
    unmeasured and the run reports success, and nothing downstream can tell the difference.

    Prose does not fix that; the helper's own docstring records two attempts. What does is making
    the ARTIFACT carry the proof, so the existing executable gate can refuse a manifest that claims
    to be final without one. The spec hashes are what make it a receipt rather than a flag: they go
    stale the moment the suite is edited afterwards, so a receipt cannot be inherited from an
    earlier, different suite.
    """
    man = read_json(manifest_path)
    if man is None:
        return
    by_check = {r.name: r for r in results}
    suite = by_check.get("suite")
    # A receipt is meant to prove the suite was MEASURED. Stamping one from a pass where the suite
    # was red -- or was skipped -- proves only that this program ran, which is a different and much
    # weaker claim, and it is the claim the gate would then be enforcing. Caught reviewing this
    # file: a run whose suite FAILED and whose mutation and coverage both DEFERred still came away
    # with a receipt in the manifest.
    if suite is None or suite.status != "PASS":
        return
    # The receipt attests that the suite was measured against THESE bytes of production. If the
    # production file drifted during the pass — an interrupted mutation run, an edit landing
    # mid-verification — the hashes it would record describe a file that is no longer there.
    # Worth stating because the stamp now happens before the gate reads it: a receipt written on
    # a drifted tree would be validated in the same pass and look clean.
    phash = by_check.get("production-hash")
    if phash is not None and phash.status != "PASS":
        return
    # A receipt that silently omits a spec is indistinguishable from one that covers everything,
    # and the gate can only compare keys that exist -- so a file dropped here could be edited
    # afterwards forever without ever staling the receipt. Refuse to stamp a partial one.
    specs = {}
    for f in test_files:
        try:
            specs[rel_to(f, repo_root)] = sha256(f)
        except OSError:
            return
    def detail(name):
        r = by_check.get(name)
        return None if r is None else "%s %s" % (r.status, r.detail)

    man["verification"] = {
        "schema": SCHEMA,
        "epoch": int(time.time()),
        "spec_sha256": specs,
        "suite": detail("suite"),
        "mutation": detail("mutation"),
        "coverage": detail("coverage"),
    }
    tmp = manifest_path + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(man, fh, indent=1)
        os.replace(tmp, manifest_path)
    except OSError:
        with contextlib.suppress(OSError):
            os.unlink(tmp)


def state_path(manifest_path):
    return manifest_path + ".verify-state.json"


def grant_gate_round(st, name, base_budget, manifest_path, repo_root):
    """Record a once-each allowance for a gate that MANDATED a test edit after the writing loop.

    The 50 retros behind this all describe the same shape: Step 3.5's blind audit, Step 4's
    adversarial pass or the closing test-audit finds something, the finding is a required test
    edit, and every required edit needs a pass to re-measure and (before the ordering fix above)
    a second to read the receipt back clean. With a budget of 3 spent on the writing loop, that
    round could only happen by way of `ZUVO_VERIFY_RESET=1` — a human interrupt, asked for in 29
    of them, to authorise the pipeline doing exactly what the pipeline says to do.

    What keeps this from being the escape `--reset-budget` was: the name comes from a closed set,
    each name is claimable once, the grant is recorded with the pass it was claimed on, and the
    verdict block names it. An agent cannot mint a fifth round by thinking of a fifth word.
    """
    rounds = st.setdefault("gate_rounds", {})
    if name in rounds:
        return False
    # A round is what you claim when the writing loop is SPENT and a gate has just mandated an
    # edit. Claimed on pass 1 it is not an allowance, it is a bigger budget requested up front —
    # which is exactly the widening `--budget 999` was closed against, arriving by another name.
    # So the claim is refused while the base budget still has passes left; nothing is consumed,
    # and the caller simply keeps using the passes it already has.
    if base_budget and int(st.get("passes", 0)) - 1 < int(base_budget):
        return False
    # EVIDENCE, not a promise. The first version of this took the agent's word: four names from a
    # closed set, one claim each, nothing checking that any gate had run. An adversarial pass on
    # this very change named it for what it is — `--reset-budget` wearing a nicer hat. That flag
    # was closed by requiring a human-set env var; this one required only typing it, and four
    # ordinary calls took the budget from 3 passes to 11 with no gate having run at all.
    #
    # The honest check was already in the manifest. A gate round exists because a gate mandated a
    # TEST EDIT, and the receipt records the sha256 of every spec at the moment it was measured.
    # So: a round is granted only when at least one declared spec no longer matches the receipt.
    # An agent cannot mint passes without editing the tests, and editing the tests IS the case
    # the allowance is for. No env var, no human interrupt, no self-certification.
    if not specs_changed_since_receipt(manifest_path, repo_root):
        return False
    rounds[name] = {"epoch": int(time.time()), "claimed_on_pass": st.get("passes", 0)}
    return True


def specs_changed_since_receipt(manifest_path, repo_root):
    """True when at least one declared spec differs from what the last receipt measured.

    This is the evidence behind `--gate-round`. It deliberately reuses the receipt rather than
    inventing a second proof: the receipt already records each spec's sha256 at the moment it was
    measured, so "a downstream gate mandated a test edit" is observable as "a spec no longer
    hashes to what the last pass saw".

    No receipt yet means nothing has been measured, so there is no gate-mandated edit to reward
    either — refuse.

    An UNREADABLE spec is not evidence. The first version counted it as changed, reasoning that
    the pass would fail on the missing file anyway — which is true and beside the point: the
    GRANT is what persists. `rm` a spec, claim the round, restore the file, and a pass has been
    minted with no gate having run and no test having changed. The grant must rest on a hash that
    differs from a hash, never on the absence of one. A genuinely missing spec is a broken
    manifest, and the run refuses on it three screens earlier with exit 2.
    """
    man = read_json(manifest_path)
    if man is None:
        return False
    measured = ((man.get("verification") or {}).get("spec_sha256")) or {}
    if not measured:
        return False
    for t in man.get("test_files") or []:
        p = t if os.path.isabs(t) else os.path.join(repo_root, t)
        rel = rel_to(p, repo_root)
        recorded = measured.get(rel) or measured.get(t)
        if recorded is None:
            # Declared but never measured: the receipt does not describe this pair at all, so it
            # cannot witness a change in it either.
            continue
        try:
            if sha256(p) != recorded:
                return True
        except OSError:
            continue
    return False


def guarded(name, fn):
    """Run a check; turn any exception into an ERROR Result instead of killing the run.

    This used to live in the `ThreadPoolExecutor` block that ran the gate and the coverage pass
    in parallel ("a check must not take the whole run down"). Removing that block to fix the
    receipt/gate ordering took the exception handling with it, and nothing noticed: every test
    in the suite drives the checks through stubs that return cleanly, so a malformed
    `coverage-summary.json` — the exact input `check_coverage` parses — would have gone from one
    `coverage ERROR` row to a traceback with no verdict block, no receipt and no saved state.
    Caught by the cross-model adversarial pass on this very change.
    """
    try:
        return fn()
    except Exception as exc:  # a check must not take the whole run down
        r = Result(name)
        r.status = "ERROR"
        r.detail = "error: %s" % exc
        return r


def print_gate_round_hint(st, manifest_path, repo_root, rule=None, indent=""):
    """Print the "claim a round instead of asking for a reset" hint, in ONE place.

    It was written twice — once in the early refusal, once in the BUDGET EXHAUSTED verdict — and
    the copies had already diverged before anyone read them side by side: one printed a runnable
    command plus the remaining names, the other a `", ...".rstrip()` that strips nothing and was
    only ever decoration. That is what duplicated output does; it is also why the structure audit
    found it rather than a test.
    """
    unclaimed = [g for g in GATE_ROUNDS if g not in (st.get("gate_rounds") or {})]
    if not unclaimed:
        return
    if rule:
        print(rule)
    print("%sIf a DOWNSTREAM GATE mandated a test edit (blind audit, adversarial, test-audit,"
          % indent)
    print("%sa Step 4.5 fix), that is the pipeline working — claim its round instead of "
          "resetting:" % indent)
    # A RUNNABLE command, not a choice list. The first version printed `--gate-round a|b|c`,
    # which copy-pastes into `invalid choice: 'a|b|c'` — a hint that does not run is a hint that
    # sends the reader back to --help.
    print("%s  ~/.zuvo/verify-tests --manifest %s --gate-round %s"
          % (indent, rel_to(manifest_path, repo_root), unclaimed[0]))
    if len(unclaimed) > 1:
        print("%s  (also available: %s)" % (indent, ", ".join(unclaimed[1:])))
    print("%sEach name is claimable ONCE, needs a spec to have CHANGED since the receipt, and"
          % indent)
    print("%sgrants %d passes. Gap-chasing is not a round." % (indent, GATE_ROUND_PASSES))


def rounds_suffix(st):
    """`+4 [blind-audit,adversarial]` — so a widened budget is never silently wider."""
    rounds = sorted((st.get("gate_rounds") or {}).keys())
    if not rounds:
        return ""
    return " (+%d [%s])" % (GATE_ROUND_PASSES * len(rounds), ",".join(rounds))


def effective_budget(st, base_budget):
    """Base budget plus the passes granted to gate-mandated fix rounds."""
    if not base_budget:
        return base_budget
    return int(base_budget) + GATE_ROUND_PASSES * len(st.get("gate_rounds") or {})


def effective_time_budget(st, base_time, base_budget, budget_n):
    """The clock scales with the pass allowance, so a granted round is not silently timed out."""
    if not base_time or not base_budget or not budget_n:
        return base_time
    return int(round(float(base_time) * (float(budget_n) / float(base_budget))))


def bump_state(manifest_path, budget, time_budget_min):
    p = state_path(manifest_path)
    st = read_json(p) or {"schema": SCHEMA, "passes": 0, "history": []}
    st["passes"] = int(st.get("passes", 0)) + 1
    # The budget is the stop condition, so it belongs to the FIRST call and to nobody after.
    # Taking whatever the current invocation passes would let an exhausted run unwind the whole
    # thing with `--budget 999 --time-budget 0` — the same agent-typable escape that `--reset-budget`
    # already had to be closed against, arriving through a different argument. Later calls may
    # TIGHTEN it (a smaller number is a stricter promise) but never loosen it.
    prior_b, prior_t = st.get("budget"), st.get("time_budget_min")
    if prior_b is None or budget is None:
        # `int(None)` would raise here, turning "this run passes no budget" into a crash inside
        # the state update -- the same escape arriving as a fault instead of an exploit.
        st["budget"] = budget if prior_b is None else prior_b
    else:
        st["budget"] = min(int(prior_b), int(budget))
    if prior_t is None:
        st["time_budget_min"] = time_budget_min
    elif time_budget_min and prior_t:
        st["time_budget_min"] = min(prior_t, time_budget_min)
    else:
        # A zero/None on either side means "no clock"; honour the one that actually bounds.
        st["time_budget_min"] = prior_t or time_budget_min
    # Two clocks, and only one of them is a stop condition.
    #
    # `elapsed_min` is wall time since the first pass. It used to BE the stop condition, and that
    # is the fourth mechanism in the docstring: Step 4's adversarial review runs BETWEEN passes,
    # takes minutes, and every one of them came out of a budget meant to bound measurement. One
    # retro records the post-review fix round hitting BUDGET EXHAUSTED at 17.6 of 15 minutes
    # without a single one of those minutes having been spent measuring anything. It stays, as
    # information — a run that takes an hour of wall is worth seeing — but it no longer stops
    # anything.
    #
    # `measured_min` accumulates the seconds spent INSIDE this program, which is the quantity the
    # clock was always meant to bound: passes getting expensive. It is written at the end of each
    # pass by add_measured_time(), so nothing an agent does between two calls can move it.
    st.setdefault("started_epoch", int(time.time()))
    st["elapsed_min"] = round((time.time() - st["started_epoch"]) / 60.0, 1)
    st.setdefault("measured_min", 0.0)
    st.setdefault("infra_refunds", 0)
    return st


def add_measured_time(st, seconds):
    st["measured_min"] = round(float(st.get("measured_min", 0.0)) + seconds / 60.0, 1)
    return st["measured_min"]


def refund_pass(st, why):
    """Roll back the pass counter for a pass that could not yield a verdict about the TESTS.

    The precise condition matters, and the first version of this comment got it wrong in a way
    two adversarial providers caught: it said "a pass in which the suite never executed", while
    the code also refunds a `coverage-gate` ERROR — and a gate ERROR happens when the suite DID
    run and WAS measured. Code and rationale disagreed.

    The code is right and the sentence was wrong. What the budget bounds is gap-CHASING over a
    measured suite. A pass that ends in `ZUVO_BASE` being unset measured the suite, the coverage
    and the mutants — and then could not reach a verdict for a reason that has nothing to do with
    the tests, so the next call re-measures exactly the same suite. Nothing was chased; nothing
    advanced. That is the thing being refunded, and "the suite never ran" is only its most
    obvious instance.

    Bounded by INFRA_REFUND_CAP: past it, infrastructure failures start costing passes again, so
    a box that cannot run the suite at all still reaches a stop condition instead of looping.
    """
    if int(st.get("infra_refunds", 0)) >= INFRA_REFUND_CAP:
        return False
    st["infra_refunds"] = int(st.get("infra_refunds", 0)) + 1
    st["passes"] = max(0, int(st.get("passes", 0)) - 1)
    st.setdefault("refunded", []).append({"why": why, "epoch": int(time.time())})
    return True


def save_state(manifest_path, st, results):
    st.setdefault("history", []).append(
        {"pass": st["passes"], "results": [r.to_dict() for r in results]}
    )
    st["history"] = st["history"][-10:]
    try:
        with open(state_path(manifest_path), "w", encoding="utf-8") as fh:
            json.dump(st, fh, indent=2)
    except Exception:
        pass


# --------------------------------------------------------------------------- main


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--manifest", required=True)
    ap.add_argument("--repo-root", default=None)
    ap.add_argument("--skip", default="",
                    help="comma list of checks to skip: coverage,typecheck,mutation")
    ap.add_argument("--force-mutation", action="store_true",
                    help="run mutation even while cheaper checks still report gaps")
    ap.add_argument("--budget", type=int, default=DEFAULT_BUDGET,
                    help="max verification passes over one file")
    ap.add_argument("--time-budget", type=int, default=DEFAULT_TIME_BUDGET_MIN,
                    help="minutes from the FIRST pass before gaps are recorded rather than "
                         "chased; 0 disables the clock")
    ap.add_argument("--gate-round", default=None, choices=GATE_ROUNDS,
                    help="claim the once-each pass allowance for a gate that MANDATED a test "
                         "edit after the writing loop (%s). Names the gate in the verdict."
                         % ", ".join(GATE_ROUNDS))
    ap.add_argument("--survivor-cap", type=int, default=5)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-install", action="store_true",
                    help="never npm install --no-save a missing mutation runner")
    ap.add_argument("--reset-budget", action="store_true")
    a = ap.parse_args()

    manifest_path = os.path.abspath(a.manifest)
    man = read_json(manifest_path)
    if man is None:
        print("[verify-tests] cannot read manifest: %s" % manifest_path, file=sys.stderr)
        return 2
    if a.reset_budget:
        # An escape an agent can type is not a budget. Measured across the benchmark corpus:
        # `--reset-budget` was used 212 times, systematically, to unwind the stop condition the
        # moment it fired -- one run made seven full verification passes against a budget of
        # three, at ~180s each on a jest project. The flag stays for tests and for a human who
        # genuinely wants to restart, but it now requires an environment variable, which is
        # attributable to whoever set it rather than to the agent that guessed it.
        if os.environ.get("ZUVO_VERIFY_RESET") == "1":
            with contextlib.suppress(OSError):
                os.unlink(state_path(manifest_path))
        else:
            print("[verify-tests] --reset-budget requires ZUVO_VERIFY_RESET=1. The budget is the "
                  "stop condition; restarting it is a human decision, not a pass.",
                  file=sys.stderr)

    root = os.path.abspath(a.repo_root or git_root(os.path.dirname(manifest_path)))
    prod_rel = man.get("production_file")
    if not prod_rel:
        print("[verify-tests] manifest has no production_file", file=sys.stderr)
        return 2
    prod = prod_rel if os.path.isabs(prod_rel) else os.path.join(root, prod_rel)
    tests = [t if os.path.isabs(t) else os.path.join(root, t) for t in (man.get("test_files") or [])]
    if not tests:
        print("[verify-tests] manifest has no test_files", file=sys.stderr)
        return 2
    missing = [t for t in tests + [prod] if not os.path.isfile(t)]
    if missing:
        print("[verify-tests] missing file(s): %s" % ", ".join(rel_to(m, root) for m in missing),
              file=sys.stderr)
        # The usual cause is not a typo: the inventory is frozen BEFORE the tests exist, and a
        # suite that later gets split writes `<base>.<aspect>.spec.ts` rather than the single
        # `<base>.spec.ts` the manifest predicted. Refusing is right -- the manifest is wrong --
        # but refusing WITHOUT saying what is on disk turns a one-line correction into a guess.
        # Measured on the rig: two of three runs on the most-instrumented case died here, and the
        # failure predates the tooling changes around it (v17 and v19 show it too).
        if prod not in missing:
            stem = re.split(r"\.(?:spec|test)\.", os.path.basename(prod))[0]
            stem = os.path.splitext(stem)[0]
            found = sorted(
                rel_to(p, root)
                for p in glob.glob(os.path.join(os.path.dirname(prod), "**", "*"), recursive=True)
                if os.path.isfile(p) and stem in os.path.basename(p)
                and re.search(r"\.(spec|test)\.[cm]?[jt]sx?$|_test\.py$|^test_", os.path.basename(p))
            )
            if found:
                print("[verify-tests] specs that DO exist beside the production file: %s"
                      % ", ".join(found[:8]), file=sys.stderr)
                print("[verify-tests] if the suite was split, update the manifest's test_files to "
                      "list every part, then run this again.", file=sys.stderr)
            else:
                print("[verify-tests] no spec file exists beside the production file yet — write "
                      "the suite before verifying it.", file=sys.stderr)
        return 2

    skip = {s.strip() for s in a.skip.split(",") if s.strip()}
    base = zuvo_base()
    runner = detect_runner(man.get("stack"), tests, root)
    if "error" in runner:
        print("[verify-tests] runner detection failed: %s" % runner["error"], file=sys.stderr)
        return 2

    before = sha256(prod)
    frozen = man.get("production_sha256")
    st = bump_state(manifest_path, a.budget, a.time_budget)
    # Read the STORED budget from here on, never the argument. bump_state clamps the argument
    # against what the first call established precisely so a later `--budget 999` cannot widen it;
    # every consumer that keeps reading `a.budget` hands that escape straight back.
    base_budget = st.get("budget") or a.budget
    base_time = st.get("time_budget_min") if st.get("time_budget_min") is not None else a.time_budget
    granted = (grant_gate_round(st, a.gate_round, base_budget, manifest_path, root)
               if a.gate_round else False)
    budget_n = effective_budget(st, base_budget)
    time_budget_n = effective_time_budget(st, base_time, base_budget, budget_n)

    # Past the budget, an extra call must be CHEAP as well as refused. Reporting exit 4 while
    # still running the suite, the gate, coverage, a typecheck and a mutation pass means every
    # ignored refusal costs the same ~180s as a real pass -- which is how one run spent 38% of
    # its wall inside this helper. Answer from the record instead.
    #
    # The clock read here is `measured_min`, not `elapsed_min`: see bump_state. A refusal keyed
    # on wall time fires while the run is doing the work the pipeline asked for, which is the
    # complaint in 16 of the budget retros.
    if (budget_n and st["passes"] > budget_n) or (
            time_budget_n and st["measured_min"] >= time_budget_n and st["passes"] > 1):
        # The last entry that actually MEASURED something. Each refusal appends an empty entry,
        # so taking history[-1] blindly makes the second refusal report nothing at all — which
        # is worse than the first refusal, for a run that is being told to finish from it.
        prev = next((h for h in reversed(st.get("history") or []) if h.get("results")), {})
        # A round that did not lift this refusal is given BACK, not burned. The grant happens
        # above the refusal check (it has to — it is what the check measures against), so a call
        # that is still refused afterwards would otherwise persist a claim that bought nothing:
        # one of four allowances gone, the run no less stuck, and a second attempt with the same
        # name refused as already-claimed. That turns the mechanism built to avoid a human
        # ZUVO_VERIFY_RESET into a way to guarantee one.
        if granted and a.gate_round:
            (st.get("gate_rounds") or {}).pop(a.gate_round, None)
            granted = False
            print("[verify-tests] the %s round was NOT consumed — it did not lift this refusal."
                  % a.gate_round, file=sys.stderr)
        # A refusal ran nothing, so it does not advance the counter. Leaving the increment in
        # made `passes` drift up on every ignored refusal, and the drift stayed silent until a
        # gate round was claimed: the allowance then landed on a counter already inflated past
        # it, so the round granted passes that had been spent on refusals rather than on work.
        st["passes"] = max(0, int(st.get("passes", 0)) - 1)
        print("=" * 78)
        print("VERIFY  %s   pass %d of %d%s   %.1f of %d min measured"
              % (rel_to(prod, root), st["passes"], budget_n, rounds_suffix(st),
                 st["measured_min"], time_budget_n))
        print("=" * 78)
        print("REFUSED — the budget was already exhausted on pass %d. Nothing was re-run."
              % budget_n)
        for r in prev.get("results", []):
            print("  %-15s %-9s %s" % (r.get("check"), r.get("status"), r.get("detail", "")[:90]))
        gaps = [g for r in prev.get("results", []) for g in (r.get("gaps") or [])]
        if gaps:
            print("-" * 78)
            print("STILL OPEN (%d) — record these in the manifest and finish the file:" % len(gaps))
            for g in gaps:
                print("  - %s" % g)
        # A refusal that does not say what WOULD lift it is the reason 29 retros end in a human
        # being asked to authorise ZUVO_VERIFY_RESET. If the reason another pass is wanted is a
        # gate-mandated edit, the allowance for it is a flag, not a human decision.
        print_gate_round_hint(st, manifest_path, root, rule="-" * 78)
        print("=" * 78)
        save_state(manifest_path, st, [])
        return 4

    results = []
    # Measured time is accumulated from here, so it covers exactly what this program does and
    # nothing a downstream gate does between two calls.
    pass_t0 = time.time()
    suite = guarded(CHECK_SUITE, lambda: check_suite(runner, tests, root))
    results.append(suite)
    # The gate and coverage measure a suite that is assumed green. Running them against a red
    # suite produces numbers that describe nothing and cost a full runner invocation each.
    if suite.status == "PASS":
        # The coverage gate USED to run here, in parallel with the coverage run. It does not any
        # more, and the move is the single highest-value line in this file.
        #
        # The gate calls `test-coverage-gate.py validate --phase final`, which reads the
        # verification RECEIPT out of the manifest and compares its spec hashes against the specs
        # on disk. The receipt is written by stamp_receipt() — at the END of the pass. So the
        # gate was always judging the PREVIOUS pass's receipt, and any pass that followed a spec
        # edit was a guaranteed `UNVERIFIED SPEC` / stale-receipt FAIL. Since every fix round
        # edits a spec by definition, that made the first pass of every round pure bookkeeping.
        #
        # Measured in the retro corpus: 47 of 118 budget complaints are this, and the phrasing
        # repeats almost verbatim — "two passes per spec change go to bookkeeping, which is what
        # exhausted a 3-pass budget on a 34-line file", "2 of 5 passes, and it made a human
        # budget reset necessary". It reads as a genuine gate failure, so it also cost trust.
        #
        # The gate now runs AFTER stamp_receipt, against the receipt this pass just wrote. It
        # costs the parallelism (single-digit seconds against a runner invocation) and buys back
        # roughly two thirds of the budget.
        cov = None
        if "coverage" not in skip:
            cov = guarded(CHECK_COVERAGE, lambda: check_coverage(runner, prod, tests, root))
            results.append(cov)

        # The typecheck and the mutation run are the two expensive measurements (57s cold and
        # 270s median on the rig, against single-digit seconds for the gate). Both describe the
        # FINISHED suite, and a pass that still reports uncovered rows is looking at a suite
        # about to be rewritten — so both wait for the cheap checks to come back clean. This is
        # what keeps an early pass inside the harness's 120-second Bash window; a pass that
        # crosses it gets backgrounded, and the run spends four to six turns polling for output
        # one turn would have returned.
        # Gate the expensive checks on the TESTS, not on the manifest bookkeeping.
        #
        # The first version waited for the coverage GATE to pass. On the shield case that gate
        # never went green, so typecheck and mutation stayed deferred for the whole run and the
        # suite finished having never been mutated at all — scoring exactly the no-skill control
        # while a slower arm on the same file reached 90.7%. The gate checks whether inventory
        # rows carry evidence; it says nothing about whether the tests detect anything. A run
        # with imperfect bookkeeping and a good suite still deserves to learn which mutants
        # survive, and that is the most valuable signal in the pipeline.
        #
        # The suite being green and coverage being adequate is what makes a mutation number
        # meaningful. Those are the conditions.
        # The FIRST pass always measures mutation, whatever coverage says.
        #
        # Deferring it means the run writes a whole suite blind and only learns what it missed at
        # the end, when changing course is expensive. Measured on shield: a run that sees its
        # survivors once leaves 24 of them and scores 85.3%; runs that iterate on the list close
        # six more and reach 90%. Handing over the list on pass one makes it the specification
        # rather than the verdict — the same information, several rounds earlier, at the price of
        # one mutation run that was going to happen anyway.
        #
        # Later passes still wait for coverage: by then the list exists and re-measuring an
        # under-covered suite tells nobody anything new.
        first_pass = st["passes"] == 1
        cheap_clean = first_pass or cov is None or cov.status in ("PASS", "SKIP", "DEFER")
        deferred = ("deferred until coverage is adequate — nothing to do about it now "
                    "(--force-mutation runs both anyway)")
        if "typecheck" in skip:
            pass
        elif a.force_mutation or cheap_clean:
            results.append(guarded(CHECK_TYPECHECK,
                                   lambda: check_typecheck(runner, prod, tests, root,
                                                           manifest_path)))
        else:
            r = Result("typecheck")
            # DEFER, not SKIP. SKIP means "this check cannot run here" and write-tests Step 3.3
            # keys on it to fall back to hand-written mutation probes. A deferral that says SKIP
            # therefore sends the agent off to run the expensive thing by hand -- measured at
            # 677s over 24 turns in one run, 29% of its wall, doing what the helper was about to
            # do for free on the next pass.
            r.status = "DEFER"
            r.detail = deferred
            results.append(r)
        # Mutation is by far the most expensive measurement here: median 270s on the rig and
        # 1089s at the worst, against 16-57s for the typecheck and single-digit seconds for the
        # gate. Running it while the cheap checks already say the suite is incomplete measures a
        # suite that is about to be rewritten, and on a first pass with 43 open rows that is the
        # single largest wasted block in the run. It waits until the suite is worth measuring.
        if "mutation" in skip:
            pass
        elif a.force_mutation or cheap_clean:
            results.append(guarded(CHECK_MUTATION,
                                   lambda: check_mutation(runner, prod, tests, root,
                                                          a.survivor_cap, not a.no_install,
                                                          base, manifest_path)))
        else:
            r = Result("mutation")
            r.status = "DEFER"
            r.detail = deferred
            results.append(r)
    else:
        for name in ("coverage", "typecheck", "mutation"):
            r = Result(name)
            r.status = "DEFER"
            r.detail = ("not run — suite never executed" if suite.status == "ERROR"
                        else "not run — suite is red on unmutated source")
            results.append(r)

    after = sha256(prod)
    debris = clear_debris(root, [runner["cwd"]])

    hash_ok = after == before and (frozen is None or after == frozen)
    if not hash_ok:
        r = Result("production-hash")
        r.status = "FAIL"
        r.detail = "production file changed during verification"
        r.gaps.append("expected %s, found %s — restore the file before continuing"
                      % (frozen or before, after))
        results.append(r)
    else:
        r = Result("production-hash")
        r.status = "PASS"
        r.detail = after[:16] + " unchanged"
        results.append(r)

    # The manifest is the artifact this skill is judged on, so the proof of measurement belongs in
    # it — not only in a sidecar the next reader has no reason to look for. This runs BEFORE the
    # gate below, which is the whole point: the gate validates the receipt this pass wrote, not
    # the one the previous pass left behind.
    stamp_receipt(manifest_path, results, tests, root)

    # Now the gate, reading a manifest that is current as of thirty lines ago.
    if suite.status == "PASS":
        gate = guarded(CHECK_GATE, lambda: check_gate(manifest_path, root, base))
    else:
        gate = Result(CHECK_GATE)
        gate.status = "DEFER"
        gate.detail = ("not run — suite never executed" if suite.status == "ERROR"
                       else "not run — suite is red on unmutated source")
    # Displayed where it has always been displayed — right after the suite — so the block reads
    # the same as before even though the execution order changed.
    results.insert(1, gate)

    # A pass in which the suite never executed measured nothing about the tests, so it does not
    # spend the budget that bounds measuring them. See refund_pass for why this is capped.
    # INFRA_CHECKS is module-level. The first version listed only suite and coverage-gate — and
    # missed `typecheck` (tsc timeout), `mutation` (Stryker could not start) and `coverage`,
    # which are the causes this mechanism's own docstring cites as the reason it exists: "a
    # Stryker/Babel major mismatch, a tsc timeout". So a repo hitting exactly the documented
    # failure still paid a budget slot while a missing test runner did not. Found by the
    # behaviour audit; the omission of `coverage` by the adversarial pass after it.
    infra = any(r.status == "ERROR" for r in results if r.name in INFRA_CHECKS)
    # Name the check that actually errored, not a guess. Attributing a Stryker failure to the
    # suite makes the refund record useless for the next reader.
    infra_why = next((("%s: %s" % (r.name, r.detail))[:200]
                      for r in results if r.name in INFRA_CHECKS and r.status == "ERROR"), "")
    refunded = refund_pass(st, infra_why) if infra else False

    # A refunded pass gives back its slot; it must give back its MINUTES too. Leaving them on the
    # clock means three refunded passes can expire a time budget the pass counter never moved —
    # the pass counter says "you have used nothing" while the clock says "you are done", which is
    # the same contradiction, one budget over. Flagged by two providers.
    measured = add_measured_time(st, 0.0 if refunded else time.time() - pass_t0)
    save_state(manifest_path, st, results)

    open_gaps = [g for r in results for g in r.gaps]
    passes, budget = st["passes"], budget_n
    elapsed = st["elapsed_min"]
    # Two stop conditions, both owned by this program rather than by the agent's judgement.
    # The pass count bounds how many times the same suite gets re-measured; the clock bounds how
    # much MEASUREMENT that costs. Measured across 33 scored runs on one file: within a single
    # arm, working 3-5x longer moves mutation kill by about half a point — and three of the four
    # suites that came out RED were among the most expensive runs. Effort past the plateau buys
    # risk. What the clock deliberately no longer counts is the time between passes, because the
    # pipeline's own gates live there; see bump_state.
    out_of_time = bool(time_budget_n) and measured >= time_budget_n
    if not open_gaps:
        rc = 0
    elif passes >= budget or out_of_time:
        rc = 4
    else:
        rc = 1
    if any(r.status == "ERROR" for r in results) and rc != 4:
        # Infrastructure is not a verdict about the tests. Saying "fix these gaps and call again"
        # to a run whose suite never started sends it after gaps it has no evidence for; exit 2
        # sends it to fix the tooling, which is the only thing that can move.
        #
        # `rc != 4` is the part worth stating. The first version of this escalated
        # unconditionally, which silently swallowed BUDGET EXHAUSTED — the one terminal state the
        # whole pipeline keys on. A run that is both out of budget AND has broken tooling must
        # still be told it is out of budget; otherwise it reads exit 2, fixes the tooling, and
        # calls again into a refusal. Two adversarial providers flagged this independently.
        rc = 2

    if a.json:
        print(json.dumps(
            {
                "schema": SCHEMA,
                "pass": passes,
                "budget": budget,
                "base_budget": base_budget,
                "gate_rounds": sorted((st.get("gate_rounds") or {}).keys()),
                # `measured_min` is the stop condition; `elapsed_min` is wall time, kept for
                # information. A consumer that reads the wrong one reproduces the bug this
                # split exists to fix.
                "measured_min": measured,
                "elapsed_min": elapsed,
                "time_budget_min": time_budget_n,
                "infra_refunds": st.get("infra_refunds", 0),
                "pass_refunded": refunded,
                "exit": rc,
                "production_file": rel_to(prod, root),
                "runner": runner["kind"],
                "results": [r.to_dict() for r in results],
            },
            indent=2,
        ))
        return rc

    w = 78
    print("=" * w)
    clock = ("   %.1f of %d min measured" % (measured, time_budget_n)) if time_budget_n else ""
    print("VERIFY  %s   pass %d of %d%s%s   runner: %s"
          % (rel_to(prod, root), passes, budget, rounds_suffix(st), clock, runner["kind"]))
    if granted:
        print("        +%d passes for the %s round — a gate mandated this edit."
              % (GATE_ROUND_PASSES, a.gate_round))
    print("=" * w)
    for r in results:
        print("  %-15s %-9s %s" % (r.name, r.status, r.detail))
    if debris:
        print("  %-15s %-9s %s" % ("debris", "CLEARED", ", ".join(debris[:4])))
    if open_gaps:
        print("-" * w)
        print("OPEN (%d):" % len(open_gaps))
        for g in open_gaps:
            print("  - %s" % g)
    for r in results:
        if r.status in ("FAIL", "ERROR") and r.evidence:
            print("-" * w)
            print("EVIDENCE [%s]" % r.name)
            print(r.evidence)
    print("=" * w)
    if rc == 0:
        print("VERDICT: GREEN — every applicable check passed. Do NOT re-run this command.")
    elif rc == 4:
        why = ("%.1f minutes measured of a %d-minute budget" % (measured, time_budget_n)
               if out_of_time else "%d passes" % passes)
        print("VERDICT: BUDGET EXHAUSTED — %s. Record the OPEN items in the manifest" % why)
        print("         (survivors with IDs, uncovered rows with notes) and finish the file as")
        print("         BLOCKED_INCOMPLETE. Do NOT run another pass. Measured across 33 scored")
        print("         runs: within one arm, 3-5x the effort moves mutation kill by ~0.5 points,")
        print("         and the most expensive runs are where RED suites come from.")
        print_gate_round_hint(st, manifest_path, root, indent=" " * 9)
    elif rc == 2:
        print("VERDICT: INFRASTRUCTURE ERROR — fix the tooling, not the tests.")
        if refunded:
            print("         This pass did NOT cost budget: the suite never ran, so it measured")
            print("         nothing. %d of %d such refunds used."
                  % (st.get("infra_refunds", 0), INFRA_REFUND_CAP))
        elif infra:
            print("         %d infrastructure refunds already used — further failures to run the"
                  % INFRA_REFUND_CAP)
            print("         suite DO cost budget, so this cannot loop.")
    else:
        print("VERDICT: %d gap(s) open. Make ONE fix round addressing ALL of them, then run"
              % len(open_gaps))
        print("         this command again. You have %d pass(es) left." % (budget - passes))
    print("=" * w)
    return rc


if __name__ == "__main__":
    sys.exit(main())
