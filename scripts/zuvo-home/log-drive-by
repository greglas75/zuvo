#!/usr/bin/env bash
# ~/.zuvo/log-drive-by — one-line receipt that a skill's "Drive-by findings" step RAN.
#
# Most runs honestly record nothing, so the backlog alone cannot tell "looked and found nothing"
# from "never looked" (shared/includes/drive-by-findings.md). Same contract as ~/.zuvo/log-ideas.
#
# Usage:
#   ~/.zuvo/log-drive-by --skill build [--sec N] [--bug N] [--size N] [--dup N] [--cplx N]
#                        [--perf N] [--dead N] [--read N] [--project P]
#     The inherited $PROJECT env var is ignored (an orchestrator exports a plan-slug).
#
# Best-effort: every error exits 0 so it can never break a skill's completion path — but a receipt
# that was NOT written says so on stderr, so the agent can report it instead of reading silence.
set -u

_unwritten() { echo "log-drive-by: receipt NOT written ($1)" >&2; exit 0; }
[ -n "${ZUVO_HOME:-}" ] || [ -n "${HOME:-}" ] || _unwritten "neither ZUVO_HOME nor HOME is set"
ZUVO_HOME="${ZUVO_HOME:-$HOME/.zuvo}"
mkdir -p "$ZUVO_HOME" 2>/dev/null || _unwritten "cannot create $ZUVO_HOME"
LOG="$ZUVO_HOME/drive-by.log"

SKILL="" PROJECT=""
SEC=0 BUG=0 SIZE=0 DUP=0 CPLX=0 PERF=0 DEAD=0 READ=0
# Never `shift 2`: on a trailing flag it fails without shifting and spins forever (B-29).
while [ $# -gt 0 ]; do
  _flag="${1%%=*}"
  case "$1" in
    # Agents probe the syntax with --help: answering it with a receipt logged an empty
    # `unknown` row per probe (71 of 331 rows on ryzen-dev, 2026-10-12).
    # The usage is this file's leading comment block; its status is the exit status.
    -h|--help|-h=*|--help=*) awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"; exit ;;
    --*=*) _val="${1#*=}"; shift ;;
    --*)   shift
           # A missing value must not swallow the next flag: `--skill --sec 3` keeps --sec.
           case "${1:-}" in --*|'') _val="" ;; *) _val="$1"; shift ;; esac ;;
    *)     echo "log-drive-by: ignored stray argument: $1" >&2; shift; continue ;;
  esac
  case "$_flag" in
    --skill)   SKILL="$_val" ;;
    --project) PROJECT="$_val" ;;
    --sec)  SEC="$_val" ;;  --bug)  BUG="$_val" ;;  --size) SIZE="$_val" ;; --dup)  DUP="$_val" ;;
    --cplx) CPLX="$_val" ;; --perf) PERF="$_val" ;; --dead) DEAD="$_val" ;; --read) READ="$_val" ;;
    *) echo "log-drive-by: ignored unknown flag: $_flag" >&2 ;;   # a typo must not read as a 0
  esac
done

# Digits only, or 0 named on stderr: stripping `3.5` to 35 would record a count nobody gave.
# Clipped so an absurd count cannot overflow TOTAL.
_count() {
  local v="${2#"${2%%[!0]*}"}"                     # leading zeros off: 0000010 is 10, not a 7-digit count
  [ -n "$2" ] && [ -z "$v" ] && v=0
  case "$v" in
    '') printf 0 ;;
    *[!0-9]*) echo "log-drive-by: ignored non-numeric --$1 value: $2" >&2; printf 0 ;;
    ???????*) echo "log-drive-by: --$1 value $2 clipped to 999999" >&2; printf 999999 ;;
    *) printf '%s' "$v" ;;
  esac
}
SEC="$(_count sec "$SEC")" BUG="$(_count bug "$BUG")" SIZE="$(_count size "$SIZE")" DUP="$(_count dup "$DUP")"
CPLX="$(_count cplx "$CPLX")" PERF="$(_count perf "$PERF")" DEAD="$(_count dead "$DEAD")" READ="$(_count read "$READ")"
TOTAL=$((10#$SEC + 10#$BUG + 10#$SIZE + 10#$DUP + 10#$CPLX + 10#$PERF + 10#$DEAD + 10#$READ))

[ -n "$SKILL" ] || SKILL="unknown"
SKILL="$(printf '%s' "$SKILL" | tr -cd 'a-zA-Z0-9:_-')"; [ -n "$SKILL" ] || SKILL="unknown"

if [ -z "$PROJECT" ]; then
  _main="$(git worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //')"
  [ -n "$_main" ] || _main="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  PROJECT="$(basename "$_main")"
fi
PROJECT="$(printf '%s' "$PROJECT" | tr -cd 'a-zA-Z0-9._-')"; [ -n "$PROJECT" ] || PROJECT="unknown"

DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# The header is created with noclobber (O_EXCL): a check-then-`>` lets a second concurrent first
# writer truncate the row the first one already appended.
{ [ -e "$LOG" ] || ( set -C; printf '# DATE\tSKILL\tPROJECT\tTOTAL\tSEC\tBUG\tSIZE\tDUP\tCPLX\tPERF\tDEAD\tREAD\n' > "$LOG" ); } 2>/dev/null
{ printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$DATE" "$SKILL" "$PROJECT" "$TOTAL" \
    "$SEC" "$BUG" "$SIZE" "$DUP" "$CPLX" "$PERF" "$DEAD" "$READ" >> "$LOG"; } 2>/dev/null \
  || _unwritten "cannot append to $LOG"
echo "log-drive-by: recorded $TOTAL drive-by finding(s) (SEC:$SEC) for $SKILL on $PROJECT"
exit 0
