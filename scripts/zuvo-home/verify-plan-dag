#!/usr/bin/env bash
# verify-plan-dag — zuvo plan DAG validator (cycles / forward-refs / missing
# deps / declared failure strategy).
#
# Usage:
#   verify-plan-dag [--json] <plan-file>
#
# Exit codes:
#   0 — clean plan (no cycles, no forward-refs, no missing deps, no bad
#       **Failure:** declaration)
#   1 — one or more plan violations
#   2 — parse / IO error (file missing, malformed markdown, no tasks)
#
# Parses both supported task-metadata layouts:
#   (a) standalone:  **Dependencies:** Task 1, Task 2
#   (b) inline `·`:  **Surface:** … · **Dependencies:** Task 1 · **Execution routing:** deep
#
# **Failure:** (skills/plan/SKILL.md rule 20) declares ONE of `halt`,
# `skip-and-continue`, `degraded:<free text>`. Omitting the line means `halt`.
# `skip-and-continue` is rejected when another task depends on that task; an
# unrecognised or blank value is a violation (exit 1, never exit 2).
#
# Pure awk for the core (associative arrays, byte-safe). Bash only orchestrates.
# Portable to macOS bash 3.2 (no `declare -A`) and Linux.

LC_ALL=C
export LC_ALL

JSON=0
PLAN=""
SAW_PLAN=0
for arg in "$@"; do
  case "$arg" in
    --json) JSON=1 ;;
    -h|--help)
      # Self-terminating scan: skip the shebang (NR==1), print every leading
      # `#` comment line with the marker stripped, stop at the first
      # non-comment line (the blank line closing the header block). No
      # hardcoded line range to re-sync when the header block grows.
      awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
      exit 0 ;;
    --*) echo "verify-plan-dag: unknown flag: $arg" >&2; exit 2 ;;
    *)
      # Reject multiple positional plan files — silent skip of all-but-last
      # is a CI footgun (broken plan masked by later valid one).
      if [ "$SAW_PLAN" -eq 1 ]; then
        echo "verify-plan-dag: only one plan file accepted per invocation (got multiple)" >&2
        exit 2
      fi
      PLAN="$arg"
      SAW_PLAN=1
      ;;
  esac
done

if [ -z "$PLAN" ]; then
  echo "verify-plan-dag: missing plan file argument" >&2
  exit 2
fi
if [ ! -f "$PLAN" ]; then
  echo "verify-plan-dag: $PLAN: not found (ENOENT)" >&2
  exit 2
fi
if [ ! -r "$PLAN" ]; then
  echo "verify-plan-dag: $PLAN: permission denied (EACCES)" >&2
  exit 2
fi

awk -v json="$JSON" -v planpath="$PLAN" '
function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
# Anchor check shared by the Dependencies and Failure matchers: a field marker
# only counts as a real declaration when it sits at line-start (after
# stripping trailing whitespace from everything before it) or is immediately
# preceded by an inline `·` bullet — never mid-prose.
function anchored(prefix,   blen) {
  sub(/[[:space:]]+$/, "", prefix)
  if (prefix == "") return 1
  blen = length(bullet)
  return (length(prefix) >= blen && substr(prefix, length(prefix) - blen + 1) == bullet)
}
# Cut a field value at the next inline `·` bullet, which starts a different
# metadata field on the same line. Shared by the Dependencies and Failure
# matchers.
function cut_at_bullet(s,   p) {
  p = index(s, bullet)
  if (p > 0) return substr(s, 1, p - 1)
  return s
}
function json_esc(s,   r, i, c, n, out) {
  r = s
  gsub(/\\/, "\\\\", r)
  gsub(/"/, "\\\"", r)
  # Escape the full JSON control-character range (0x00-0x1F) via the ctrl_esc
  # lookup built in BEGIN. Without this a raw TAB (or any other control byte)
  # inside an authored value — e.g. a **Failure:** description pasted from a
  # terminal — produces --json output that json.loads rejects with "Invalid
  # control character", breaking the whole point of having --json at all.
  n = length(r)
  out = ""
  for (i = 1; i <= n; i++) {
    c = substr(r, i, 1)
    out = out ((c in ctrl_esc) ? ctrl_esc[c] : c)
  }
  return out
}

BEGIN {
  bullet = sprintf("%c%c", 194, 183)        # · = U+00B7 = 0xC2 0xB7

  # Build the JSON control-char escape table (0x00-0x1F) once. Short forms for
  # the five JSON-named escapes; \u00XX for everything else in range.
  for (ctl = 0; ctl <= 31; ctl++) {
    ch = sprintf("%c", ctl)
    if (ctl == 9)       esc = "\\t"
    else if (ctl == 10) esc = "\\n"
    else if (ctl == 13) esc = "\\r"
    else if (ctl == 8)  esc = "\\b"
    else if (ctl == 12) esc = "\\f"
    else                esc = sprintf("\\u%04x", ctl)
    ctrl_esc[ch] = esc
  }
}

# ── Phase 1: parse ────────────────────────────────────────────────────────
# Numeric task header (allows trailing `:` or not — we anchor on the digits).
/^###[[:space:]]+Task[[:space:]]+[0-9]+[[:space:]]*:/ {
  if (match($0, /[0-9]+/)) {
    cur = substr($0, RSTART, RLENGTH) + 0
    if (cur in seen) {
      malformed = 1
      malformed_reason = "duplicate Task " cur " header"
    } else {
      seen[cur] = 1
      n++
      order[n] = cur
      deps[cur] = ""
      depcapt[cur] = 0
    }
  }
  next
}
# Non-numeric task header (`### Task abc:`, `### Task 2a:`) — malformed.
/^###[[:space:]]+Task[[:space:]]+[^0-9[:space:]]/ {
  malformed = 1
  malformed_reason = "non-numeric task header: " $0
  next
}
# A `### Task <num>` not followed by `:` is also non-conforming and would
# otherwise slip past — match `### Task NNN<non-colon, non-space>`.
/^###[[:space:]]+Task[[:space:]]+[0-9]+[^:[:space:]]/ {
  malformed = 1
  malformed_reason = "malformed numeric task header (id suffix): " $0
  next
}
/\*\*Dependencies:\*\*/ {
  if (cur == 0) next                                  # before any task header
  if (depcapt[cur]) next                              # first deps line wins

  # Anchor: capture ONLY when the marker is at line-start (whitespace prefix
  # only) OR is preceded by an inline `·` bullet. Prose like
  #   "Some narrative that says **Dependencies:** are tricky"
  # must NOT shadow a later, real deps line for the same task.
  mpos = index($0, "**Dependencies:**")
  if (!anchored(substr($0, 1, mpos - 1))) next        # prose mention — ignore

  line = $0
  sub(/^.*\*\*Dependencies:\*\*[[:space:]]*/, "", line)
  line = cut_at_bullet(line)
  # Cut at the first open-paren or angle-bracket: anything after them is a prose
  # note, not a dependency token. Without this, a parenthetical cross-reference
  # such as Task 9 followed by a bracketed note, or a Note: marker, made the
  # linter false-positive a forward-ref, forcing authors to reword Dependencies
  # lines to dodge the parser (the 2026-06-18 reconciliation-plan churn, agent
  # retro proposal). Only the real comma-list before the first marker counts.
  pp = index(line, "(")
  if (pp > 0) line = substr(line, 1, pp - 1)
  pg = index(line, ">")
  if (pg > 0) line = substr(line, 1, pg - 1)
  deps[cur] = trim(line)
  depcapt[cur] = 1
  next
}

# ── Declared failure strategy (skills/plan/SKILL.md rule 20) ────────────────
# Matches the EXACT literal `**Failure:**` only — with the closing `**`. Near
# misses (`**Failure paths:`, `**Failure handling (W1):`, `**Failure modes:`,
# `**Failure-path unit:`, `**Failure Mode row`, …) are NOT declarations: across
# 3,136 plan files under ~/DEV there were 0 exact-literal occurrences and 46
# near misses in 17 spellings, and this file is installed to ~/.zuvo/ for every
# project on the machine — a loose matcher would red-light 9 unrelated repos.
/\*\*Failure:\*\*/ {
  if (cur == 0) next                                  # before any task header
  if (failcapt[cur]) next                             # first Failure line wins

  # Same anchor as the Dependencies matcher: line-start (whitespace prefix only)
  # or immediately after an inline `·` bullet. Prose such as
  #   "rule 20 says the **Failure:** field is optional"
  # must NOT be read as a declaration, nor shadow a later real one.
  mpos = index($0, "**Failure:**")
  if (!anchored(substr($0, 1, mpos - 1))) next        # prose mention — ignore

  line = substr($0, mpos + length("**Failure:**"))
  line = cut_at_bullet(line)
  val = trim(line)
  failraw[cur] = val
  failcapt[cur] = 1

  # Classify by PREFIX into a closed set. Everything after `degraded` is the
  # authored free-text description and is discarded UNREAD — never tokenised,
  # never split on `,`. That is what keeps the Dependencies-parser
  # non-numeric-token `exit 2` unreachable from this code path.
  # >>> failure-enum (closed set; parity-checked by
  #     tests/skill-suite/test-plan-dag-failure-strategy.sh against rule 20)
  if (val == "halt")                          fstrat[cur] = "halt"
  else if (val == "skip-and-continue")        fstrat[cur] = "skip-and-continue"
  else if (substr(val, 1, 8) == "degraded")   fstrat[cur] = "degraded"
  else                                        fstrat[cur] = "?"   # unrecognised / blank → violation (exit 1)
  # <<< failure-enum
  next
}

END {
  # ── Phase 2: emit diagnostics for unparseable inputs ─────────────────
  # Order matters: malformed MUST be checked first; otherwise a mix of
  # `### Task 2a:` (malformed) with `### Task 1:` (valid) would silently
  # drop the bad header and report the rest as a valid DAG.
  if (malformed) {
    reason = (malformed_reason != "" ? malformed_reason : "malformed markdown")
    printf "verify-plan-dag: %s: malformed plan — %s\n", planpath, reason > "/dev/stderr"
    exit 2
  }
  if (n == 0) {
    printf "verify-plan-dag: %s: no tasks parsed (no ### Task N: headers found)\n", planpath > "/dev/stderr"
    exit 2
  }

  # ── Phase 3: resolve deps to numeric IDs ─────────────────────────────
  n_miss = 0; n_fwd = 0
  for (i = 1; i <= n; i++) {
    t = order[i]
    raw = deps[t]
    rn = tolower(raw); gsub(/[[:space:]]/, "", rn)
    if (rn == "" || rn == "none") {
      adj_count[t] = 0
      continue
    }
    nc = split(raw, chunks, ",")
    ac = 0
    for (k = 1; k <= nc; k++) {
      c = trim(chunks[k])
      if (c == "") continue                       # trailing comma — tolerated
      # Extract first numeric run.
      if (match(c, /[0-9]+/)) {
        d = substr(c, RSTART, RLENGTH) + 0
        ac++
        adj[t, ac] = d
        if (!(d in seen)) {
          mkey = t SUBSEP d
          if (!(mkey in miss_seen)) {
            miss_seen[mkey] = 1
            n_miss++
            miss_src[n_miss] = t
            miss_dst[n_miss] = d
          }
        } else if (d >= t) {
          fkey = t SUBSEP d
          if (!(fkey in fwd_seen)) {
            fwd_seen[fkey] = 1
            n_fwd++
            fwd_src[n_fwd] = t
            fwd_dst[n_fwd] = d
          }
        }
      } else {
        # Non-empty chunk without a digit (e.g. "Build") is a malformed token,
        # not a silently-dropped edge.
        printf "verify-plan-dag: %s: malformed plan — non-numeric dependency token in Task %d: \"%s\"\n", planpath, t, c > "/dev/stderr"
        exit 2
      }
    }
    adj_count[t] = ac
  }

  # ── Phase 3.5: declared failure strategies ───────────────────────────────
  # In-degree is a REVERSE count over the adjacency built above — this phase
  # reads the graph and never writes to it: no task, no edge, no adj_count is
  # added, removed or reordered by a `**Failure:**` line (rule 20: the enum
  # changes the OUTCOME of a task at execute time only, never the task graph).
  for (i = 1; i <= n; i++) {
    t = order[i]
    for (k = 1; k <= adj_count[t]; k++) {
      d = adj[t, k]
      if (!(d in seen)) continue                   # missing dep already recorded
      ekey = d SUBSEP t
      if (ekey in dep_seen) continue               # duplicate edge listed twice
      dep_seen[ekey] = 1
      indeg[d]++
      dependents[d] = (dependents[d] == "" ? t : dependents[d] "," t)
    }
  }

  n_fs = 0
  for (i = 1; i <= n; i++) {
    t = order[i]
    if (!(t in fstrat)) continue                   # absent line = halt = legal
    s = fstrat[t]
    if (s == "halt" || s == "degraded") continue
    if (s == "skip-and-continue") {
      # Legal ONLY on a task nothing depends on. Rule 9 makes Dependencies trace
      # concrete reads, so "B depends on A but A is optional" means B fails
      # mid-RED against a symbol A never wrote — a worse failure than a clean
      # BLOCKED_BY_DEPENDENCY.
      if (indeg[t] > 0) {
        n_fs++
        fs_task[n_fs] = t
        fs_kind[n_fs] = "skip-and-continue"
        fs_val[n_fs] = failraw[t]
        fs_deps[n_fs] = dependents[t]
      }
    } else {
      # Unrecognised or blank. This is exit 1 (a plan-content violation), NOT
      # exit 2 — exit 2 is contractually "cannot parse the plan at all", and
      # conflating them makes the linter read as crashing.
      n_fs++
      fs_task[n_fs] = t
      fs_kind[n_fs] = (failraw[t] == "" ? "blank" : "unrecognised")
      fs_val[n_fs] = failraw[t]
      fs_deps[n_fs] = ""
    }
  }

  # ── Phase 4: DFS cycle detection (iterative, white/gray/black) ──────
  for (i = 1; i <= n; i++) color[order[i]] = "W"
  n_cyc = 0
  for (i = 1; i <= n; i++) {
    root = order[i]
    if (color[root] != "W") continue
    # Iterative DFS using an explicit stack of (node, next_edge_idx).
    sp = 0
    sp++; st_node[sp] = root; st_idx[sp] = 1; color[root] = "G"; on_path[root] = sp
    while (sp > 0) {
      v = st_node[sp]
      idx = st_idx[sp]
      if (idx > adj_count[v]) {
        # done with v
        color[v] = "B"
        delete on_path[v]
        sp--
        continue
      }
      st_idx[sp] = idx + 1
      d = adj[v, idx]
      if (!(d in seen)) continue            # missing dep already recorded
      if (color[d] == "W") {
        color[d] = "G"; sp++; st_node[sp] = d; st_idx[sp] = 1; on_path[d] = sp
      } else if (color[d] == "G") {
        # Cycle: from on_path[d] up to sp, then close with d.
        path = ""
        for (q = on_path[d]; q <= sp; q++) {
          path = (path == "") ? st_node[q] : path "," st_node[q]
        }
        path = path "," d
        # Dedupe by canonical key (sorted node set).
        # Build sorted-set key.
        nset = split(path, nodes_arr, ",")
        # Bubble-sort unique numeric ids — small inputs.
        delete uniq
        un = 0
        for (q = 1; q <= nset; q++) {
          if (!(nodes_arr[q] in uniq)) { uniq[nodes_arr[q]] = 1; un++; uarr[un] = nodes_arr[q] + 0 }
        }
        for (a = 1; a < un; a++) for (b = a+1; b <= un; b++) if (uarr[a] > uarr[b]) { tmp = uarr[a]; uarr[a] = uarr[b]; uarr[b] = tmp }
        ckey = ""
        for (q = 1; q <= un; q++) ckey = (ckey == "") ? uarr[q] : ckey "," uarr[q]
        if (!(ckey in cyc_seen)) {
          cyc_seen[ckey] = 1
          n_cyc++
          cyc_path[n_cyc] = path
        }
      }
      # B → already explored
    }
  }

  violations = n_cyc + n_miss + n_fwd + n_fs

  # ── Phase 5: emit ────────────────────────────────────────────────────
  if (json) {
    printf "{"
    printf "\"plan\":\"%s\",", json_esc(planpath)
    printf "\"tasks\":%d,", n
    printf "\"valid\":%s,", (violations == 0 ? "true" : "false")
    printf "\"cycles\":["
    for (i = 1; i <= n_cyc; i++) {
      if (i > 1) printf ","
      printf "\"%s\"", cyc_path[i]
    }
    printf "],"
    printf "\"forward_refs\":["
    for (i = 1; i <= n_fwd; i++) {
      if (i > 1) printf ","
      printf "{\"task\":%d,\"depends_on\":%d}", fwd_src[i], fwd_dst[i]
    }
    printf "],"
    printf "\"missing_deps\":["
    for (i = 1; i <= n_miss; i++) {
      if (i > 1) printf ","
      printf "{\"task\":%d,\"depends_on\":%d}", miss_src[i], miss_dst[i]
    }
    printf "],"
    # Parity with `violations`: a class counted there MUST have its own array
    # here, otherwise a consumer sees "valid":false with the reason in no array
    # at all — an invalid plan with zero causes.
    printf "\"failure_strategy_violations\":["
    for (i = 1; i <= n_fs; i++) {
      if (i > 1) printf ","
      printf "{\"task\":%d,\"reason\":\"%s\",\"value\":\"%s\",\"dependents\":[", fs_task[i], json_esc(fs_kind[i]), json_esc(fs_val[i])
      if (fs_deps[i] != "") {
        nd = split(fs_deps[i], darr, ",")
        for (q = 1; q <= nd; q++) {
          if (q > 1) printf ","
          printf "%d", darr[q]
        }
      }
      printf "]}"
    }
    printf "]}\n"
  } else {
    if (violations == 0) {
      printf "verify-plan-dag: %s: valid DAG (%d tasks, 0 violations)\n", planpath, n
    } else {
      printf "verify-plan-dag: %s: INVALID — %d violation(s) across %d tasks\n", planpath, violations, n
      for (i = 1; i <= n_cyc; i++) {
        path = cyc_path[i]
        gsub(/,/, " → Task ", path)
        printf "  cycle: Task %s\n", path
      }
      for (i = 1; i <= n_fwd; i++) {
        printf "  forward-ref: Task %d depends on Task %d (forward / self)\n", fwd_src[i], fwd_dst[i]
      }
      for (i = 1; i <= n_miss; i++) {
        printf "  missing-dep: Task %d depends on Task %d (not defined in plan)\n", miss_src[i], miss_dst[i]
      }
      for (i = 1; i <= n_fs; i++) {
        if (fs_kind[i] == "skip-and-continue") {
          dlist = fs_deps[i]
          gsub(/,/, ", Task ", dlist)
          printf "  failure-strategy: Task %d declares skip-and-continue but is depended on by Task %s (skip-and-continue is legal only when no other task lists it in **Dependencies:**)\n", fs_task[i], dlist
        } else if (fs_kind[i] == "blank") {
          printf "  failure-strategy: Task %d has a blank **Failure:** value (omit the line entirely for the default \"halt\"; a blank value is an authoring error)\n", fs_task[i]
        } else {
          printf "  failure-strategy: Task %d declares unrecognised failure strategy \"%s\" (expected exactly one of: halt | skip-and-continue | degraded:<one-line description>)\n", fs_task[i], fs_val[i]
        }
      }
    }
  }

  exit (violations == 0 ? 0 : 1)
}
' < "$PLAN"
# stdin-redirect (instead of trailing arg) so filenames containing `=`
# are not interpreted by awk as `var=value` variable assignments.
