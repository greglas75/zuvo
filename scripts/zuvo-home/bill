#!/bin/sh
# Polyglot sh/python header (as in adversarial-stats): /bin/sh re-execs this file with Python 3.
''''exec "$(command -v python3 || command -v python || echo python3)" "$0" "$@" # '''
"""bill — the judge of adversarial-review findings.

WHY THIS EXISTS

Every --json review writes one ledger row per finding (~/.zuvo/adversarial-findings.log), but a verdict
(fixed / deferred / rejected) only appears when the agent that ran the review records it after triage
(`--record-disposition`, adversarial-loop.md Step 4.9). Measured 2026-10-10 on the sessions host: 6,346
reviews since 10-03, 360 with any verdict — so per-lane precision rested on ~6 % of the reviews. Bill judges
what nobody judged: every few minutes it takes the newest reviews without verdicts, shows Opus the diff and
every lane's findings at once, and records a verdict per finding plus the lessons it drew.
What it writes: see the zuvo_bill_state.py docstring.

USAGE

    bill                  one tick: start judging the newest unjudged reviews until the time budget runs out
                          (calls already in flight finish, each within CALL_TIMEOUT)
    bill --dry-run        list what a tick would judge, call nothing
    bill --install-schedule   every 10 minutes: launchd on macOS, a systemd user timer on Linux
    bill --status         judged reviews, verdict counts, cost of the last 24 h

ENV

    BILL_MODEL (claude-opus-5-5)  BILL_EFFORT (xhigh)  BILL_WORKERS (3)  BILL_TICK_SECONDS (540)
    BILL_MAX_AGE_HOURS (48)  BILL_MIN_AGE_MINUTES (30)  BILL_MAX_TRIES (3)  ZUVO_HOME (~/.zuvo)
    touch ~/.zuvo/bill-data/PAUSE to stop it without unscheduling
"""
import contextlib
import importlib
import os
import sys
import time

# The installer replaces files one at a time: a missing, half-written or other-release module makes a
# tick exit 0 (no traceback every 10 minutes) and `--status` say since when. Any change to a contract
# between modules bumps API here and in every module (2: acquire_lock returns a refusal).
API = 2
MODULES = ("zuvo_bill_config", "zuvo_bill_state", "zuvo_bill_judge", "zuvo_bill_tick", "zuvo_bill_schedule",
           "zuvo_bill_status")


def guard_file():
    zh = os.environ.get("ZUVO_HOME") or os.path.join(os.path.expanduser("~"), ".zuvo")
    return os.path.join(zh, "bill-data", "install-guard")


def load():
    """({name: module}, "") or (None, why they cannot be used)."""
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    try:
        mods = {n: importlib.import_module(n) for n in MODULES}
    except Exception as ex:  # noqa: BLE001 — missing, half-written, or raising at import: all "not installed yet"
        return None, f"{type(ex).__name__}: {ex}"
    stale = [n for n, m in mods.items() if getattr(m, "API", None) != API]
    return (None, f"API mismatch: {', '.join(stale)} (launcher API {API})") if stale else (mods, "")


def blocked(reason, want_status):
    """Remember when the install was first seen unusable; report it (tick: exit 0, --status: exit 1)."""
    p = guard_file()
    since = ""
    with contextlib.suppress(OSError), open(p, encoding="utf-8") as f:
        since = f.readline().strip()
    if not since:
        since = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with contextlib.suppress(OSError):
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "w", encoding="utf-8") as f:
                f.write(f"{since}\n{reason}\n")
    if want_status:
        print(f"bill: install BROKEN since {since} — {reason}")
        return 1
    print(f"bill: install in progress ({reason})")
    return 0


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__); return 0
    mods, reason = load()
    if mods is None:
        return blocked(reason, "--status" in argv)
    with contextlib.suppress(FileNotFoundError):
        os.remove(guard_file())
    if "--status" in argv:
        return mods["zuvo_bill_status"].status()
    if "--install-schedule" in argv:
        return mods["zuvo_bill_schedule"].install_schedule()
    return mods["zuvo_bill_tick"].tick("--dry-run" in argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
